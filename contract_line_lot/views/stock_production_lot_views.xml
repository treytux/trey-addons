<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_production_lot_form" model="ir.ui.view">
        <field name="model">stock.production.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_show_contract_lines_lot"
                    string="Contracts" type="object" icon="fa-file-text-o"
                    class="oe_stat_button"/>
            </xpath>
            <xpath expr="//group[@name='main_group']" position="after">
                <group string="Contract" name="contract_lot">
                    <field name="last_contract_id"/>
                    <field name="last_contract_line_id" invisible="True"/>
                    <field name="last_contract_product_id"/>
                    <field name="last_contract_date_start"/>
                    <field name="last_contract_date_end"/>
                    <field name="last_location_id"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
