<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="event_schema" inherit_id="web.frontend_layout" priority="50">
        <xpath expr="//head" position="inside">
            <t t-if="event">
                <script type="application/ld+json">
                    <t t-out="event.event_schema_get()"/>
                </script>
            </t>
        </xpath>
    </template>
</odoo>
