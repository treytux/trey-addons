#. module: import_template_stock_orderpoint
#: model_terms:import.template,description:import_template_stock_orderpoint.template_orderpoint
msgid "<b><font style=\"font-size: 12px;\">lead_days: </font></b><font style=\"font-size: 12px;\">number of days after the orderpoint is triggered to receive the products or to order to the vendor. If not specified default will be 0</font>"
msgstr "<b><font style=\"font-size: 12px;\">lead_days: </font></b><font style=\"font-size: 12px;\">número de días después de que se activa el punto de pedido para recibir los productos o hacer un pedido al proveedor. Si no se especifica, el valor predeterminado será 0</font>"

#. module: import_template_stock_orderpoint
#: model_terms:import.template,description:import_template_stock_orderpoint.template_orderpoint
msgid "<b><font style=\"font-size: 12px;\">lead_type: </font></b><font style=\"font-size: 12px;\">type lead: 'net' for 'Day(s) to get the products' and 'supplier' for 'Day(s) to purchase'. This field is required.</font>"
msgstr "<b><font style=\"font-size: 12px;\">lead_type: </font></b><font style=\"font-size: 12px;\">Tipo de entrega: 'net' para 'Día(s) para obtener los productos' y 'supplier' para 'Día(s) para comprar'. Este campo es obligatorio.</font>"

#. module: import_template_stock_orderpoint
#: model_terms:import.template,description:import_template_stock_orderpoint.template_orderpoint
msgid "<b><font style=\"font-size: 12px;\">location_id: </font></b><font style=\"font-size: 12px;\">location where the product should be stored. This field is required and must be previously created in Odoo.</font>"
msgstr "<b><font style=\"font-size: 12px;\">location_id: </font></b><font style=\"font-size: 12px;\">ubicación donde se debe almacenar el producto. Este campo es obligatorio y debe ser creado previamente en Odoo.</font>"

#. module: import_template_stock_orderpoint
#: model_terms:import.template,description:import_template_stock_orderpoint.template_orderpoint
msgid "<b><font style=\"font-size: 12px;\">product_id: </font></b><font style=\"font-size: 12px;\">product's default code or barcode. This field is required and must be previously created in Odoo.</font>"
msgstr "<b><font style=\"font-size: 12px;\">product_id: </font></b><font style=\"font-size: 12px;\">referencia interna o barcode del producto. Este campo es obligatorio y debe estar creado previamente en Odoo.</font>"

#. module: import_template_stock_orderpoint
#: model_terms:import.template,description:import_template_stock_orderpoint.template_orderpoint
msgid "<b><font style=\"font-size: 12px;\">product_max_qty: </font></b><font style=\"font-size: 12px;\">sets the maximum quantity of product in our warehouse. If not specified default will be 0.</font>"
msgstr "<b><font style=\"font-size: 12px;\">product_max_qty: </font></b><font style=\"font-size: 12px;\">establece la cantidad máxima de producto en nuestro almacén. Si no se especifica, el valor predeterminado será 0.</font>"

#. module: import_template_stock_orderpoint
#: model_terms:import.template,description:import_template_stock_orderpoint.template_orderpoint
msgid "<b><font style=\"font-size: 12px;\">product_min_qty: </font></b><font style=\"font-size: 12px;\">sets the minimum quantity of product in our warehouse. If not specified default will be 0.</font>"
msgstr "<b><font style=\"font-size: 12px;\">product_min_qty: </font></b><font style=\"font-size: 12px;\">establece la cantidad mínima de producto en nuestro almacén. Si no se especifica, el valor predeterminado será 0.</font>"

#. module: import_template_stock_orderpoint
#: model_terms:import.template,description:import_template_stock_orderpoint.template_orderpoint
msgid "<b><font style=\"font-size: 12px;\">qty_multiple: </font></b><font style=\"font-size: 12px;\">order the products only in batches for certain quantities. If not specified default will be 0.</font>"
msgstr "<b><font style=\"font-size: 12px;\">qty_multiple: </font></b><font style=\"font-size: 12px;\">abastecer los productos solo en lotes para ciertas cantidades. Si no se especifica, el valor predeterminado será 0.</font>"

#. module: import_template_stock_orderpoint
#: model_terms:import.template,description:import_template_stock_orderpoint.template_orderpoint
msgid ""
"<font style=\"font-size: 12px;\">If you wish you can add fields setting the name of the field as the column name. To see the name of the fields you must activate developer mode from the Settings/Activate developer mode menu.\n"
"                </font>"
msgstr ""
"<font style=\"font-size: 12px;\">Si lo desea puede añadir campos asignando el nombre del campo como nombre de la columna. Para ver el nombre de los campos debe activar el modo desarrollador desde el menú Configuración/Activar modo desarrollador.\n"
"                </font>"

#. module: import_template_stock_orderpoint
#: model_terms:import.template,description:import_template_stock_orderpoint.template_orderpoint
msgid ""
"<font style=\"font-size: 12px;\">Important notes: The lines that contain an error in any of their fields will not be imported. If a orderpoint rule with the combination of location_id and product_id already exists in the system, it will be updated.\n"
"                </font>"
msgstr ""
"<font style=\"font-size: 12px;\">Notas importantes: Las líneas que contengan algún error en alguno de sus campos no serán importadas en el inventario. Si ya existe una regla de abastecimiento con la combinación de location_id y product_id en el sistema, esta será actualizada.\n"
"                </font>"

