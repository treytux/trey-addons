#. module: import_template_stock_orderpoint
#: model_terms:import.template,description:import_template_stock_orderpoint.template_orderpoint
msgid "<b><font style=\"font-size: 12px;\">lead_days: </font></b><font style=\"font-size: 12px;\">number of days after the orderpoint is triggered to receive the products or to order to the vendor. If not specified default will be 0</font>"
msgstr ""

#. module: import_template_stock_orderpoint
#: model_terms:import.template,description:import_template_stock_orderpoint.template_orderpoint
msgid "<b><font style=\"font-size: 12px;\">lead_type: </font></b><font style=\"font-size: 12px;\">type lead: 'net' for 'Day(s) to get the products' and 'supplier' for 'Day(s) to purchase'. This field is required.</font>"
msgstr ""

#. module: import_template_stock_orderpoint
#: model_terms:import.template,description:import_template_stock_orderpoint.template_orderpoint
msgid "<b><font style=\"font-size: 12px;\">location_id: </font></b><font style=\"font-size: 12px;\">location where the product should be stored. This field is required and must be previously created in Odoo.</font>"
msgstr ""

#. module: import_template_stock_orderpoint
#: model_terms:import.template,description:import_template_stock_orderpoint.template_orderpoint
msgid "<b><font style=\"font-size: 12px;\">product_id: </font></b><font style=\"font-size: 12px;\">product's default code or barcode. This field is required and must be previously created in Odoo.</font>"
msgstr ""

#. module: import_template_stock_orderpoint
#: model_terms:import.template,description:import_template_stock_orderpoint.template_orderpoint
msgid "<b><font style=\"font-size: 12px;\">product_max_qty: </font></b><font style=\"font-size: 12px;\">sets the maximum quantity of product in our warehouse. If not specified default will be 0.</font>"
msgstr ""

#. module: import_template_stock_orderpoint
#: model_terms:import.template,description:import_template_stock_orderpoint.template_orderpoint
msgid "<b><font style=\"font-size: 12px;\">product_min_qty: </font></b><font style=\"font-size: 12px;\">sets the minimum quantity of product in our warehouse. If not specified default will be 0.</font>"
msgstr ""

#. module: import_template_stock_orderpoint
#: model_terms:import.template,description:import_template_stock_orderpoint.template_orderpoint
msgid "<b><font style=\"font-size: 12px;\">qty_multiple: </font></b><font style=\"font-size: 12px;\">order the products only in batches for certain quantities. If not specified default will be 0.</font>"
msgstr ""

#. module: import_template_stock_orderpoint
