<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="document_expiry_form_view" model="ir.ui.view">
        <field name="model">document.expiry</field>
        <field name="arch" type="xml">
            <form string="Document Expiry">
                <header/>
                <sheet>
                    <group>
                        <field name="owner_type" invisible="True"/>
                        <field name="document_type" required="True"/>
                        <field name="document_name" attrs="{'required': [('document_type', 'in', ['custom', 'attachment'])]}"/>
                        <field name="attachment_id" attrs="{'invisible': [('document_type', '!=', 'attachment')], 'required': [('document_type', '=', 'attachment')]}"/>
                        <field name="start_date"/>
                        <field name="end_date"/>
                        <field name="status_id"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_document_expiry_tree" model="ir.ui.view">
        <field name="model">document.expiry</field>
        <field name="type">tree</field>
        <field name="arch" type="xml">
            <tree string="Document Expiry" editable="top" decoration-danger="color == 'red'" decoration-success="color == 'green'" decoration-muted="color == 'gray'" decoration-info="color == 'blue'" decoration-primary="color == 'purple'" decoration-warning="color == 'brown'">
                <field name="owner_type" invisible="True"/>
                <field name="document_type" required="True"/>
                <field name="document_name" attrs="{'required': [('document_type', 'in', ['custom', 'attachment'])]}"/>
                <field name="attachment_id" attrs="{'invisible': [('document_type', '!=', 'attachment')], 'required': [('document_type', '=', 'attachment')]}"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="status_id" widget="label_selection"/>
                <field name="color" invisible="True"/>
            </tree>
        </field>
    </record>
    <record id="view_document_expiry_search" model="ir.ui.view">
        <field name="model">document.expiry</field>
        <field name="arch" type="xml">
            <search string="Search Expiry">
                <field name="status_id"/>
                <field name="end_date"/>
                <field name="owner_type" invisible="True"/>
                <group expand="0" name="group_by" string="Group By">
                    <filter name="status_id" string="Status" context="{'group_by' : 'status_id'}" />
                    <filter name="document_type" string="Document Type" context="{'group_by': 'document_type'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_document_expiry" model="ir.actions.act_window">
        <field name="name">Documents</field>
        <field name="res_model">document.expiry</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_type">form</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('owner_type', '=', 'other')]</field>
        <field name="context">{'default_owner_type': 'other'}</field>
        <field name="view_id" ref="document_expiry.view_document_expiry_tree"/>
        <field name="search_view_id" ref="document_expiry.view_document_expiry_search"/>
    </record>
    <menuitem
            id="menu_document_expiry"
            name="Document Expiry"
            parent="knowledge.menu_document_root"/>
    <menuitem id="menu_document_expiry_other"
              name="Other documents"
              action="action_document_expiry"
              parent="document_expiry.menu_document_expiry"
              sequence="10"
              groups="document_expiry.group_document_expiry_user"/>
</odoo>
