#. module: import_template_inventory
#: model_terms:import.template,description:import_template_inventory.template_inventory
msgid "<b><font style=\"font-size: 12px;\">inventory_id: </font></b><font style=\"font-size: 12px;\">inventory's name. The inventory will be created with this name. This field is required and must be the same for all columns.</font>"
msgstr "<b><font style=\"font-size: 12px;\">inventory_id: </font></b><font style=\"font-size: 12px;\">nombre del inventario. El inventario se creará con este nombre. Este campo es obligatorio y debe ser el mismo para todas las columnas.</font>"

#. module: import_template_inventory
#: model_terms:import.template,description:import_template_inventory.template_inventory
msgid "<b><font style=\"font-size: 12px;\">inventory_location_id: </font></b><font style=\"font-size: 12px;\">inventory's location. The inventory will be created with this location. This field is required, must be the same for all columns and must be previously created in Odoo.</font>"
msgstr "<b><font style=\"font-size: 12px;\">inventory_location_id: </font></b><font style=\"font-size: 12px;\">ubicación del inventario. El inventario se creará con esta ubicación. Este campo es obligatorio, debe ser el mismo para todas las columnas y debe estar creado previamente en Odoo.</font>"

#. module: import_template_inventory
#: model_terms:import.template,description:import_template_inventory.template_inventory
msgid "<b><font style=\"font-size: 12px;\">location_id: </font></b><font style=\"font-size: 12px;\">product's location. This field is required and must be previously created in Odoo.</font>"
msgstr "<b><font style=\"font-size: 12px;\">location_id: </font></b><font style=\"font-size: 12px;\">ubicación del producto. Este campo es obligatorio y debe estar creado previamente en Odoo.</font>"

#. module: import_template_inventory
#: model_terms:import.template,description:import_template_inventory.template_inventory
msgid "<b><font style=\"font-size: 12px;\">prod_lot_id: </font></b><font style=\"font-size: 12px;\">product's lot/serial number. This field must be previously created in Odoo.</font>"
msgstr "<b><font style=\"font-size: 12px;\">prod_lot_id: </font></b><font style=\"font-size: 12px;\">lote/número de serie del producto. Este campo debe ser creado previamente en Odoo.</font>"

#. module: import_template_inventory
#: model_terms:import.template,description:import_template_inventory.template_inventory
msgid "<b><font style=\"font-size: 12px;\">product_id: </font></b><font style=\"font-size: 12px;\">product's default code or barcode. This field is required and must be previously created in Odoo.</font>"
msgstr "<b><font style=\"font-size: 12px;\">product_id: </font></b><font style=\"font-size: 12px;\">referencia interna o código de barras del producto. Este campo es obligatorio y debe ser creado previamente en Odoo.</font>"

#. module: import_template_inventory
#: model_terms:import.template,description:import_template_inventory.template_inventory
msgid "<b><font style=\"font-size: 12px;\">product_qty: </font></b><font style=\"font-size: 12px;\">product's quantity. This field is required.</font>"
msgstr "<b><font style=\"font-size: 12px;\">product_qty: </font></b><font style=\"font-size: 12px;\">cantidad del producto. Este campo es obligatorio.</font>"

#. module: import_template_inventory
#: model_terms:import.template,description:import_template_inventory.template_inventory
msgid ""
"<font style=\"font-size: 12px;\">If you wish you can add fields setting the name of the field as the column name. To see the name of the fields you must activate developer mode from the Settings/Activate developer mode menu.\n"
"                </font>"
msgstr ""
"<font style=\"font-size: 12px;\">Si lo desea puede añadir campos asignando el nombre del campo como nombre de la columna. Para ver el nombre de los campos debe activar el modo desarrollador desde el menú Configuración/Activar modo desarrollador.\n"
"                </font>"

#. module: import_template_inventory
#: model_terms:import.template,description:import_template_inventory.template_inventory
msgid ""
"<font style=\"font-size: 12px;\">Important note: Before importing, check that there are no errors in any line. The lines that contain an error in any of their fields will not be imported into the inventory.\n"
"                </font>"
msgstr ""
"<font style=\"font-size: 12px;\">Nota importante: Antes de la importación revisar que no aparezcan errores en ninguna línea. Las líneas que contengan algún error en alguno de sus campos no serán importadas en el inventario.\n"
"                </font>"

#. module: import_template_inventory
#: model_terms:import.template,description:import_template_inventory.template_inventory
msgid ""
