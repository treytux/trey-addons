<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="academy_academic_training_tree_view" model="ir.ui.view">
        <field name="model">academy.academic.training</field>
        <field name="arch" type="xml">
            <tree string="Academic Training" editable="top">
                <field name="name"/>
                <field name="type"/>
            </tree>
        </field>
    </record>
    <record id="academy_academic_training_form_view" model="ir.ui.view">
        <field name="model">academy.academic.training</field>
        <field name="arch" type="xml">
            <form string="Academic Training">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                    </div>
                    <group>
                        <field name="type"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="academy_academic_training_search_view" model="ir.ui.view">
        <field name="model">academy.academic.training</field>
        <field name="arch" type="xml">
            <search string="Academic Training">
                <field name="name"/>
                <field name="type"/>
                <newline/>
                <group expand="0" string="Group By...">
                    <filter name="for_students" string="For students" domain="[('type','=','student')]"/>
                    <filter name="for_teachers" string="For teachers" domain="[('type','=','teacher')]"/>
                    <filter name="both" string="For both" domain="[('type','=','both')]"/>
                    <separator/>
                    <filter name="type" string="Academic training type" context="{'group_by': 'type'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_academy_academic_training" model="ir.actions.act_window">
        <field name="name">Academic Training</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">academy.academic.training</field>
        <field name="binding_view_types">form</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="academy_academic_training_search_view"/>
    </record>
</odoo>
