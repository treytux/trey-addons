<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fill_bulletin_line_wizard" model="ir.ui.view">
        <field name="model">academy.wizard.fill.bulletin.line</field>
        <field name="arch" type="xml">
            <form string="Fill Bulletin Lines">
                <group>
                    <field name="evaluation_id" options="{'no_create': True}"/>
                </group>
                <footer>
                    <button name="button_accept" class="oe_highlight"
                        type="object" string="Accept"/>
                    <button class="oe_link" special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
