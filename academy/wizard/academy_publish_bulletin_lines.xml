<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="publish_bulletins_wizard" model="ir.ui.view" >
        <field name="model">academy.publish.bulletin.lines</field>
        <field name="arch" type="xml">
            <form string="Publish bulletin lines">
                <group>
                    <field name="evaluation_id"/>
                </group>
                <footer>
                    <button name="button_publish_bulletin_lines" class="oe_highlight"
                        type="object" string="Accept"/>
                    <button class="oe_link" special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_publish_bulletin_lines" model="ir.actions.server">
        <field name="name">Publish bulletin lines</field>
        <field name="model_id" ref="academy.model_academy_activity"/>
        <field name="binding_model_id" ref="academy.model_academy_activity"/>
        <field name="state">code</field>
        <field name="code">
            action = {
                'type': 'ir.actions.act_window',
                'name': 'Publish bulletin lines',
                'res_model': 'academy.publish.bulletin.lines',
                'view_mode': 'form',
                'view_type': 'form',
                'target': 'new',
             }
       </field>
    </record>
</odoo>
