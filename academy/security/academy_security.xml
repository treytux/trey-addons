<odoo>
    <record model="ir.module.category" id="module_category_academy">
        <field name="name">Academy</field>
        <field name="sequence">102</field>
    </record>
    <record id="group_academy_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_academy"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    <record id="group_academy_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_academy"/>
    </record>
    <record id="group_academy_teacher" model="res.groups">
        <field name="name">Teacher</field>
        <field name="category_id" ref="module_category_academy"/>
    </record>
    <record id="group_academy_tutor" model="res.groups">
        <field name="name">Tutor</field>
        <field name="category_id" ref="module_category_academy"/>
    </record>
    <record id="group_academy_student" model="res.groups">
        <field name="name">Student</field>
        <field name="category_id" ref="module_category_academy"/>
    </record>
    <record id="enrollment_student_rule" model="ir.rule">
        <field name="name">Enrollments</field>
        <field ref="model_academy_enrollment" name="model_id"/>
        <field name="domain_force">[('student_id','=',user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('academy.group_academy_student'))]"/>
    </record>
    <record model="ir.rule" id="res_partner_student_tutor_teacher_rule">
        <field name="name">res_partner: portal/public: read access to academy student, tutor and teacher</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="domain_force">[]</field>
        <field name="groups" eval="[(4, ref('academy.group_academy_student')), (4, ref('academy.group_academy_tutor')), (4, ref('academy.group_academy_teacher'))]"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="perm_write" eval="False"/>
    </record>
</odoo>
