<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="footer_custom" inherit_id="website.footer_custom">
        <xpath expr="//a[@href='/website/social/linkedin']" position="after">
            <a t-if="website.social_flickr" t-att-href="website.social_flickr" class="s_social_media_flickr"><i class="fa rounded-circle shadow-sm o_editable_media fa-flickr"/></a>
            <a t-if="website.social_pinterest" t-att-href="website.social_pinterest" class="s_social_media_pinterest"><i class="fa rounded-circle shadow-sm o_editable_media fa-pinterest"/></a>
            <a t-if="website.social_reddit" t-att-href="website.social_reddit" class="s_social_media_reddit"><i class="fa rounded-circle shadow-sm o_editable_media fa-reddit"/></a>
            <a t-if="website.social_skype" t-attf-href="skype:#{ website.social_skype }?call" class="s_social_media_skype"><i class="fa rounded-circle shadow-sm o_editable_media fa-skype"/></a>
            <a t-if="website.social_tumblr" t-att-href="website.social_tumblr" class="s_social_media_tumblr"><i class="fa rounded-circle shadow-sm o_editable_media fa-tumblr"/></a>
            <a t-if="website.social_twitch" t-att-href="website.social_twitch" class="s_social_media_twitch"><i class="fa rounded-circle shadow-sm o_editable_media fa-twitch"/></a>
            <a t-if="website.social_vimeo" t-att-href="website.social_vimeo" class="s_social_media_vimeo"><i class="fa rounded-circle shadow-sm o_editable_media fa-vimeo"/></a>
            <a t-if="website.social_whatsapp" t-attf-href="https://api.whatsapp.com/send?phone=#{ website.social_whatsapp }" class="s_social_media_whatsapp"><i class="fa rounded-circle shadow-sm o_editable_media fa-whatsapp"/></a>
        </xpath>
    </template>
</odoo>
