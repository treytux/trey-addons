<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_partner_category_form" model="ir.ui.view">
        <field name="model">res.partner.category</field>
        <field name="inherit_id" ref="base.view_partner_category_form"/>
        <field name="arch" type="xml">
            <field name="active" position="after">
                <field name="is_partner_typology"/>
                <field name="min_planned_rate" widget="percentage" attrs="{'invisible': [('is_partner_typology', '=', False)]}"/>
                <field name="max_planned_rate" widget="percentage" attrs="{'invisible': [('is_partner_typology', '=', False)]}"/>
            </field>
        </field>
    </record>
    <record id="view_partner_category_list" model="ir.ui.view">
        <field name="model">res.partner.category</field>
        <field name="inherit_id" ref="base.view_partner_category_list"/>
        <field name="arch" type="xml">
            <field name="color" position="after">
                <field name="is_partner_typology" optional="show"/>
                <field name="min_planned_rate" widget="percentage" optional="show" attrs="{'invisible': [('is_partner_typology', '=', False)]}"/>
                <field name="max_planned_rate" widget="percentage" optional="show" attrs="{'invisible': [('is_partner_typology', '=', False)]}"/>
            </field>
        </field>
    </record>
</odoo>
