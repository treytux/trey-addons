<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="pricelist_list"
              inherit_id="website_sale.pricelist_list"
              customize_show="True"
              name="Hide Pricelist Selector">
        <xpath expr="//div[contains(@t-attf-class, 'o_pricelist_dropdown')]" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
    </template>
</odoo>
