<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="website_pages_form_view" model="ir.ui.view">
        <field name="model">website.page</field>
        <field name="inherit_id" ref="website.website_pages_form_view"/>
        <field name="arch" type="xml">
            <field name="website_published" position="after">
                <field name="internal_only"/>
            </field>
        </field>
    </record>
    <record id="menu_tree" model="ir.ui.view">
        <field name="model">website.menu</field>
        <field name="inherit_id" ref="website.menu_tree"/>
        <field name="arch" type="xml">
            <field name="new_window" position="after">
                <field name="internal_only"/>
            </field>
        </field>
    </record>
    <record id="website_menus_form_view" model="ir.ui.view">
        <field name="model">website.menu</field>
        <field name="inherit_id" ref="website.website_menus_form_view"/>
        <field name="arch" type="xml">
            <field name="new_window" position="after">
                <field name="internal_only"/>
            </field>
        </field>
    </record>
</odoo>
