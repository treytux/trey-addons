<odoo>
    <record id="wizard_teacher_attendance_report_form" model="ir.ui.view">
        <field name="model">academy.wizard.teacher.attendance.report</field>
        <field name="arch" type="xml">
            <form string="Teacher Attendance Report">
                <group>
                    <group>
                        <field name="teacher_id"/>
                        <field name="company_id" invisible="1"/>
                    </group>
                    <group>
                        <field name="date_start"/>
                        <field name="date_end"/>
                    </group>
                </group>
                <div>
                    <field name="line_ids">
                        <tree editable="bottom">
                            <field name="date"/>
                            <field name="attendance_sheet_id"/>
                            <field name="substitution"/>
                            <field name="training_plan_id"/>
                            <field name="activity_id"/>
                            <field name="duration"/>
                        </tree>
                    </field>
                </div>
                <group>
                    <group>
                        <field name="total_minutes"
                               attrs="{'invisible':[('line_ids','=',[])]}"/>
                        <field name="total_classes"
                               attrs="{'invisible':[('line_ids','=',[])]}"/>
                    </group>
                    <group>
                        <field name="total_hours"
                               attrs="{'invisible':[('line_ids','=',[])]}"/>
                    </group>
                </group>
                <footer>
                    <button name="button_print"
                            type="object"
                            string="Print Report"
                            class="oe_highlight"
                            attrs="{'invisible':[('line_ids','=',[])]}"/>
                    <button class="oe_link"
                            special="cancel"
                            string="Cancel"/>
                </footer>
             </form>
        </field>
    </record>
    <record id="act_teacher_attendance_report" model="ir.actions.act_window">
        <field name="name">Teacher Attendance Report</field>
        <field name="res_model">academy.wizard.teacher.attendance.report</field>
        <field name="view_mode">form</field>
        <field name="binding_view_types">tree</field>
        <field name="target">new</field>
        <field name="view_id" ref="wizard_teacher_attendance_report_form"/>
        <field name="groups_id" eval="[(6,0,[ref('academy.group_academy_manager'), ref('academy.group_academy_user')])]"/>
    </record>
</odoo>
