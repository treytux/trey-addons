<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="academy_attendance_sheet_line_tree_view" model="ir.ui.view">
        <field name="model">academy.attendance.sheet.line</field>
        <field name="arch" type="xml">
            <tree string="Attendance Sheet Lines">
                <field name="name"/>
                <field name="date"/>
                <field name="activity_id"/>
                <field name="student_id"/>
                <field name="present"/>
                <field name="comments"/>
            </tree>
        </field>
    </record>
    <record id="academy_attendance_sheet_line_form_view" model="ir.ui.view">
        <field name="model">academy.attendance.sheet.line</field>
        <field name="arch" type="xml">
            <form string="Attendance Sheet Lines" create="false" edit="true">
                <sheet>
                    <div class="oe_right oe_button_box" name="buttons">
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="student_id"/>
                        </group>
                        <group>
                            <field name="activity_id"/>
                            <field name="present"/>
                        </group>
                    </group>
                    <group>
                        <field name="comments"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="academy_attendance_sheet_line_search_view" model="ir.ui.view">
        <field name="model">academy.attendance.sheet.line</field>
        <field name="arch" type="xml">
            <search string="Attendance Sheet Lines">
                <field name="date"/>
                <field name="activity_id"/>
                <field name="student_id"/>
                <newline/>
                <group name="groupby" string="Group By">
                    <filter string="Student" name="student" context="{'group_by':'student_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_academy_attendance_sheet_line" model="ir.actions.act_window">
        <field name="name">Manage Absences</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">academy.attendance.sheet.line</field>
        <field name="binding_view_types">form</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="academy_attendance_sheet_line_search_view"/>
        <field name="domain">[('present','=',False)]</field>
    </record>
    <record id="action_academy_attendance_sheet_line_student" model="ir.actions.act_window">
        <field name="name">Absences</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">academy.attendance.sheet.line</field>
        <field name="binding_view_types">form</field>
        <field name="view_mode">tree</field>
        <field name="search_view_id" ref="academy_attendance_sheet_line_search_view"/>
        <field name="domain">[('student_id.user_ids','in',uid),('present','=',False)]</field>
    </record>
    <record id="action_academy_attendance_sheet_line_tutor" model="ir.actions.act_window">
        <field name="name">Student Absences</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">academy.attendance.sheet.line</field>
        <field name="binding_view_types">form</field>
        <field name="view_mode">tree</field>
        <field name="search_view_id" ref="academy_attendance_sheet_line_search_view"/>
        <field name="domain">[('student_id.tutor_ids.user_ids','in',uid),('present','=',False)]</field>
    </record>
</odoo>
