<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="academy_activity_form_view" model="ir.ui.view">
        <field name="model">academy.activity</field>
        <field name="inherit_id" ref="academy.academy_activity_form_view"/>
        <field name="arch" type="xml">
            <header position="inside">
                <button name="action_print_attendance_sheet"
                    string="Print attendance sheet"
                    type="object"
                    class="btn-primary"
                    icon="fa-print"
                />
            </header>
            <page name="enrollments" position="after">
                <page name="attendance_generator" string="Attendance generator">
                    <field name="plan_attendance_line_ids">
                        <tree editable="bottom">
                            <field name="attendance_sheet_ids" invisible="1"/>
                            <field name="time_begin" widget="float_time"/>
                            <field name="time_end" widget="float_time"/>
                            <field name="teacher_id"/>
                            <field name="period"/>
                            <field name="weekday"/>
                            <button name="generate_attendances"
                                string="Generate attendances"
                                type="object"
                                icon="fa-cogs"
                                class="btn-primary o_list_button_generate_attendances"
                                options='{"warn": true}'
                                attrs="{'invisible': [('attendance_sheet_ids', '!=', [])]}"
                                confirm="Attendances will be generated with actual parameters, are you sure?"/>
                        </tree>
                    </field>
                </page>
            </page>
        </field>
    </record>
</odoo>
