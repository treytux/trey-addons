<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="academy_attendance_sheet_tree_view" model="ir.ui.view">
        <field name="model">academy.attendance.sheet</field>
        <field name="arch" type="xml">
            <tree string="Attendance Sheets">
                <field name="name"/>
                <field name="date"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="duration"/>
                <field name="user_id"/>
                <field name="teacher_id"/>
                <field name="activity_id"/>
                <field name="substitution"/>
                <field name="substitute_teacher_id"/>
                <field name="state"/>
            </tree>
        </field>
    </record>
    <record id="academy_attendance_sheet_form_view" model="ir.ui.view">
        <field name="model">academy.attendance.sheet</field>
        <field name="arch" type="xml">
            <form string="Attendance Sheets">
                <header>
                    <button name="to_ready" states="draft" string="Set Ready to Start" groups="academy.group_academy_manager,academy.group_academy_user,academy.group_academy_teacher" class="oe_highlight" type="object"/>
                    <button name="to_ended" states="ready" string="Set Ended" groups="academy.group_academy_manager,academy.group_academy_user,academy.group_academy_teacher" class="oe_highlight" type="object"/>
                    <button name="to_cancelled" states="draft,ready" string="Set Cancelled" groups="academy.group_academy_manager,academy.group_academy_user,academy.group_academy_teacher" type="object"/>
                    <button name="to_draft" states="cancelled" string="Set Draft" groups="academy.group_academy_manager,academy.group_academy_user,academy.group_academy_teacher" type="object"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,ready,ended"/>
                </header>
                <sheet>
                    <div class="oe_title oe_left">
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                    </div>
                    <div class="oe_right oe_button_box" name="buttons">
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="teacher_id" domain="[('is_activity_selectable','=',True)]"/>
                            <field name="activity_id" options="{'no_create': True}"/>
                            <field name="filters" string="Attendance Sheet of" widget="radio" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                        </group>
                        <group>
                            <field name="substitution"/>
                            <field name="substitute_teacher_id" domain="[('is_activity_selectable','=',True)]" attrs="{'invisible': [('substitution', '=', False)], 'required': [('substitution', '=', True)]}"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="duration" groups="academy.group_academy_manager,academy.group_academy_user"/>
                            <field name="student_ids" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="lines" string="Students" attrs="{'invisible':[('state','=','draft')]}">
                            <field name="attendance_line_ids">
                                <tree editable="top" default_order="student_id asc">
                                    <field name="student_id" domain="[('is_student','=',True),('id','in',parent.student_ids)]"/>
                                    <field name="academic_training_ids" widget="many2many_tags"/>
                                    <field name="tutor_mobile"/>
                                    <field name="present"/>
                                    <field name="comments"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>
    <record id="academy_attendance_sheet_search_view" model="ir.ui.view">
        <field name="model">academy.attendance.sheet</field>
        <field name="arch" type="xml">
            <search string="Attendance Sheets">
                <field name="name"/>
                <field name="date"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="duration"/>
                <field name="teacher_id"/>
                <field name="substitute_teacher_id"/>
                <field name="activity_id"/>
                <separator/>
                <filter string="My attendance sheets" name="my_attendance_sheets" domain="[('user_id','=', uid)]"/>
                <separator/>
                <filter string="Today" name="today" domain="[('date','&gt;=',current_date),('date','&lt;=',current_date)]"/>
                <filter string="Yesterday"
                    name="yesterday"
                    domain="[('date','&lt;=', (context_today() - relativedelta(days=1)).strftime('%%Y-%%m-%%d')),
                    ('date','&gt;',(context_today() - relativedelta(days=2)).strftime('%%Y-%%m-%%d'))]"/>
                <filter string="Current week"
                    name="current_week"
                    domain="[('date','&lt;=', (context_today() + relativedelta(weeks=0, weekday=6)).strftime('%%Y-%%m-%%d')),
                    ('date','&gt;',(context_today() - relativedelta(weeks=1, weekday=6)).strftime('%%Y-%%m-%%d'))]"/>
                <filter string="Current month"
                    name="current_month"
                    domain="[('date','&lt;',(context_today()+relativedelta(months=1)).strftime('%%Y-%%m-01')),
                    ('date','&gt;=',time.strftime('%%Y-%%m-01'))]"/>
                <separator/>
                <newline/>
                <group string="Group By" name="group_by">
                    <filter string="Date" name="date" context="{'group_by':'date'}"/>
                    <filter string="Day" name="day" context="{'group_by': 'date:day'}"/>
                    <filter string="Start Date" name="start_date" context="{'group_by':'date_start'}"/>
                    <filter string="End Date" name="end_date" context="{'group_by':'date_end'}"/>
                    <filter string="Teacher" name="teacher" context="{'group_by':'teacher_id'}"/>
                    <filter string="Substitute Teacher" name="substitute teacher" context="{'group_by':'substitute_teacher_id'}"/>
                    <filter string="Activity" name="activity" context="{'group_by':'activity_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_academy_attendance_sheet" model="ir.actions.act_window">
        <field name="name">Attendance Sheets</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">academy.attendance.sheet</field>
        <field name="binding_view_types">form</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_my_attendance_sheets': 1, 'search_default_today': 1}</field>
        <field name="search_view_id" ref="academy_attendance_sheet_search_view"/>
    </record>
</odoo>
