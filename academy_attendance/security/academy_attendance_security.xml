<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="attendance_sheet_teacher_rule" model="ir.rule">
        <field name="name">Teacher Attendance Sheets</field>
        <field name="model_id" ref="model_academy_attendance_sheet"/>
        <field name="domain_force">['|','|',('teacher_id','=',user.employee_id.id),('teacher_id','=',False),('substitute_teacher_id','=',user.employee_id.id)]</field>
        <field name="groups" eval="[(4, ref('academy.group_academy_teacher'))]"/>
    </record>
</odoo>
