<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_merge_form" model="ir.ui.view">
        <field name="model">sale.order.merge</field>
        <field name="arch" type="xml">
            <form string="Merge Orders">
                <sheet>
                    <div>
                        <h2>Are you sure you want to merge selected the orders?</h2>
                        <p>This operation cannot be reversed.</p>
                        <small>Can only merge orders whose status is draft.</small>
                    </div>
                </sheet>
                <footer class="o_form_view">
                    <button name="action_merge" string="Accept" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="sale_order_merge_action" model="ir.actions.act_window">
        <field name="name">Merge Orders</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sale.order.merge</field>
        <field name="view_type">form</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
    </record>
</odoo>
