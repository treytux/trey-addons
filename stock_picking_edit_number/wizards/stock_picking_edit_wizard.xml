<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="stock_picking_edit_wizard" model="ir.ui.view">
        <field name="model">stock.picking.edit_wizard</field>
        <field name="arch" type="xml">
            <form string="Force stock picking">
                <group col="4" colspan="4">
                    <group colspan="4" col="2">
                        <separator string="Fill picking data:" colspan="2"/>
                        <field name="number" string="Picking number" required="1"/>
                        <field name="date" string="Picking date" required="1"/>
                    </group>
                </group>
                <footer>
                    <button name="button_save"
                        class="oe_highlight"
                        type="object"
                        string="Save"
                    />
                    <button class="btn-secondary"
                        special="cancel"
                        string="Cancel"
                    />
                </footer>
            </form>
        </field>
    </record>
    <record id="action_edit_number" model="ir.actions.act_window">
        <field name="name">Force stock picking</field>
        <field name="res_model">stock.picking.edit_wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
    </record>
</odoo>
