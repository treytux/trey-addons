<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='webmaster_settings']" position="after">
                <h2>Leaves request</h2>
                <div id="leaves" class="row mt16 o_settings_container">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="holidays_type"/>
                            <div class="text-muted">
                                Set leave type for holidays (needed for employee portal)
                            </div>
                            <div class="content-group">
                                <div class="mt16">
                                    <field name="holidays_type" class="o_light_label" widget="many2many_tags"/>
                                </div>
                            </div>
                            <label for="absences_type"/>
                            <div class="text-muted">
                                Set leave type for absences (needed for employee portal)
                            </div>
                            <div class="content-group">
                                <div class="mt16">
                                    <field name="absences_type" class="o_light_label" widget="many2many_tags"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
