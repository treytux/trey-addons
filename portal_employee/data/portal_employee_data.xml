<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="notify_new_document" model="mail.template">
            <field name="name">Portal employee: Notify new document</field>
            <field name="model_id" ref="document_page.model_document_page"/>
            <field name="subject">New document added: ${ object.name }</field>
            <field name="email_from">${('"%s" &lt;%s&gt;' % (object.company_id.name, object.company_id.email or user.email))|safe}</field>
            <field name="email_to"></field>
            <field name="body_html" type="html">
<p>Hello,</p>
<p>A new document is added to your account: <a href="/employee/knowledge/document/${ object.id }">${ object.name }</a></p>
<p>Have a great day.</p>
            </field>
            <field name="auto_delete" eval="True"/>
            <field name="user_signature" eval="False"/>
        </record>
    </data>
</odoo>
