<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_invoice_refs_view" model="ir.ui.view">
        <field name="model">purchase.order.invoice_refs</field>
        <field name="arch" type="xml">
            <form string="Invoice by refs">
                <sheet>
                    <field name="step" invisible="1"/>
                    <div attrs="{'invisible': [('step', '!=', 0)]}">
                        <group name="config_group">
                            <group>
                                <field name="partner_id" attrs="{'readonly': [('step', '!=', 0)]}" options="{'no_create': True}"/>
                                <field name="method" attrs="{'readonly': [('step', '!=', 0)]}"/>
                            </group>
                            <group>
                                <field name="join_purchases" attrs="{'readonly': [('step', '!=', 0)]}"/>
                            </group>
                        </group>
                        <separator string="Enter References"/>
                        <p class="text-muted">
                            Enter the purchase order names or partner references (one per line).
                        </p>
                        <field name="references" placeholder="PO00001&#10;REF-9988..." attrs="{'invisible': [('step', '!=', 0)]}" nolabel="1"/>
                    </div>
                    <div attrs="{'invisible': [('step', '!=', 1)]}">
                        <notebook>
                            <page string="Messages" name="messages" attrs="{'invisible': [('line_ids', '=', False)]}">
                                <field name="line_ids" readonly="1" nolabel="1">
                                    <tree decoration-warning="type == 'warning'" decoration-danger="type == 'error'">
                                        <field name="type" invisible="1"/>
                                        <field name="ref"/>
                                        <field name="name"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Purchases to invoice" name="purchases">
                                <field name="purchase_ids" domain="[('partner_id', '=', partner_id)]" nolabel="1">
                                    <tree create="false" delete="false">
                                        <field name="name"/>
                                        <field name="partner_ref"/>
                                        <field name="date_order" widget="date"/>
                                        <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state in ('done', 'purchase')"/>
                                        <field name="amount_total" sum="Total"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </div>
                </sheet>
                <footer>
                    <button name="action_find"
                            string="Find purchases"
                            type="object"
                            class="oe_highlight"
                            attrs="{'invisible': [('step', '!=', 0)]}"/>
                    <button name="action_back"
                            string="Back"
                            type="object"
                            attrs="{'invisible': [('step', '!=', 1)]}"/>
                    <button name="action_invoice"
                            string="Invoice"
                            type="object"
                            class="oe_highlight"
                            attrs="{'invisible': [('step', '!=', 1)]}"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="purchase_order_invoice_refs_action" model="ir.actions.act_window">
        <field name="name">Invoice by refs</field>
        <field name="res_model">purchase.order.invoice_refs</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <menuitem
        id="purchase_order_invoice_refs_action_menu"
        name="Invoice by refs"
        parent="purchase.menu_procurement_management"
        action="purchase_order_invoice_refs_action"
        sequence="50"/>
</odoo>
