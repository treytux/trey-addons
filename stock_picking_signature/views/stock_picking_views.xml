<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form" model="ir.ui.view">
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_assign']" position="after">
                <button name="action_sign" class="oe_highlight" type="object" string="Sign"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page name="picking_signature" string="Signature">
                    <group name="signature">
                        <field name="signed_by" readonly="True"/>
                        <field name="signature_datetime" readonly="True"/>
                        <field name="signature" filename="signature_filename" widget="image" readonly="True"/>
                        <field name="delivery_proof_image" filename="delivery_proof_filename" widget="image" readonly="True"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
