<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="wizard_stock_picking_signature" model="ir.ui.view">
        <field name="model">wizard.stock.picking.signature</field>
        <field name="arch" type="xml">
            <form string="Picking signature">
                <group>
                    <field name="filename"/>
                    <field name="signature" widget="signature"/>
                </group>
                <footer>
                    <button name="button_accept_sign" class="oe_highlight"
                        type="object" string="Sign"/>
                    or
                    <button class="oe_link" special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <act_window id="stock_picking_signature_wizard_action"
        name="Stock picking signature wizard"
        src_model="stock.picking"
        res_model="wizard.stock.picking.signature"
        view_mode="form"
        target="new"
        key2="client_action_multi"/>
</odoo>
