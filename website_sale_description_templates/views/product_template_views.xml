<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view" model="ir.ui.view">
        <field name="model">product.template</field>
        <field name="inherit_id" ref="website_sale.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='shop']//group" position="inside">
                <field name="content_template"/>
            </xpath>
        </field>
    </record>
    <record id="product_template_form_view" model="ir.ui.view">
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@groups='product.group_product_variant']" position="after">
                <button name="action_set_content_template"
                    string="Assign content template" type="object"/>
            </xpath>
        </field>
    </record>
</odoo>
