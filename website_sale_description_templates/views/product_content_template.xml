<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_content_template_form_view" model="ir.ui.view">
        <field name="model">product.content.template</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" required="True"/></h1>
                    </div>
                    <notebook>
                        <page string="Content">
                            <field name="body_html" widget="html" options="{'style-inline': True}"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="product_content_template_tree_view" model="ir.ui.view">
        <field name="model">mail.template</field>
        <field name="arch" type="xml">
            <tree string="Product content template">
                <field name="name"/>
            </tree>
        </field>
    </record>
    <record id="product_content_template_search_view" model="ir.ui.view">
        <field name="model">product.content.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
            </search>
        </field>
    </record>
    <record model="ir.actions.act_window" id="product_content_template_action">
        <field name="name">Product content template</field>
        <field name="res_model">product.content.template</field>
        <field name="view_type">form</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="menu_sale_product_content_template"
        name="Product content template"
        action="website_sale_description_templates.product_content_template_action"
        parent="sale.prod_config_main"
        sequence="20"/>
    <menuitem id="menu_website_product_content_template"
        name="Product content template"
        action="website_sale_description_templates.product_content_template_action"
        parent="website_sale.menu_catalog"
        sequence="30"/>
</odoo>
