<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="wizard_product_content_tempalte" model="ir.ui.view">
        <field name="model">wizard.product.content.template</field>
        <field name="arch" type="xml">
            <form string="Set content template">
                <group name="set_content_template">
                    <field name="content_template"/>
                </group>
                <footer>
                    <button name="button_set_content_template" class="oe_highlight"
                        type="object" string="Set"/>
                    or
                    <button class="oe_link" special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <act_window id="content_template_wzd_action"
        name="Set content template"
        res_model="wizard.product.content.template"
        view_mode="form"
        target="new"
        key2="client_action_multi"/>
</odoo>
