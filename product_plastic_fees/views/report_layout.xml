<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="external_layout_background" inherit_id="web.external_layout_background">
        <xpath expr="//div[hasclass('footer')]//ul[hasclass('list-inline')]" position="inside">
            <t t-if="company.product_producer_number and doc_model in ['account.invoice', 'stock.picking']">
                <li class="list-inline-item">
                    Producer No.: <span t-field="company.product_producer_number"/>
                </li>
            </t>
        </xpath>
    </template>
