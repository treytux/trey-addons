<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="product_normal_form_view" model="ir.ui.view">
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <page name="tax_fees" position="inside">
                <group string="Plastic fees" name="group_plastic_fees">
                    <field name="plastic_non_recycled_percentage"/>
                    <field name="plastic_weight"/>
                    <field name="plastic_weight_non_recycled"/>
                </group>
            </page>
        </field>
    </record>
</odoo>
