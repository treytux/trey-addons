#. module: import_template_product_variant
#: model_terms:import.template,description:import_template_product_variant.template_product_variant
msgid ""
"<strong>*TMPL*description_sale: </strong>product's description for customers."
msgstr ""
"<strong>*TMPL*description_sale: </strong>descripción del producto para los "
"clientes."

#. module: import_template_product_variant
#: model_terms:import.template,description:import_template_product_variant.template_product_variant
msgid "<strong>*TMPL*image: </strong>image url for product template."
msgstr ""
"<strong>*TMPL*image: </strong>url de la imagen para la plantilla de producto."

#. module: import_template_product_variant
#: model_terms:import.template,description:import_template_product_variant.template_product_variant
msgid ""
"<strong>*TMPL*invoice_policy: </strong>indicates the invoicing policy to be "
"used for sales."
msgstr ""
"<strong>*TMPL*invoice_policy: </strong>indica la política de facturación "
"usada para ventas."

#. module: import_template_product_variant
#: model_terms:import.template,description:import_template_product_variant.template_product_variant
msgid "<strong>*TMPL*list_price: </strong>product's sale price."
msgstr "<strong>*TMPL*list_price: </strong>precio de venta del producto."

#. module: import_template_product_variant
#: model_terms:import.template,description:import_template_product_variant.template_product_variant
msgid ""
"<strong>*TMPL*product_brand_id: </strong>product's brand name that must be "
"previously created in Odoo."
msgstr ""
"<strong>*TMPL*product_brand_id: </strong>nombre de la marca del producto que "
"debe estar creada previamente en Odoo."

#. module: import_template_product_variant
#: model_terms:import.template,description:import_template_product_variant.template_product_variant
msgid ""
"<strong>*TMPL*purchase_ok: </strong>indicates if the product can be "
"purchased."
msgstr ""
"<strong>*TMPL*purchase_ok: </strong>indica si el producto puede ser comprado."

#. module: import_template_product_variant
#: model_terms:import.template,description:import_template_product_variant.template_product_variant
msgid "<strong>*TMPL*sale_ok: </strong>indicates if the product can be sold."
msgstr ""
"<strong>*TMPL*sale_ok: </strong>indica si el producto puede ser vendido."

#. module: import_template_product_variant
#: model_terms:import.template,description:import_template_product_variant.template_product_variant
msgid ""
"<strong>attribute: attribute_name </strong>\n"
"                        It will only be completed if the product has "
"variants. The file will have a column for each attribute. Each column "
"contains \"attribute:\" followed by the corresponding attribute name. The "
"value of each attribute will be entered in the corresponding row."
msgstr ""
"<strong>attribute: nombre_atributo </strong>\n"
"                    Sólo será completado si los productos tienen variantes. "
"El fichero tendrá una columna para cada atributo. Cada columna contiene "
"\"attribute:\" seguido por el nombre del atributo correspondiente. El valor "
"de cada atributo se introducirá en la fila correspondiente."

#. module: import_template_product_variant
#: model_terms:import.template,description:import_template_product_variant.template_product_variant
msgid ""
"<strong>barcode: </strong>product's EAN13 code. This field is a unique field "
"in the system."
msgstr ""
"<strong>barcode: </strong>código EAN13 del producto. Este campo es un campo "
"único en el sistema."

#. module: import_template_product_variant
#: model_terms:import.template,description:import_template_product_variant.template_product_variant
msgid ""
"<strong>categ_id: </strong>name of the category. You can indicate a daughter "
"category by separating by '/'; for example: Category1/Category1.1/"
"Category1.1.1"
msgstr ""
"<strong>categ_id: </strong>nombre de la categoría. Si no existe será creada. "
"Puede indicar una categoría hija separando por '/'; por ejemplo: Categoría1/"
"Categoría1.1/Categoría1.1.1"

#. module: import_template_product_variant
#: model_terms:import.template,description:import_template_product_variant.template_product_variant
msgid ""
"<strong>default_code: </strong>product's internal reference. This field is a "
"unique field in the system."
msgstr ""
"<strong>default_code: </strong>referencia interna del producto. Este campo "
"es un campo único en el sistema."

#. module: import_template_product_variant
#: model_terms:import.template,description:import_template_product_variant.template_product_variant
