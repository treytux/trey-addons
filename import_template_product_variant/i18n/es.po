msgstr ""
"<strong>image_variant: </strong>url de la imagen para variante de producto."

#. module: import_template_product_variant
#: model_terms:import.template,description:import_template_product_variant.template_product_variant
msgid "<strong>name: </strong>product template's name."
msgstr "<strong>name: </strong>nombre de la plantilla del producto."

#. module: import_template_product_variant
#: model_terms:import.template,description:import_template_product_variant.template_product_variant
msgid ""
"<strong>product_tmpl_code: </strong>product template's internal reference. "
"This field is required, check that it is correctly filled in the product "
"templates before using this wizard. If it does not exist it will be created."
msgstr ""
"<strong>product_tmpl_code: </strong>referencia interna de la plantilla del "
"producto. Este campo es obligatorio, revise si está correctamente "
"cumplimentado antes de utilizar este asistente. Si no existe será creado."

#. module: import_template_product_variant
#: model_terms:import.template,description:import_template_product_variant.template_product_variant
msgid ""
"<strong>route_ids: </strong>product routes separated by commas, route must "
"be previously created in Odoo."
msgstr ""
"<strong>route_id: </strong>rutas de producto separada por comas, las rutas "
"deben estar previamente creadas en Odoo.."

#. module: import_template_product_variant
#: model_terms:import.template,description:import_template_product_variant.template_product_variant
