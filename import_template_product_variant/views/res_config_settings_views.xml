<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="res_config_settings_view_form_import_template" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="import_template.res_config_settings_view_form_import_template"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='import_template_logs']/div[hasclass('o_settings_container')]" position="inside">
                <div class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane">
                        <field name="log_import_template_product_variant"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="log_import_template_product_variant"/>
                        <div class="text-muted">
                            Enable/disable save logs
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
