<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="wizard_contract_line_lot_import" model="ir.ui.view">
        <field name="model">contract.line.lot.import</field>
        <field name="arch" type="xml">
            <form string="Import contract line lot">
                <field name="step" invisible="1"/>
                <group>
                    <field name="filename" invisible="1"/>

                    <field name="file" filename="filename" attrs="{'invisible': [('step', '!=', 0)]}"/>
                </group>
                <p>
                    Format of the Excel file for lot import:<br/><br/>
                    The file must be an Excel (.xlsx) with the following columns in the first row:<br/>
                    - Suscripción: name or code of the subscription.<br/>
                    - Modalidad Mantenimiento: product code of the contract line.<br/>
                    - S/N: serial number or lot.<br/>
                    - P/N: product code that the lot belongs to.<br/><br/>
                    Each row represents a lot that will be linked to a contract line.
                </p>
                <p>
                    Conditions:<br/>
                    - All fields are mandatory except P/N, but if S/N is provided, the corresponding P/N must also be specified.<br/>
                    - If the contract, product, or lot does not exist, the system will try to create it, as long as the required information is available.<br/>
                    - If more than one contract or product matches the same name or code, it will be considered an error.<br/>
                    - If no contract line exists with the specified product, the lot cannot be assigned.<br/>
                </p>
                <group name="message_line_ids">
                    <field string="Messages" name="line_ids" readonly="1" attrs="{'invisible': ['|', ('step', '!=', 1), ('line_ids', '=', False)]}" nolabel="1" colspan="2">
                        <tree decoration-warning="type == 'warning'" decoration-danger="type == 'error'">
                            <field name="type" invisible="1"/>
                            <field name="name"/>
                        </tree>
                    </field>
                </group>
                <footer>
                    <button name="action_simulate" class="oe_highlight"
                        type="object" string="Simulate" attrs="{'invisible': [('step', '!=', 0)]}"/>
                    <button name="action_back" class="oe_highlight"
                        type="object" string="Back" attrs="{'invisible': [('step', '!=', 1)]}"/>
                    <button name="button_accept" class="oe_highlight"
                        type="object" string="Accept" attrs="{'invisible': [('step', '!=', 1)]}"/>
                    <button class="oe_link" special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="import_lot_contract_line_wizard_action" model="ir.actions.act_window">
        <field name="name">Import contract line lot</field>
        <field name="res_model">contract.line.lot.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="stock.model_stock_lot"/>
        <field name="binding_view_types">list</field>
    </record>
</odoo>
