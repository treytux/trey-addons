#. module: contract_line_lot_import
#: model_terms:ir.ui.view,arch_db:contract_line_lot_import.wizard_contract_line_lot_import
msgid ""
"Format of the Excel file for lot import:<br/><br/>\n"
"                    The file must be an Excel (.xlsx) with the following "
"columns in the first row:<br/>\n"
"                    - Suscripción: name or code of the subscription.<br/>\n"
"                    - Modalidad Mantenimiento: product code of the contract "
"line.<br/>\n"
"                    - S/N: serial number or lot.<br/>\n"
"                    - P/N: product code that the lot belongs to.<br/><br/>\n"
"                    Each row represents a lot that will be linked to a "
"contract line."
msgstr ""
"Formato del fichero Excel para la importación de lotes:<br/><br/>\n"
"                    El fichero debe ser un Excel (.xlsx) con las siguientes "
"columnas en la primera fila:<br/>\n"
"                    - Suscripción: nombre o código de la suscripción.<br/>\n"
"                    - Modalidad Mantenimiento: código de producto de la "
"línea de contrato.<br/>\n"
"                    - S/N: número de serie o lote.<br/>\n"
"                    - P/N: código de producto al que pertenece el lote.<br/"
"><br/>\n"
"                    Cada fila representa un lote que será unido a una línea "
"de contrato ."

