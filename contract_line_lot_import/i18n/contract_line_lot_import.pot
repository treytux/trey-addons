#. module: contract_line_lot_import
#: model_terms:ir.ui.view,arch_db:contract_line_lot_import.wizard_contract_line_lot_import
msgid ""
"Format of the Excel file for lot import:<br/><br/>\n"
"                    The file must be an Excel (.xlsx) with the following columns in the first row:<br/>\n"
"                    - Suscripción: name or code of the subscription.<br/>\n"
"                    - Modalidad Mantenimiento: product code of the contract line.<br/>\n"
"                    - S/N: serial number or lot.<br/>\n"
"                    - P/N: product code that the lot belongs to.<br/><br/>\n"
"                    Each row represents a lot that will be linked to a contract line."
msgstr ""

