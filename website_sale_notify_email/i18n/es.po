#. module: website_sale_notify_email
#: model:mail.template,report_name:website_sale_notify_email.mail_template_new_website_order
msgid "${(object.name or '').replace('/','_')}"
msgstr ""

#. module: website_sale_notify_email
#: model:mail.template,body_html:website_sale_notify_email.mail_template_new_website_order
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                <p style=\"margin: 0px; padding: 0px;\">\n"
"                    A new website order has been created with reference "
"<strong>${object.name}</strong>.\n"
"                </p>\n"
"                <br/>\n"
"                <span>Contact information:</span>\n"
"                <ul style=\"margin_top: 0px;\">\n"
"                    <li>Customer: <strong>${object.partner_id.name}</"
"strong></li>\n"
"                    <li>\n"
"                        Phone:\n"
"                        % if object.partner_id.phone:\n"
"                            <strong>${object.partner_id.phone}</"
"strong>\n"
"                        % endif\n"
"                    </li>\n"
"                    <li>\n"
"                        Email:\n"
"                        % if object.partner_id.email:\n"
"                            <strong>${object.partner_id.email}</"
"strong>\n"
"                        % endif\n"
"                    </li>\n"
"                </ul>\n"
"                <br/>\n"
"                <smail>${object.company_id.name}</smail>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                <p style=\"margin: 0px; padding: 0px;\">\n"
"                    Se ha creado un nuevo pedido del sitio web con la "
"referencia <strong>${object.name}</strong>.\n"
"                </p>\n"
"                <br/>\n"
"                <span>Información de contacto:</span>\n"
"                <ul style=\"margin_top: 0px;\">\n"
"                    <li>Cliente: <strong>${object.partner_id.name}</"
"strong></li>\n"
"                    <li>\n"
"                        Teléfono:\n"
"                        % if object.partner_id.phone:\n"
"                            <strong>${object.partner_id.phone}</"
"strong>\n"
"                        % endif\n"
"                    </li>\n"
"                    <li>\n"
"                        Email:\n"
"                        % if object.partner_id.email:\n"
"                            <strong>${object.partner_id.email}</"
"strong>\n"
"                        % endif\n"
"                    </li>\n"
"                </ul>\n"
"                <br/>\n"
"                <smail>${object.company_id.name}</smail>\n"
"            </div>\n"
"        "

