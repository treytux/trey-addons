<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button class="oe_stat_button" type="action" name="%(action_account_move_line)d"
                    groups="account.group_account_manager,account.group_account_invoice,account.group_account_user"
                    icon="fa-list">
                    <field string="Invoice lines" name="invoice_line_count" widget="statinfo"/>
                </button>
            </div>
        </field>
    </record>
</odoo>
