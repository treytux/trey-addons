<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='invoice_tab']" position="after">
                <page id="print_line_tab" name="print_line_tab"
                      string="Print Lines"
                      attrs="{'invisible': [('move_type', '=', 'entry')]}">
                    <group>
                        <field name="print_line"/>
                    </group>
                    <button name="action_print_line_copy" string="Copy"
                            type="object"
                            attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <field name="print_line_ids" nolabel="1">
                        <tree editable="bottom" string="Print Lines">
                            <field name="name"/>
                            <field name="quantity"/>
                            <field name="price_unit"/>
                            <field name="discount"/>
                            <field name="tax_ids" widget="many2many_tags"
                                   domain="[
                                       ('type_tax_use', '=?',
                                        parent.invoice_filter_type_domain),
                                       ('company_id', '=',
                                        parent.company_id),
                                   ]"
                                   options="{'no_create': True}"/>
                            <field name="price_subtotal"/>
                            <field name="price_total"/>
                        </tree>
                    </field>
                    <group class="oe_subtotal_footer oe_right">
                        <field name="print_line_untaxed" widget="monetary"
                               options="{'currency_field': 'currency_id'}"/>
                        <div>
                            <label for="print_line_tax"/>
                            <button name="button_diff_update"
                                    attrs="{'invisible': [('state', '!=', 'draft')]}"
                                    string="(update)"
                                    class="oe_link oe_edit_only"
                                    type="object"
                                    help="Recompute taxes and total"/>
                        </div>
                        <field name="print_line_tax" nolabel="1"
                               widget="monetary"
                               options="{'currency_field': 'currency_id'}"/>
                        <field name="print_line_total"
                               class="oe_subtotal_footer_separator"
                               widget="monetary"
                               options="{'currency_field': 'currency_id'}"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
