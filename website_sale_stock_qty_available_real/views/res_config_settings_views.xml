<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website_sale_stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath
                expr="//div[@id='website_warehouse_setting']"
                position="after">
                <div
                    class="row mt16"
                    id="website_sale_stock_qty_mode_setting">
                    <div class="col-12">
                        <label
                            for="website_sale_stock_qty_mode"
                            string="Stock Mode"
                            class="p-0 col-4 o_light_label"/>
                        <field
                            name="website_sale_stock_qty_mode"
                            class="w-auto"/>
                        <label
                            for="website_sale_stock_qty_mode"
                            class="o_light_label"
                            string="Stock quantity used by the online store"/>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
