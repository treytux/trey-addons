<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="report_account_move_ticket_create" model="ir.actions.report">
        <field name="name">Invoice (ticket)</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">print_formats_account_ticket.report_account_move_ticket</field>
        <field name="report_file">print_formats_account_ticket.report_account_move_ticket</field>
        <field name="binding_type">report</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
    </record>
    <record id="report_account_move_ticket_create" model="ir.actions.report">
        <field name="paperformat_id" ref="paperformat_print_formats_account_ticket"/>
    </record>
    <template id="invoice_header">
        <div class="row">
            <div class="col-12">
                <t t-if="o.company_id.logo">
                    <img class="d-block mx-auto" t-att-src="image_data_uri(o.company_id.logo)" alt="Logo"/>
                </t>
                <div class="address text-center mt8">
                    <ul class="list-inline">
                        <li t-if="o.company_id.street"><span t-field="o.company_id.street"/></li>
                        <li t-if="o.company_id.zip" class="list-inline-item"><span t-field="o.company_id.zip"/></li>
                        <li t-if="o.company_id.city" class="list-inline-item"><span t-field="o.company_id.city"/></li>
                        <li t-if="o.company_id.country_id" class="list-inline-item"><span t-field="o.company_id.country_id"/></li>
                        <li t-if="o.company_id.vat"><t t-esc="(o.company_id.country_id.vat_label or 'Tax ID').replace(' ','\N{NO-BREAK SPACE}')"/>: <span t-esc="o.company_id.vat.replace(' ','\N{NO-BREAK SPACE}')"/></li>
                    </ul>
                </div>
            </div>
        </div>
    </template>
    <template id="invoice_subheader">
        <div class="row mt16">
            <div class="col-12">
                <div class="text-center">
                    <t t-if="o.move_type == 'out_refund'">
                        <h5><strong>Simplified Invoice (Refund)</strong></h5>
                    </t>
                    <t t-else="">
                        <h5><strong>Simplified Invoice</strong></h5>
                    </t>
                    <ul class="list-inline">
                        <li class="list-inline-item">Invoice No.: <span t-field="o.name"/></li>
                        <li class="list-inline-item">Date: <span t-field="o.invoice_date"/></li>
                    </ul>
                </div>
            </div>
        </div>
    </template>
    <template id="invoice_lines">
        <div class="row mt16">
            <div class="col-12">
                <table class="table table-sm o_main_table">
                    <thead>
                        <tr>
                            <th><span>Description</span></th>
                            <th name="th_quantity" class="text-end"><span>Quantity</span></th>
                            <th name="th_unit_price" class="text-end"><span>Unit Price</span></th>
                            <th name="th_amounts" class="text-end">
                                <span groups="account.group_show_line_subtotals_tax_excluded">Amount</span>
                                <span groups="account.group_show_line_subtotals_tax_included">Total Price</span>
                            </th>
                        </tr>
                    </thead>
                    <tbody class="invoice_tbody">
                        <t t-set="current_subtotal" t-value="0"/>
                        <t t-foreach="o.invoice_line_ids" t-as="line">
                            <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>
                            <t t-set="current_subtotal" t-value="current_subtotal + line.price_total" groups="account.group_show_line_subtotals_tax_included"/>
                            <tr>
                                <td colspan="4" name="account_move_product_description"><span t-field="line.product_id.display_name"/></td>
                            </tr>
                            <tr class="text-end">
                                <t t-if="not line.display_type">
                                    <td></td>
                                    <td name="td_quantity">
                                        <span t-field="line.quantity"/>
                                        <span t-field="line.uom_id"  groups="uom.group_uom"/>
                                    </td>
                                    <td name="td_unit_price">
                                        <span t-field="line.price_unit"/>
                                    </td>
                                    <td name="td_amounts" class="o_price_total">
                                        <span t-field="line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>
                                        <span t-field="line.price_total" groups="account.group_show_line_subtotals_tax_included"/>
                                    </td>
                                </t>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
        </div>
    </template>
    <template id="invoice_totals">
        <div class="row mt16">
            <div class="col-5">
                <t t-set="payments_vals" t-value="o.sudo().invoice_payments_widget and o.sudo().invoice_payments_widget['content'] or []"/>
                <t t-if="payments_vals">
                    <table class="table table-sm">
                        <tr class="border-black">
                            <td colspan="2"><strong>Payments</strong></td>
                        </tr>
                        <t t-foreach="payments_vals" t-as="payment_vals">
                            <tr>
                                <td><i class="oe_form_field text-end oe_payment_label"><t t-esc="payment_vals['journal_name']"/></i></td>
                                <td class="text-end">
                                    <span t-esc="payment_vals['amount']" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                </td>
                            </tr>
                        </t>
                        <t t-if="o.amount_residual != 0">
                            <tr class="border-black fw-bold">
                                <td>Amount Due</td>
                                <td class="text-end">
                                    <span t-field="o.amount_residual"/>
                                </td>
                            </tr>
                        </t>
                    </table>
                </t>
            </div>
            <div class="offset-1 col-6">
                <table class="table table-sm">
                    <tr class="border-black o_subtotal">
                        <td><strong>Subtotal</strong></td>
                        <td class="text-end">
                            <span t-field="o.amount_untaxed"/>
                        </td>
                    </tr>
                    <t t-set="tax_groups" t-value="o._get_tax_amount_by_group()"/>
                    <t t-foreach="tax_groups" t-as="amount_by_group">
                        <tr>
                            <t t-if="len(o.line_ids.filtered(lambda l: l.tax_line_id)) == 1 and o.amount_untaxed == amount_by_group[2]">
                                <td>
                                    <span t-esc="amount_by_group[0]"/>
                                </td>
                                <td class="text-end">
                                    <span t-esc="amount_by_group[3]" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                </td>
                            </t>
                            <t t-else="">
                                <td>
                                    <span t-esc="amount_by_group[0]"/>
                                    <span>&amp;nbsp;<span>on</span>
                                        <t t-esc="amount_by_group[4]" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                    </span>
                                </td>
                                <td class="text-end">
                                    <span t-esc="amount_by_group[3]" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                </td>
                            </t>
                        </tr>
                    </t>
                    <tr class="border-black o_total">
                        <td><strong>Total</strong></td>
                        <td class="text-end">
                            <span t-field="o.amount_total"/>
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </template>
    <template id="invoice_footer">
        <div class="row mt16">
            <div class="col-12">
                <div class="address text-center mt8 border-top border-black">
                    <ul class="list-inline mt8">
                        <li t-if="o.company_id.phone" class="list-inline-item">Phone: <span t-field="o.company_id.phone"/></li>
                        <li t-if="o.company_id.email" class="list-inline-item">Mail: <span t-field="o.company_id.email"/></li>
                        <li t-if="o.company_id.website" class="list-inline-item">Web: <span t-field="o.company_id.website"/></li>
                        <li>Contact: <span t-field="o.user_id"/></li>
                    </ul>
                </div>
            </div>
        </div>
    </template>
    <template id="report_account_move_ticket_document">
        <t t-call="web.basic_layout">
            <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)"/>
            <div class="page o_pfat_receipt">
                <t t-call="print_formats_account_ticket.invoice_header"/>
                <t t-call="print_formats_account_ticket.invoice_subheader"/>
                <t t-call="print_formats_account_ticket.invoice_lines"/>
                <t t-call="print_formats_account_ticket.invoice_totals"/>
                <t t-call="print_formats_account_ticket.invoice_footer"/>
            </div>
        </t>
    </template>
    <template id="report_account_move_ticket">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="print_formats_account_ticket.report_account_move_ticket_document" t-lang="o.partner_id.lang"/>
            </t>
        </t>
    </template>
</odoo>
