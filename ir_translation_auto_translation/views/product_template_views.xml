<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_product_template_form_inherit_translation" model="ir.ui.view">
        <field name="name">Product Template (Auto Translation)</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_open_label_layout']" position="after">
                <button
                    name="action_open_translation_wizard"
                    type="object"
                    string="Auto Translate"
                    icon="fa-language"
                    class="btn-secondary"/>
            </xpath>
        </field>
    </record>
</odoo>
