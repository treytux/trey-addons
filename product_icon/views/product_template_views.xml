<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="product_template_form_view" model="ir.ui.view">
        <field name="model">product.template</field>
        <field name="inherit_id"
               ref="website_sale.product_template_form_view"/>
        <field name="arch" type="xml">
            <group name="product_template_images" position="after">
                <group name="product_icons" string="Icons"
                       attrs="{'invisible': [('sale_ok', '=', False)]}">
                    <field name="icon_ids" nolabel="1"
                           class="o_website_sale_image_list">
                        <kanban string="Icons">
                            <field name="id"/>
                            <field name="image_128"/>
                            <field name="icon_id"/>
                            <templates>
                                <t t-name="kanban-box">
                                    <div class="o_attachment oe_kanban_global_click o_website_sale_image_card">
                                        <img class="o_image_64_contain"
                                             t-if="record.image_128.raw_value"
                                             t-att-alt="record.icon_id.value"
                                             t-att-src="kanban_image('product.icon', 'image_128', record.icon_id.raw_value)"/>
                                        <div class="o_website_sale_image_card_title"
                                             t-att-title="record.icon_id.value">
                                            <field name="icon_id"/>
                                        </div>
                                    </div>
                                </t>
                            </templates>
                        </kanban>
                    </field>
                </group>
            </group>
        </field>
    </record>
</odoo>
