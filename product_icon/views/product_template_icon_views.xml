<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="product_template_icon_view_form" model="ir.ui.view">
        <field name="model">product.template.icon</field>
        <field name="arch" type="xml">
            <form string="Product template icon">
                <sheet>
                    <field name="product_template_id" invisible="1"/>
                    <field name="image_128" widget="image" class="oe_avatar" readonly="1"/>
                    <group>
                        <field name="icon_id"/>
                        <field name="sequence"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="product_template_icon_view_tree" model="ir.ui.view">
        <field name="model">product.template.icon</field>
        <field name="arch" type="xml">
            <tree string="Product template icons">
                <field name="sequence" widget="handle"/>
                <field name="icon_id"/>
            </tree>
        </field>
    </record>
    <record id="product_template_icon_view_kanban" model="ir.ui.view">
        <field name="model">product.template.icon</field>
        <field name="arch" type="xml">
            <kanban string="Icons">
                <field name="id"/>
                <field name="icon_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <img alt="Icon" class="o_image_64_contain"
                                     t-att-src="kanban_image('product.icon', 'image_128', record.icon_id.raw_value)"/>
                            </div>
                            <div class="oe_kanban_details">
                                <field name="icon_id"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="product_template_icon_action" model="ir.actions.act_window">
        <field name="name">Product template icons</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">product.template.icon</field>
        <field name="view_mode">kanban,tree,form</field>
    </record>
</odoo>
