<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="product_icon_view_form" model="ir.ui.view">
        <field name="model">product.icon</field>
        <field name="arch" type="xml">
            <form string="Product icon">
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar"
                           options="{'preview_image': 'image_128'}"/>
                    <div class="oe_title">
                        <label for="name" string="Image name"/>
                        <h1>
                            <field name="name" placeholder="Image name"/>
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>
    <record id="product_icon_view_tree" model="ir.ui.view">
        <field name="model">product.icon</field>
        <field name="arch" type="xml">
            <tree string="Product icons">
                <field name="name"/>
            </tree>
        </field>
    </record>
    <record id="product_icon_view_kanban" model="ir.ui.view">
        <field name="model">product.icon</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="id"/>
                <field name="name"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <img alt="Icon" class="o_image_64_contain"
                                     t-att-src="kanban_image(
                                     'product.icon', 'image_128',
                                     record.id.raw_value)"/>
                            </div>
                            <div class="oe_kanban_details">
                                <h4>
                                    <a type="open">
                                        <field name="name"/>
                                    </a>
                                </h4>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="product_icon_action" model="ir.actions.act_window">
        <field name="name">Product Icons</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">product.icon</field>
        <field name="view_mode">kanban,tree,form</field>
    </record>
    <menuitem id="product_icon_menu"
              name="Product icons"
              parent="sale.prod_config_main"
              action="product_icon_action"
              sequence="29"/>
</odoo>
