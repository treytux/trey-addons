<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="sale_product_reserve_wizard" model="ir.ui.view">
        <field name="model">sale.product.reserve</field>
        <field name="arch" type="xml">
            <form string="Reserve products">
                <group name="basic_fields_wizard" attrs="{'invisible': [('step', '=', 2)]}">
                    <field name="step" invisible="1"/>
                    <field name="sale_id" invisible="1"/>
                    <field name="picking_type"/>
                    <field name="location_src_id" readonly="1"/>
                    <field name="location_dest_id"/>
                </group>
                <group name="line_reserve_products">
                    <div class="text-center" colspan="4" attrs="{'invisible': [('step', '=', 2)]}">
                        <strong>Assign the lots to the products to reserve them:</strong>
                    </div>
                    <div class="text-center" attrs="{'invisible': [('step', '=', 1)]}" colspan="4">
                        <strong>There are no products with lot or serial number tracking in the sales order</strong>
                    </div>
                    <br/>
                    <field name="line_ids" attrs="{'invisible': [('step', '=', 2)]}" nolabel="1" colspan="4">
                        <tree editable="bottom" edit="1" create="0" delete="0">
                            <field name="product_id" readonly="1"/>
                            <field name="lot_id"/>
                            <field name="location_id" readonly="1"/>
                            <field name="lots_selected" invisible="True"/>
                        </tree>
                    </field>
                </group>
                <group name="wizard_line_messages" string="Messages">
                    <field name="msg_line_ids" nolabel="1" colspan="4">
                        <tree editable="bottom" create="0" delete="0" edit="0">
                            <field name="name"/>
                        </tree>
                    </field>
                </group>
                <footer>
                    <button name="button_create_internal_picking_reserve" class="oe_highlight"
                        type="object" string="Create reservation picking" attrs="{'invisible': [('step', '=', 2)]}"/>
                    <button class="oe_link" special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <act_window id="action_sale_products_reserve"
        name="Reserve products"
        res_model="sale.product.reserve"
        view_mode="form"
        target="new"
        key2="client_action_multi"/>
</odoo>
