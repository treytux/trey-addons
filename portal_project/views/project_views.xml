<?xml version="1.0"?>
<odoo>
    <record id="edit_project" model="ir.ui.view">
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="view_on_portal" type="object" string="View on portal" class="oe_stat_button" icon="fa-globe"/>
            </xpath>
            <xpath expr="//group[@name='group_documents_analytics']" position="after">
                <group>
                    <group name="group_portal" string="Portal">
                        <field name="unit_balance_display"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
