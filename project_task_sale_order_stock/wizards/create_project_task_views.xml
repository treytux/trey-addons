<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_task_create_task_view_form" model="ir.ui.view">
        <field name="model">create.project.task</field>
        <field name="arch" type="xml">
            <form string="Create Task">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Creating this task will automatically create and
                        confirm a sales order, create a picking if
                        applicable, and try to create an invoice.
                    </div>
                    <group>
                        <group>
                            <field name="task_name"/>
                            <field name="date_deadline"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="partner_id"/>
                            <field name="project_id"/>
                        </group>
                    </group>
                    <h4 class="mb-3">Timesheets lines</h4>
                    <field name="timesheet_line_ids" nolabel="1">
                        <tree editable="bottom">
                            <field name="date"/>
                            <field name="employee_id"/>
                            <field name="account_id" groups="analytic.group_analytic_accounting" readonly="1"/>
                            <field name="name"/>
                            <field name="unit_amount"/>
                        </tree>
                    </field>
                    <h4 class="mb-3">Material lines</h4>
                    <group>
                        <field name="destination_location_id" attrs="{'required': [('material_line_ids', '!=', [])]}"/>
                    </group>
                    <field name="material_line_ids" nolabel="1">
                        <tree editable="bottom">
                            <field name="product_id"/>
                            <field name="quantity"/>
                            <field name="lot_id"/>
                        </tree>
                    </field>
                </sheet>
                <footer>
                    <button
                        name="action_create_task"
                        string="Accept"
                        type="object"
                        class="btn-primary"
                    />
                    <button
                        string="Cancel"
                        special="cancel"
                        class="btn-secondary"
                    />
                </footer>
            </form>
        </field>
    </record>
    <record id="action_project_task_create_task" model="ir.actions.act_window">
        <field name="name">Create Task</field>
        <field name="res_model">create.project.task</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="project_task_create_task_view_form"/>
        <field name="target">new</field>
    </record>
    <menuitem
        id="menu_project_task_create_task"
        name="Create Task"
        parent="project.menu_project_management"
        action="action_project_task_create_task"
        sequence="5"
        groups="project.group_project_user"
    />
</odoo>
