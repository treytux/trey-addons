#. module: import_template_partner
#: model_terms:import.template,description:import_template_partner.template_partner
msgid ""
"<b><font style=\"font-size: 12px;\">agent: </font></b><font style=\"font-"
"size: 12px;\">indicates if the partner created is an agent.</font>"
msgstr ""
"<b><font style=\"font-size: 12px;\">agent: </font></b><font style=\"font-"
"size: 12px;\">indica si la empresa creada es un agente.</font>"

#. module: import_template_partner
#: model_terms:import.template,description:import_template_partner.template_partner
msgid ""
"<b><font style=\"font-size: 12px;\">agent_type: </font></b><font style="
"\"font-size: 12px;\">agent's type: 'agent' for 'External agent'. This field "
"is required only when you create an agent.</font>"
msgstr ""
"<b><font style=\"font-size: 12px;\">agent_type: </font></b><font style="
"\"font-size: 12px;\">tipo de agente: 'agent' para 'Agente externo'. Este "
"campo es obligatorio sólo cuando está creando un agente.</font>"

#. module: import_template_partner
#: model_terms:import.template,description:import_template_partner.template_partner
msgid ""
"<b><font style=\"font-size: 12px;\">agents: </font></b><font style=\"font-"
"size: 12px;\">if you want to add agents you must add each agent separated by "
"';' (if you add more than one). Eg: to assign two agents, \"Agent 1\" and "
"\"Agent 2\" you must write: Agent 1;Agent 2</font>:"
msgstr ""
"<b><font style=\"font-size: 12px;\">agents: </font></b><font style=\"font-"
"size: 12px;\">si quiere añadir agentes debe añadir cada categoría separada "
"por ';' (si añade más de una). Ej: para asignar dos agentes, \"Agente 1\" y "
"\"Agente 2\" debe escribir: Agente 1;Agente 2</font>:"

#. module: import_template_partner
#: model_terms:import.template,description:import_template_partner.template_partner
msgid ""
"<b><font style=\"font-size: 12px;\">category_id: </font></b><font style="
"\"font-size: 12px;\">if you want to add partner categories (tags) you must "
"add each category separated by ';' (if you add more than one). Eg: to assign "
"two categories, \"Category 1\" and \"Category 2\" you must write: Category 1;"
"Category 2</font>:"
msgstr ""
"<b><font style=\"font-size: 12px;\">category_id: </font></b><font style="
"\"font-size: 12px;\">si quiere añadir categorías de empresa (etiquetas) debe "
"añadir cada categoría separada por ';' (si añade más de una). Ej: para "
"asignar dos categorías, \"Categoría 1\" y \"Categoría 2\" debe escribir: "
"Categoría 1;Categoría 2</font>:"

#. module: import_template_partner
#: model_terms:import.template,description:import_template_partner.template_partner
msgid ""
"<b><font style=\"font-size: 12px;\">city: </font></b><font style=\"font-"
"size: 12px;\">partner's city name. Fill only if you don't use the \"zip_id\" "
"field.</font>"
msgstr ""
"<b><font style=\"font-size: 12px;\">city: </font></b><font style=\"font-"
"size: 12px;\">nombre de la ciudad de la empresa. Rellenar sólo si no usa el "
"campo \"zip_id\".</font>"

#. module: import_template_partner
#: model_terms:import.template,description:import_template_partner.template_partner
