<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <record id="stock_inventory_barcode_isbn_sequence" model="ir.sequence">
            <field name="name">Inventory barcode ISBN</field>
            <field name="code">stock.inventory.barcode.isbn</field>
            <field name="prefix">AGA-SA-</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
    <data noupdate="1">
        <record id="stock_inventory_barcode_isbn_container_sequence" model="ir.sequence">
            <field name="name">Container ISBN sequence</field>
            <field name="code">stock.inventory.barcode.isbn.container</field>
            <field name="prefix">AGA-CTN-</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
