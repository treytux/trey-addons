<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="action_report_isbn_container" model="ir.actions.report">
        <field name="name">ISBN container label</field>
        <field name="model">stock.inventory.barcode.isbn.container</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">stock_inventory_barcode_isbn.report_stock_isbn_container_label</field>
        <field name="report_file">stock_inventory_barcode_isbn.report_stock_isbn_container_label</field>
        <field name="print_report_name">'%s' % (object.name)</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
        <field name="binding_model_id" ref="model_stock_inventory_barcode_isbn_container"/>
        <field name="binding_type">report</field>
    </record>
    <template id="report_stock_isbn_container_label_document">
        <t t-call="web.basic_layout">
            <div class="page">
                <div class="row">
                    <div class="col-12 text-center">
                        <img t-att-src="'/report/barcode/Code128/'+o.name" style="width:400px;height:75px" alt="Barcode"/>
                        <h3 class="mt-4" t-field="o.name"/>
                    </div>
                </div>
            </div>
        </t>
    </template>
    <template id="report_stock_isbn_container_label">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="stock_inventory_barcode_isbn.report_stock_isbn_container_label_document"/>
            </t>
        </t>
    </template>
</odoo>
