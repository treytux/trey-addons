<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="stock_inventory_barcode_isbn_view" model="ir.ui.view">
        <field name="model">stock.inventory.barcode.isbn</field>
        <field name="arch" type="xml">
            <form string="Stock inventory barcode ISBN">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="open,close"/>
                    <field name="container_live" invisible="True"/>
                    <button name="action_open_inventory" states="close" string="Open inventory" type="object" class="oe_highlight"/>
                    <button name="action_close_inventory" states="open" string="Close inventory" type="object" class="oe_highlight"/>
                    <button name="action_container_in" string="Set in container" attrs="{'invisible': ['|', ('container_id', '!=', False), ('state', '=', 'close')]}" type="object" class="oe_highlight"/>
                    <button name="action_container_out" string="Remove from container" attrs="{'invisible': ['|', ('container_id', '=', False), ('state', '=', 'close')]}" type="object" class="oe_highlight"/>
                    <button name="action_container_close" string="Close container" attrs="{'invisible': ['|', ('container_live', '=', False), ('state', '=', 'close')]}" type="object" class="oe_highlight"/>
                </header>
                <sheet>
                    <field name="message_type" invisible="True"/>
                    <div class="text-center">
                        <div class="alert alert-success" role="status" attrs="{'invisible': [('message_type', '!=', 'success')]}">
                            <field name="message"/>
                        </div>
                        <div class="alert alert-danger" role="status" attrs="{'invisible': [('message_type', '!=', 'error')]}">
                            <field name="message"/>
                        </div>
                    </div>
                    <group name="inventory_barcode_isbn_info" colspan="4">
                        <group name="inventory_barcode_isbn_info" colspan="2">
                            <field name="name" readonly="True"/>
                            <field name="container_id" domain="[('is_live_container', '=', True)]"/>
                            <field name="_barcode_scanned" readonly="True" widget="barcode_handler" attrs="{'invisible': [('state', '=', 'close')]}"/>
                        </group>
                    </group>
                    <field name="line_ids" colspan="4" attrs="{'invisible': [('state', '=', 'close')]}">
                        <tree create="1" decoration-danger="product_id == False" decoration-success="product_id != False">
                            <field name="barcode" force_save="1"/>
                            <field name="product_qty"/>
                            <field name="product_id" readonly="1"/>
                            <button
                                name="update_product_by_isbn"
                                type="object"
                                icon="fa-search"
                                force_save="1"
                                title="Update Product by ISBN"
                                aria-label="Update Product by ISBN"
                            />
                        </tree>
                        <form>
                            <group name="barcodes_isbn_basic_fields">
                                <field name="barcode" default_focus="1"/>
                                <field name="product_qty"/>
                                <field name="product_id" readonly="1"/>
                            </group>
                        </form>
                    </field>
                    <field name="non_editable_line_ids" colspan="4" attrs="{'invisible': [('state', '=', 'open')]}">
                        <tree editable="bottom" create="0" edit="0" delete="0" decoration-danger="product_id == False" decoration-success="product_id != False">
                            <field name="barcode" readonly="1"/>
                            <field name="product_qty" readonly="1"/>
                            <field name="product_id" readonly="1"/>
                        </tree>
                        <form>
                            <group name="barcodes_isbn_basic_fields_2">
                                <field name="barcode" readonly="1"/>
                                <field name="product_qty" readonly="1"/>
                                <field name="product_id" readonly="1"/>
                            </group>
                        </form>
                    </field>
                    <button attrs="{'invisible': [('name', '=', False)]}" string="Print label" name="%(action_stock_inventory_barcode_isbn)d" type="action" icon="fa-barcode fa-lg" class="btn-primary"/>
                    or
                    <button attrs="{'invisible': [('container_id', '=', False)]}" name="action_container_print" string="Print container label" type="object" icon="fa-barcode fa-lg" class="btn-primary"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="stock_inventory_barcode_isbn_view_tree" model="ir.ui.view">
        <field name="model">stock.inventory.barcode.isbn</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="container_id"/>
                <field name="state"/>
            </tree>
        </field>
    </record>
    <record id="stock_inventory_barcode_isbn_view_search" model="ir.ui.view">
        <field name="model">stock.inventory.barcode.isbn</field>
        <field name="arch" type="xml">
            <search string="Stock inventory barcode ISBN">
                <field name="name"/>
                <field name="container_id"/>
                <filter name="filter_open" string="Open" domain="[('state', '=', 'open')]"/>
                <filter name="filter_close" string="Close" domain="[('state', '=', 'close')]"/>
                <filter name="groupby_state" string="State" context="{'group_by': 'state'}"/>
                <filter name="groupby_container" string="Container" context="{'group_by': 'container_id'}"/>
            </search>
        </field>
    </record>
    <record id="stock_inventory_barcode_isbn_action" model="ir.actions.act_window">
        <field name="name">Stock inventory barcode ISBN</field>
        <field name="res_model">stock.inventory.barcode.isbn</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="stock_inventory_barcode_isbn_view_tree"/>
        <field name="search_view_id" ref="stock_inventory_barcode_isbn_view_search"/>
        <field name="context">{'default_filter_open': 1}</field>
    </record>
    <menuitem
        id="menu_stock_inventory_barcode_isbn"
        name="Inventory ISBN"
        parent="stock.menu_stock_warehouse_mgmt"
        action="stock_inventory_barcode_isbn_action"
        sequence="200"
    />
</odoo>
