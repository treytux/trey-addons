<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="contract_lite_supplier_line_tree" model="ir.ui.view">
        <field name="model">contract_lite_supplier.line</field>
        <field name="arch" type="xml">
            <tree>
                <field name="contract_id"/>
                <field name="product_id"/>
                <field name="automatic_price"/>
                <field name="price_unit" attrs="{'readonly':[('automatic_price','=',True)]}"/>
                <field name="quantity"/>
                <field name="uom_id"/>
                <field name="discount"/>
                <field name="price_subtotal" readonly="1"/>
                <field name="recurring_interval"/>
                <field name="recurring_rule_type"/>
                <field name="date_start"/>
                <field name="recurring_next_date"/>
                <field name="date_end"/>
                <field name="next_period_date_end" readonly="1"/>
                <field name="analytic_account_id"/>
            </tree>
        </field>
    </record>
    <record id="contract_lite_supplier_line_form" model="ir.ui.view">
        <field name="model">contract_lite_supplier.line</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="contract_id"/>
                            <field name="product_id"/>
                            <field name="automatic_price"/>
                            <field name="price_unit" attrs="{'readonly':[('automatic_price','=',True)]}"/>
                            <field name="quantity"/>
                            <field name="uom_id"/>
                            <field name="discount"/>
                            <field name="price_subtotal" readonly="1"/>
                        </group>
                        <group>
                            <field name="analytic_account_id"/>
                            <field name="date_start"/>
                            <field name="recurring_next_date"/>
                            <field name="date_end"/>
                            <field name="next_period_date_end" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="name"/>
                    </group>
                    <group string="Recurrence">
                        <field name="recurring_interval"/>
                        <field name="recurring_rule_type"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
