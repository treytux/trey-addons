#: model:mail.template,body_html:sale_cost_simulator.email_template_edi_sale_simulate_cost
msgid ""
"<div style=\"padding-top:16px; background:#F1F1F1; font-family:Verdana,Arial,sans-serif; color:#454748;\">\n"
"                    <table align=\"center\" width=\"590\" style=\"background:white; padding:24px;\">\n"
"                        <tr>\n"
"                            <td>\n"
"                                <span style=\"font-size:10px;\">Cost simulation</span><br>\n"
"                                <span style=\"font-size:20px; font-weight:bold;\" t-out=\"object.name or ''\">Simulation name</span>\n"
"                            </td>\n"
"                            <td align=\"right\">\n"
"                                <img t-attf-src=\"/logo.png?company={{ object.company_id.id }}\" style=\"height:48px;\" t-att-alt=\"object.company_id.name\">\n"
"                            </td>\n"
"                        </tr>\n"
"                        <tr><td colspan=\"2\"><hr style=\"margin:4px 0 32px;\"></td></tr>\n"
"                        <tr>\n"
"                            <td style=\"font-size:13px;\">\n"
"                                Hello,<br><br>\n"
"                                Here is your simulation:<br><br>\n"
"                                <div style=\"border-left:1px solid #8e0000; margin-left:20px; padding-left:10px;\">\n"
"                                    <strong>References</strong><br>\n"
"                                    Name: <t t-out=\"object.name or ''\"></t><br>\n"
"                                    Reference: <t t-out=\"object.ref or ''\"></t><br>\n"
"                                    <t t-if=\"object.line_ids\">\n"
"                                        <br>Lines:<br>\n"
"                                        <t t-foreach=\"object.line_ids\" t-as=\"line\">\n"
"                                              <t t-out=\"line.name or ''\"></t>  <t t-out=\"line.total_total or 0\"></t> €<br>\n"
"                                        </t>\n"
"                                    </t>\n"
"                                    <br>\n"
"                                    Total: <strong><t t-out=\"object.amount_total or 0\"></t> <t t-if=\"object.pricelist_id and object.pricelist_id.currency_id\"><t t-out=\"object.pricelist_id.currency_id.name\"></t></t></strong><br>\n"
"                                </div>\n"
"                                <br>\n"
"                                If you have any question, do not hesitate to contact us.<br>\n"
"                                Thank you for choosing <t t-out=\"object.company_id.name or 'us'\"></t>!<br><br>\n"
"                                <t t-out=\"user.signature or ''\"></t>\n"
"                            </td>\n"
"                        </tr>\n"
"                        <tr>\n"
"                            <td style=\"font-size:11px; text-align:center;\">\n"
"                                <hr style=\"margin:16px 0 4px;\">\n"
"                                <b t-out=\"object.company_id.name or ''\">My company</b><br>\n"
"                                <span style=\"color:#999;\">\n"
"                                    <t t-if=\"object.company_id.street\"><t t-out=\"object.company_id.street\"></t>, </t>\n"
"                                    <t t-if=\"object.company_id.street2\"><t t-out=\"object.company_id.street2\"></t>, </t>\n"
"                                    <t t-if=\"object.company_id.city or object.company_id.zip\"><t t-out=\"object.company_id.zip or ''\"></t> <t t-out=\"object.company_id.city or ''\"></t>, </t>\n"
"                                    <t t-if=\"object.company_id.country_id\"><t t-out=\"object.company_id.country_id.name\"></t></t><br>\n"
"                                    <t t-if=\"object.company_id.phone\"> Phone: <t t-out=\"object.company_id.phone\"></t> </t>\n"
"                                    <t t-if=\"object.company_id.website\"> | Web: <a t-attf-href=\"{{ object.company_id.website }}\" style=\"color:#999;\" t-out=\"object.company_id.website\"></a></t>\n"
"                                </span>\n"
"                            </td>\n"
"                        </tr>\n"
"                    </table>\n"
"                    <div style=\"text-align:center;\">Powered by <a href=\"https://www.odoo.com\" style=\"color:#875A7B;\">Odoo</a></div>\n"
