<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="report_sale_cost_simulation_duplicate" model="ir.actions.report">
            <field name="name">Quotation</field>
            <field name="model">sale.cost.simulator</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">sale_cost_simulator.report_simulation</field>
            <field name="report_file">quotation</field>
            <field name="binding_model_id" ref="model_sale_cost_simulator"/>
            <field name="binding_type">report</field>
        </record>
        <template id="report_simulation_document_header">
            <div class="row">
                <div class="col-8">
                    <h2 class="report-title">
                        <span>Quotation</span>
                        <span t-field="o.name"/>
                    </h2>
                </div>
            </div>
            <div class="row">
                <div class="col-8">
                    <p>
                        <t t-if="o.date"><span>Date</span>: <span t-field="o.date"
                                t-options='{"widget":"date"}'/></t>
                        <t t-if="o.partner_id"><br/><span>Partner number</span>: <span
                                t-field="o.partner_id.id"/></t>
                    </p>
                </div>
                <div class="col-4">
                    <p>
                        <t t-if="o.partner_id.name">
                            <strong t-field="o.partner_id.name"/>
                        </t>
                        <t t-if="o.partner_id.street">
                            <br/>
                            <span t-field="o.partner_id.street"/>
                        </t>
                        <t t-if="o.partner_id.street2">
                            <br/>
                            <span t-field="o.partner_id.street2"/>
                        </t>
                        <t t-if="o.partner_id.zip or o.partner_id.city">
                            <br/>
                            <t t-if="o.partner_id.zip">
                                <span t-field="o.partner_id.zip"/>
                            </t>
                            <t t-if="o.partner_id.city">, <span t-field="o.partner_id.city"/></t>
                            <t t-if="o.partner_id.state_id">(<span
                                    t-field="o.partner_id.state_id.name"/>)</t>
                        </t>
                        <br/>
                        <t t-if="o.partner_id.vat"><br/><br/><span>VAT</span>: <span
                                t-field="o.partner_id.vat"/></t>
                    </p>
                </div>
            </div>
            <div class="row">
                <div class="col-12">
                    <h3>
                        <t t-if="o.name">
                            <span t-field="o.name"/>
                        </t>
                    </h3>
                </div>
            </div>
        </template>
        <template id="report_simulation_document_line">
            <t t-if="l.child_ids">
                <t t-call="sale_cost_simulator.cost_line_header"/>
                <t t-foreach="l.child_ids" t-as="l">
                    <t t-if="l.child_ids">
                        <t t-set="childs_1" t-value="l.child_ids"/>
                        <t t-call="sale_cost_simulator.cost_line_header"/>
                        <t t-foreach="childs_1" t-as="l">
                            <t t-call="sale_cost_simulator.cost_line"/>
                        </t>
                    </t>
                    <tr>
                        <td></td>
                        <td></td>
                        <td colspan="2">
                            <div class="text-right">
                                <span>Total</span>
                                <span t-esc="l.parent_id.name"/>
                            </div>
                        </td>
                        <td class="text-start">
                            <small t-field="l.total_total"
                                t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/>
                        </td>
                    </tr>
                </t>
            </t>
        </template>
        <template id="cost_line_header">
            <tr t-att-class="'level-%s' % l.level">
                <td style="padding-left: 40px;">
                    <strong>
                        <t t-if="l.level == 1">
                            <span t-field="l.name"/>
                        </t>
                        <t t-if="l.level == 2">
                            <small t-field="l.name"/>
                        </t>
                    </strong>
                </td>
                <td class="text-right"></td>
                <td t-if="valued == 1" class="text-right"></td>
                <td t-if="valued == 1" class="text-right"></td>
                <td t-if="valued == 1" class="text-right"></td>
            </tr>
        </template>
        <template id="cost_line">
            <tr>
                <td style="padding-left: 40px;">
                    <small t-field="l.name"/>
                    <small t-field="l.level"/>
                </td>
                <td class="text-right">
                    <small t-field="l.quantity"/>
                </td>
                <td t-if="valued == 1" class="text-right">
                    <t t-if="show_valued_line">
                        <small t-field="l.price_unit"/>
                    </t>
                </td>
                <td t-if="valued == 1" class="text-right">
                    <t t-if="show_valued_line">
                        <small t-field="l.discount"/>
                    </t>
                </td>
                <td t-if="valued == 1" class="text-right">
                    <t t-if="show_valued_line">
                        <small t-field="l.amount_total"
                            t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/>
                    </t>
                </td>
            </tr>
        </template>
        <template id="report_simulation_document_line_totalize">
            <tr>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
                <td>
                    <table class="table table-condensed">
                        <t t-if="l.amount_discount">
                            <tr>
                                <td>Discount</td>
                                <td>
                                    <span t-field="l.amount_discount"
                                        t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/>
                                </td>
                            </tr>
                        </t>
                        <tr>
                            <td>Untaxed</td>
                            <td>
                                <span t-field="l.amount_untaxed"
                                    t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/>
                            </td>
                        </tr>
                        <tr>
                            <td>Tax</td>
                            <td>
                                <span t-field="l.amount_tax"
                                    t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/>
                            </td>
                        </tr>
                        <tr>
                            <td>Total</td>
                            <td>
                                <span t-field="l.parent_id.amount_total"
                                    t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </template>
        <template id="report_simulation_table">
            <div class="row">
                <div class="col-12">
                    <table class="table table-condensed">
                        <thead>
                            <tr>
                                <th style="width: 40%;">Description</th>
                                <th style="width: 15%;" class="text-right">Quantity</th>
                                <th t-if="valued == 1" style="width: 15%;" class="text-right">Amount</th>
                                <th t-if="valued == 1" style="width: 15%;" class="text-right">Discount
                                    (%)</th>
                                <th t-if="valued == 1" style="width: 15%;" class="text-right">
                                    Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="o.line_ids" t-as="l">
                                <t t-call="sale_cost_simulator.report_simulation_document_line"/>
                                <t
                                    t-call="sale_cost_simulator.report_simulation_document_line_totalize"/>
                            </t>
                        </tbody>
                    </table>
                </div>
            </div>
        </template>
        <template id="report_simulation_document_content">
            <t t-call="web.external_layout">
                <div class="page">
                    <t t-call="sale_cost_simulator.report_simulation_document_header"/>
                    <t t-call="sale_cost_simulator.report_simulation_table"/>
                </div>
            </t>
        </template>
        <template id="report_simulation_document">
            <t t-call="sale_cost_simulator.report_simulation_document_content">
                <t t-set="show_valued_line" t-value="1"/>
                <t t-set="valued" t-value="1"/>
                <t t-set="totalize_level" t-value="2"/>
                <t t-set="level_totalize" t-value="1"/>
            </t>
        </template>
        <template id="report_simulation">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="sale_cost_simulator.report_simulation_document"
                        t-lang="o.partner_id.lang"/>
                </t>
            </t>
        </template>
    </data>
</odoo>
