<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="sale_cost_line_tree" model="ir.ui.view">
        <field name="model">sale.cost.line</field>
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <tree string="Sale cost simulator line">
                <field name="simulator_id" invisible="1"/>
                <field name="name"/>
                <field name="total_untaxed" sum="Total untaxed"/>
                <field name="total_tax" sum="Total tax"/>
                <field name="total_total" sum="Grand total"/>
                <field name="state"/>
            </tree>
        </field>
    </record>
    <record id="sale_cost_line_list" model="ir.ui.view">
        <field name="model">sale.cost.line</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <tree string="Sale cost simulator line">
                <field name="simulator_id"/>
                <field name="display_name"/>
                <field name="state"/>
            </tree>
        </field>
    </record>
    <record id="sale_cost_line_list_in_form" model="ir.ui.view">
        <field name="model">sale.cost.line</field>
        <field name="priority">5</field>
        <field name="arch" type="xml">
            <tree string="Sale cost simulator line" decoration-info="childs_number &gt; 0">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="product_id"/>
                <field name="quantity"/>
                <field name="price_unit"/>
                <field name="total_untaxed"/>
                <field name="total_total"/>
                <field name="childs_number" invisible="1"/>
                <field name="state" invisible="1"/>
            </tree>
        </field>
    </record>
    <record id="sale_cost_line_search" model="ir.ui.view">
        <field name="model">sale.cost.line</field>
        <field name="arch" type="xml">
            <search string="Sale cost simulator line">
                <field name="name"/>
                <field name="simulator_id"/>
                <field name="parent_id"/>
                <field name="pricelist_id"/>
                <separator/>
                <filter string="Simulator" name="simulator" domain="[]"
                    context="{'group_by':'simulator_id'}"/>
                <filter string="Parent" name="parent" domain="[]" context="{'group_by':'parent_id'}"/>
                <filter string="Product" name="product" domain="[]"
                    context="{'group_by':'product_id'}"/>
                <filter string="Pricelist" name="pricelist" domain="[]"
                    context="{'group_by':'pricelist_id'}"/>
            </search>
        </field>
    </record>
    <record id="sale_cost_line_form" model="ir.ui.view">
        <field name="model">sale.cost.line</field>
        <field name="arch" type="xml">
            <form string="Sale cost simulator line">
                <header>
                    <field name="state" widget="statusbar"
                        statusbar_visible="draft,send,done"
                        readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                        <field name="state" invisible="1"/>
                        <field name="parent_id" placeholder="Parent"
                            domain="[('simulator_id.state', '=', 'draft'), ('simulator_id', '=', simulator_id)]"/>
                    </div>
                    <group>
                        <group>
                            <field name="uom_category_id" invisible="1"/>
                            <field name="product_id" default_focus="1"/>
                            <label for="quantity"/>
                            <div>
                                <field name="quantity" class="oe_inline"/>
                                <field name="uom_id" groups="uom.group_uom"
                                    class="oe_inline oe_no_button"/>
                            </div>
                            <field name="price_unit"/>
                            <field name="discount" groups="sale.group_discount_per_so_line"/>
                            <field name="tax_ids" widget="many2many_tags"
                                domain="[('type_tax_use', '!=', 'purchase')]"/>
                        </group>
                        <group>
                            <label for="description"/>
                            <field name="description" nolabel="1" placeholder="Description"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="lines" string="Lines">
                            <button name="%(action_sale_cost_import_line)d"
                                attrs="{'invisible' : [('state', '!=', 'draft')]}"
                                string="Import line" type="action"
                                context="{'default_simulator_id': simulator_id, 'default_parent_id': active_id}"/>
                            <button name="%(action_sale_cost_apply_pricelist)d"
                                attrs="{'invisible' : [('state', '!=', 'draft')]}"
                                string="Apply pricelist" type="action"
                                context="{'default_simulator_id': simulator_id, 'default_parent_id': active_id, 'default_pricelist_id': pricelist_id}"/>
                            <field name="child_ids"
                                nolabel="1"
                                context="{'default_parent_id': active_id, 'default_simulator_id': simulator_id, 'default_pricelist_id': pricelist_id}"/>
                            <group class="oe_subtotal_footer oe_right" colspan="2" name="total">
                                <field name="amount_discount"
                                    widget='monetary'
                                    options="{'currency_field': 'currency_id'}"/>
                                <field name="amount_untaxed"
                                    widget='monetary'
                                    options="{'currency_field': 'currency_id'}"/>
                                <field name="amount_tax"
                                    widget='monetary'
                                    options="{'currency_field': 'currency_id'}"/>
                                <div colspan="2" class="oe_subtotal_footer_separator oe_inline">
                                    <label for="amount_total"/>
                                    <field name="amount_total"
                                        nolabel="1" widget='monetary'
                                        options="{'currency_field': 'currency_id'}"/>
                                </div>
                                <div class="oe_separator" colspan="2"/>
                                <field name="total_untaxed"
                                    widget='monetary'
                                    options="{'currency_field': 'currency_id'}"/>
                                <field name="total_tax"
                                    widget='monetary'
                                    options="{'currency_field': 'currency_id'}"/>
                                <div colspan="2" class="oe_subtotal_footer_separator oe_inline">
                                    <label for="total_total"/>
                                    <field name="total_total"
                                        nolabel="1" widget='monetary'
                                        options="{'currency_field': 'currency_id'}"/>
                                </div>
                            </group>
                            <group class="oe_right">
                                <div style="padding-top:22vh">
                                    <button name="button_dummy"
                                        attrs="{'invisible' : [('state', '!=', 'draft')]}"
                                        string="Update" type="object" class="btn-primary"/>
                                </div>
                            </group>
                            <div class="oe_clear"/>
                        </page>
                        <page name="general" string="General information">
                            <group>
                                <group>
                                    <field name="simulator_id"/>
                                    <field name="partner_id"/>
                                    <field name="pricelist_id"/>
                                    <field name="company_id" readonly="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="sale_cost_line_tree_action" model="ir.actions.act_window">
        <field name="res_model">sale.cost.line</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="sale_cost_line_tree"/>
        <field name="domain">[('simulator_id', '=', active_id), ('parent_id', '=', False)]</field>
    </record>
    <record id="sale_cost_line_list_action" model="ir.actions.act_window">
        <field name="res_model">sale.cost.line</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="sale_cost_line_search"/>
        <field name="view_id" ref="sale_cost_line_list"/>
    </record>
</odoo>
