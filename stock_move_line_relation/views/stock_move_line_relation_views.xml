<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_move_line_relation_tree" model="ir.ui.view">
        <field name="model">stock.move.line.relation</field>
        <field name="arch" type="xml">
            <tree string="Stock move line relation">
                <field name="move_line_id"/>
                <field name="quantity"/>
                <field name="price_unit"/>
            </tree>
        </field>
    </record>
    <record id="view_stock_move_line_relation_search" model="ir.ui.view">
        <field name="model">stock.move.line.relation</field>
        <field name="arch" type="xml">
            <search string="Stock move line relation">
                <field name="move_line_id"/>
                <field name="quantity"/>
                <field name="price_unit"/>
            </search>
        </field>
    </record>
    <record id="view_stock_move_line_relation_form" model="ir.ui.view">
        <field name="model">stock.move.line.relation</field>
        <field name="arch" type="xml">
            <form string="Stock move line relation">
                <sheet string="Stock move line relation">
                    <group col="4" colspan="4">
                        <group col="4" colspan="4">
                            <field name="move_line_id"/>
                            <field name="quantity"/>
                            <field name="price_unit"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_stock_move_line_relation_action" model="ir.actions.act_window">
        <field name="name">Stock move line relation</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">stock.move.line.relation</field>
        <field name="view_type">form</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_stock_move_line_relation_search"/>
    </record>
</odoo>
