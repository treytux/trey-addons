<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mass_editing_product_category_group_analytic" model="mass.editing">
        <field name="name">Analytic group</field>
        <field name="action_name">Mass Operation (Analytic group)</field>
        <field name="model_id" ref="product.model_product_category"/>
    </record>
    <record id="mass_editing_product_category_group_analytic_line" model="mass.editing.line">
        <field name="mass_editing_id" ref="mass_editing_product_category_group_analytic"/>
        <field name="field_id" ref="account_analytic_group_for_product_categ.field_product_category__group_analytic_id"/>
    </record>
    <function model="mass.editing" name="enable_mass_operation">
        <value eval="[ref('mass_editing_product_category_group_analytic')]"/>
    </function>
</odoo>
