<?xml version="1.0" encoding="UTF-8"?>
<templates id="attachment_templates" xml:space="preserve">
    <t t-extend="portal.chatter_composer">
        <t t-jquery="form" t-operation="attributes">
            <attribute name="enctype">multipart/form-data</attribute>
        </t>
        <t t-jquery="button[type='submit']" t-operation="after">
            <button class="o_portal_chatter_attachment_btn btn btn-primary" type="button" title="Add attachment" style="margin-top:8px;">
                <i class="fa fa-paperclip"/>
            </button>
            <div class="d-none">
                <input type="file" class="o_portal_chatter_file_input" multiple="multiple"/>
            </div>
        </t>
        <t t-jquery="button[type='submit']" t-operation="before">
            <div class="o_portal_chatter_attachments mt-3"/>
        </t>
    </t>
    <t t-extend="portal.chatter_messages">
        <t t-jquery="div[class='o_portal_chatter_attachments']" t-operation="replace">
            <t t-call="portal.Chatter.Attachments">
                <t t-set="attachments" t-value="message.attachment_ids"/>
            </t>
        </t>
    </t>
    <t t-name="portal.Chatter.Attachments">
        <div t-if="attachments.length" class="row">
            <div t-foreach="attachments" t-as="attachment" class="col-lg-2 col-md-3 col-sm-6">
                <div class="o_portal_chatter_attachment mb-2 position-relative text-center" t-att-data-id="attachment.id">
                    <a t-attf-href="/web/content/#{ attachment.id }?download=true&amp;access_token=#{ attachment.access_token }" target="_blank">
                        <div class="oe_attachment_embedded o_image" t-att-title="attachment.name" t-att-data-mimetype="attachment.mimetype"/>
                        <div class="o_portal_chatter_attachment_name">
                            <t t-esc="attachment.name"/>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </t>
</templates>
