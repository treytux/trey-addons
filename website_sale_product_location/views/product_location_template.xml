<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="product_locations" name="Product Locations">
        <t t-call="website.layout">
            <t t-set="additional_title">Product Locations</t>
            <div id="wrap" t-attf-class="wrapper">
                <div class="container">
                    <div class="row">
                        <form action="/page/product-locations" class="form-horizontal mt32 col-lg-8" method="post">
                            <div class="input-group" style="margin-left: 60%;">
                                <div class="col-lg-6">
                                    <input type="text" name="search" class="form-control" placeholder="Search..." t-att-value="search"/>
                                </div>
                                <div class="col-lg-2">
                                    <button class="btn btn-primary">Search</button>
                                </div>
                            </div>
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        </form>
                    </div>
                    <br/>
                    <section>
                        <t t-if="product_locations">
                            <t t-set="parent_locations" t-value="product_locations.location_id"/>
                            <t t-foreach="parent_locations" t-as="parent">
                                <div class="row text-center mt-5">
                                    <h4 t-field="parent.name"/>
                                    <hr/>
                                    <t t-foreach="product_locations" t-as="o">
                                        <t t-if="o.location_id in parent">
                                            <div class="card border-0 col-lg-3 col-md-6 mb-4 text-center">
                                                <a t-att-href="keep('/shop/product-location',product_location = o.id)">
                                                    <div class="card-body border-0">
                                                        <span t-field="o.name"/>
                                                    </div>
                                                </a>
                                            </div>
                                        </t>
                                    </t>
                                </div>
                            </t>
                        </t>
                        <t t-if="not product_locations">
                            <div class="text-center text-muted">
                                <h3 class="css_editable_display">No product location found.</h3>
                            </div>
                        </t>
                    </section>
                </div>
            </div>
        </t>
    </template>
</odoo>
