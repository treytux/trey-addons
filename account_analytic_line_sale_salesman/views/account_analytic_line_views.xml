<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_analytic_line_tree_inherit_sale_salesman" model="ir.ui.view">
        <field name="model">account.analytic.line</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_line_tree"/>
        <field name="arch" type="xml">
            <field name="account_id" position="after">
                <field name="sale_user_id" optional="hide"/>
            </field>
        </field>
    </record>
    <record id="view_account_analytic_line_form_inherit_sale_salesman" model="ir.ui.view">
        <field name="model">account.analytic.line</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_line_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='account_id']" position="after">
                <field name="sale_user_id" readonly="1"/>
            </xpath>
        </field>
    </record>
    <record id="view_account_analytic_line_pivot_inherit_sale_salesman" model="ir.ui.view">
        <field name="model">account.analytic.line</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_line_pivot"/>
        <field name="arch" type="xml">
            <field name="account_id" position="after">
                <field name="sale_user_id" type="row"/>
            </field>
        </field>
    </record>
</odoo>
