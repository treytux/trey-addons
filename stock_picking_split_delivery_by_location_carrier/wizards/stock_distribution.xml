<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_picking_distribution_form" model="ir.ui.view">
        <field name="model">stock.distribution</field>
        <field name="inherit_id" ref="stock_picking_split_delivery_by_location.stock_picking_distribution_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='confirm_line_ids']//field[@name='quantity']" position="after">
                <field name="delivery_carrier_id"/>
            </xpath>
        </field>
    </record>
</odoo>
