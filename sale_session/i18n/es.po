#. module: sale_session
#: model:mail.template,body_html:sale_session.email_template_session_close
msgid ""
"\n"
"            \n"
"                <p>La sesión de venta  <t t-out=\"object.name\"></t> ha sido "
"cerrada. A continuación, se muestra la información de cierre:</p>\n"
"                <ul>\n"
"                    <li>Fecha de cierre: <t t-out=\"object.close_date\"></"
"t><t t-out=\"object.company_currency.symbol\"></t></li>\n"
"                    <li>Arqueo de cierre: <t t-"
"out=\"object.close_cash_count_total\"></t><t t-"
"out=\"object.company_currency.symbol\"></t></li>\n"
"                    <li>Diferencia de cierre: <t t-"
"out=\"object.close_cash_count_mismatch\"></t><t t-"
"out=\"object.company_currency.symbol\"></t></li>\n"
"                    <li>Importe enviado: <t t-out=\"object.amount_send\"></"
"t><t t-out=\"object.company_currency.symbol\"></t></li>\n"
"                    <li>Total: <t t-out=\"object.amount_send\"></t><t t-"
"out=\"object.company_currency.symbol\"></t></li>\n"
"                    <li>Cantidad de ventas: <t t-out=\"object.sale_count\"></"
"t></li>\n"
"                    <li>Cantidad de productos vendidos: <t t-"
"out=\"sum(object.sale_line_ids.mapped('product_uom_qty'))\"></t></li>\n"
"                </ul>\n"
"            \n"
"        "
msgstr ""
"\n"
"            \n"
"                <p>La sesión de venta  <t t-out=\"object.name\"/> ha sido "
"cerrada. A continuación, se muestra la información de cierre:</p>\n"
"                <ul>\n"
"                    <li>Fecha de cierre: <t t-out=\"object.close_date\"/><t "
"t-out=\"object.company_currency.symbol\"/></li>\n"
"                    <li>Arqueo de cierre: <t t-"
"out=\"object.close_cash_count_total\"/><t t-"
"out=\"object.company_currency.symbol\"/></li>\n"
"                    <li>Diferencia de cierre: <t t-"
"out=\"object.close_cash_count_mismatch\"/><t t-"
"out=\"object.company_currency.symbol\"/></li>\n"
"                    <li>Importe enviado: <t t-out=\"object.amount_send\"/><t "
"t-out=\"object.company_currency.symbol\"/></li>\n"
"                    <li>Total: <t t-out=\"object.amount_send\"/><t t-"
"out=\"object.company_currency.symbol\"/></li>\n"
"                    <li>Cantidad de ventas: <t t-out=\"object.sale_count\"/"
"></li>\n"
"                    <li>Cantidad de productos vendidos: <t t-"
"out=\"sum(object.sale_line_ids.mapped('product_uom_qty'))\"/></li>\n"
"                </ul>\n"
"            \n"
"        "

