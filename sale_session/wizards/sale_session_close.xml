<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_session_close_wizard" model="ir.ui.view">
        <field name="model">sale.session.close</field>
        <field name="arch" type="xml">
            <form string="Close session">
                <field name="company_currency" invisible="1"/>
                <div class="oe_title">
                    <h1><field name="session_id"/></h1>
                    <label for="team_id"/>
                    <field name="team_id"/>
                </div>
                <group>
                    <field name="journal_line_ids" nolabel="1">
                        <tree>
                            <field name="journal_id"/>
                            <field name="amount_total"/>
                        </tree>
                    </field>
                    <group class="oe_subtotal_footer oe_right" colspan="2">
                        <label for="balance_start"/>
                        <field name="balance_start" nolabel="1"/>
                        <label for="total_payment_cash"/>
                        <field name="total_payment_cash" nolabel="1"/>
                        <label for="total_cash" class="oe_subtotal_footer_separator"/>
                        <field name="total_cash" readonly="1" nolabel="1" class="oe_subtotal_footer_separator"/>
                        <label for="close_cash_count_mismatch"/>
                        <field name="close_cash_count_mismatch" readonly="1" nolabel="1"/>
                        <label for="close_cash_count_total" class="oe_subtotal_footer_separator"/>
                        <field name="close_cash_count_total" nolabel="1" class="oe_subtotal_footer_separator"/>
                        <field name="allow_amount_send" invisible="1"/>
                        <label for="amount_send" attrs="{'invisible':[('allow_amount_send', '!=', True)]}"/>
                        <field name="amount_send" nolabel="1" attrs="{'invisible':[('allow_amount_send', '!=', True)]}"/>
                    </group>
                </group>
                <footer>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="sale_session_close_action" model="ir.actions.act_window">
        <field name="name">Close session</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sale.session.close</field>
        <field name="view_id" ref="sale_session_close_wizard"/>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
