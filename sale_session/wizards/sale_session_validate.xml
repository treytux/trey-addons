<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_session_validate_wizard" model="ir.ui.view">
        <field name="model">sale.session.validate</field>
        <field name="arch" type="xml">
            <form string="validate session">
                <field name="company_currency" invisible="1"/>
                <field name="allow_edit_amount_send" invisible="1"/>
                <div class="oe_title">
                    You are validating that you have received the amount of <strong> <field name="amount_send" attrs="{'readonly': [('allow_edit_amount_send', '!=', True)]}"/> </strong>for the sales session <field name="session_id"/>.
                </div>
                <group attrs="{'invisible': [('amount_send', '=', 0)]}">
                    <field name="journal_id" attrs="{'required': [('amount_send', '>', 0)]}"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="sale_session_validate_action" model="ir.actions.act_window">
        <field name="name">validate session</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sale.session.validate</field>
        <field name="view_type">form</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
