<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_quotation_form" model="ir.actions.act_window">
        <field name="name">New Quotation</field>
        <field name="res_model">sale.order</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_type">form</field>
        <field name="view_mode">form</field>
        <field name="context">{}</field>
    </record>
    <record id="sale_order_confirm_and_pay_wizard" model="ir.ui.view">
        <field name="model">sale.order.confirm_and_pay</field>
        <field name="arch" type="xml">
            <form string="Confirm and pay">
                <field name="step" invisible="1"/>
                <group attrs="{'invisible': [('step', '!=', 0)] }">
                    <field name="line_ids" nolabel="1">
                        <tree editable="bottom">
                            <field name="product_id"/>
                            <field name="quantity"/>
                            <field name="lot_id" required="1" domain="[('product_id', '=', product_id)]" context="{'default_product_id': product_id}"/>
                            <button name="action_split_line" icon="fa-list-alt" attrs="{'invisible': [('quantity', '&lt;', 2)] }"/>
                        </tree>
                    </field>
                </group>
                <group attrs="{'invisible': [('step', '!=', 1)] }">
                    <field name="payment_journal_ids" invisible="1"/>
                    <field name="sale_id" invisible="1"/>
                    <field name="show_print_invoice" invisible="1"/>
                    <field name="company_currency_id" invisible="1"/>
                    <field name="risk_exception" invisible="1"/>
                    <field name="need_change_amount" invisible="1"/>
                    <field name="avoid_credit_sale_session" invisible="1"/>
                    <group colspan="4">
                        <field name="partner_id" readonly="1"/>
                        <field name="journal_id" required="1"/>
                        <field name="amount_total" readonly="1" widget="monetary"/>
                    </group>
                    <group attrs="{'invisible': [('need_change_amount', '=', False)] }" colspan="4">
                        <field name="amount" required="1" widget="monetary" default_focus="1"/>
                        <field name="amount_change" readonly="1" widget="monetary" attrs="{'invisible': [('amount_change', '&lt;', 0)] }"/>
                    </group>
                </group>
                <group attrs="{'invisible': [('step', '!=', 2)] }">
                    <label for="amount_total"/>
                    <h3>
                        <field name="amount_total" readonly="1" widget="monetary"/>
                    </h3>
                    <field name="amount_change" readonly="1" widget="monetary"/>
                </group>
                <footer attrs="{'invisible': [('step', '!=', 0)] }">
                    <button name="action_lot_confirm" string="Continue" class="btn-primary" type="object"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
                <footer attrs="{'invisible': [('step', '!=', 1)] }">
                    <button name="action_confirm" string="Confirm order" class="btn-primary" type="object"/>
<!-- TODO: revise this! -->                    <button name="action_credit" string="Delivery of goods" class="btn-primary" type="object" disabled="1" attrs="{'invisible': ['|', ('risk_exception', '=', False), ('amount', '!=', 0)] }"/>
                    <button name="action_credit" string="Delivery of goods" class="btn-primary" type="object" attrs="{'invisible': ['|', ('risk_exception', '=', True), ('avoid_credit_sale_session', '=', True)] }"/>
                    <button name="action_pay" string="Delivery&amp;Pay" type="object" class="btn-primary" attrs="{'invisible': [('amount_change', '&lt;', 0), ('need_change_amount', '=', True)] }"/>
                    <button name="action_pay" string="Delivery&amp;Pay" type="object" class="btn-primary" disabled="1" attrs="{'invisible': ['|', ('amount_change', '&gt;=', 0), ('need_change_amount', '=', False)]}"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
                <footer attrs="{'invisible': [('step', '!=', 2)] }">
                    <button name="%(sale_session.action_quotation_form)d" string="New operation" class="btn-primary" type="action"/>
                    <button name="action_print_picking" string="Print picking" type="object"/>
                    <button name="action_print_invoice" string="Print invoice" type="object" attrs="{'invisible': [('show_print_invoice', '=', False)] }"/>
                    <button string="View" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="sale_order_confirm_and_pay_action" model="ir.actions.act_window">
        <field name="name">Confirm and pay</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sale.order.confirm_and_pay</field>
        <field name="view_type">form</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
