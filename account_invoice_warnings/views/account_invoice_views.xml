<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <field name="wrong_taxes" invisible="True"/>
                <field name="wrong_account" invisible="True"/>
                <field name="wrong_vat" invisible="True"/>
                <div class="alert alert-warning mb-0" role="alert" attrs="{'invisible' : [('wrong_taxes', '=', False)]}">
                    It seems that not all lines have taxes.
                </div>
                <div class="alert alert-warning mb-0" role="alert" attrs="{'invisible' : [('wrong_vat', '=', False)]}">
                    It seems partner's vat is missing.
                </div>
                <div class="alert alert-warning mb-0" role="alert" attrs="{'invisible' : [('wrong_account', '=', False)]}">
                    It seems that accounts in line are incorrect.
                </div>
            </xpath>
        </field>
    </record>
</odoo>
