#. module: account_invoice_warnings
#: model_terms:ir.ui.view,arch_db:account_invoice_warnings.invoice_form
#: model_terms:ir.ui.view,arch_db:account_invoice_warnings.invoice_supplier_form
msgid "<span class=\"alert alert-danger\" role=\"alert\">- It seems partner's vat is missing. Please fix it.</span>"
msgstr "<span class=\"alert alert-danger\" role=\"alert\">- Parece ser que falta el NIF del cliente/proveedor. Por favor, soluciónelo.</span>"

#. module: account_invoice_warnings
#: model_terms:ir.ui.view,arch_db:account_invoice_warnings.invoice_form
#: model_terms:ir.ui.view,arch_db:account_invoice_warnings.invoice_supplier_form
msgid "<span class=\"alert alert-danger\" role=\"alert\">- It seems that not all lines have taxes. Please fix it.</span>"
msgstr "<span class=\"alert alert-danger\" role=\"alert\">- Parece ser que no todas las líneas tienen impuestos. Por favor, soluciónelo.</span>"

#. module: account_invoice_warnings
#: model_terms:ir.ui.view,arch_db:account_invoice_warnings.invoice_form
#: model_terms:ir.ui.view,arch_db:account_invoice_warnings.invoice_supplier_form
msgid "<span class=\"alert alert-warning\" role=\"alert\">- It seems that accounts in line are incorrect. Please review it.</span>"
msgstr "<span class=\"alert alert-warning\" role=\"alert\">- Parece ser que las cuentas contables de las líneas son incorrectas. Por favor, revíselo.</span>"

