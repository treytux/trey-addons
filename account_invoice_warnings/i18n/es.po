#, fuzzy
#| msgid "It seems that accounts in line are incorrect. Please review it."
msgid "It seems that accounts in line are incorrect."
msgstr "Parece ser que las cuentas contables de las líneas son incorrectas."

#. module: account_invoice_warnings
#: model_terms:ir.ui.view,arch_db:account_invoice_warnings.view_move_form
msgid "It seems that not all lines have taxes."
msgstr "Parece que no todas las líneas tienen impuestos."

#. module: account_invoice_warnings
#: model:ir.model,name:account_invoice_warnings.model_account_move
msgid "Journal Entry"
msgstr "Asientos contables"

#. module: account_invoice_warnings
#: model:ir.model.fields,field_description:account_invoice_warnings.field_res_company__show_wrong_accounts
msgid "Show Wrong Accounts Warning"
msgstr "Mostrar el aviso de cuentas incorrectas"

#. module: account_invoice_warnings
#: model:ir.model.fields,field_description:account_invoice_warnings.field_res_company__show_wrong_taxes
msgid "Show Wrong Taxes Warning"
msgstr "Mostrar el aviso de impuestos incorrectos"

#. module: account_invoice_warnings
#: model:ir.model.fields,field_description:account_invoice_warnings.field_res_company__show_wrong_vat
msgid "Show Wrong VAT Warning"
msgstr "Mostrar el aviso de NIF incorrecto"

#. module: account_invoice_warnings
#: model:ir.model.fields,help:account_invoice_warnings.field_res_company__show_wrong_accounts
msgid ""
"When this setting is set, a warning is displayed on invoice form alerting "
"you that accounts in invoice are wrong."
msgstr ""
"Cuando este parámetro está definido, se mostrará un aviso en la factura "
"alertando que las cuentas de la factura son incorrectas."

#. module: account_invoice_warnings
#: model:ir.model.fields,help:account_invoice_warnings.field_res_company__show_wrong_vat
msgid ""
"When this setting is set, a warning is displayed on invoice form alerting "
"you that partner VAT is missing."
msgstr ""
"Cuando este parámetro está definido, se mostrará un aviso en la factura "
"alertando que falta el NIF del cliente/proveedor."

#. module: account_invoice_warnings
#: model:ir.model.fields,help:account_invoice_warnings.field_res_company__show_wrong_taxes
msgid ""
"When this setting is set, a warning is displayed on invoice form alerting "
"you that taxes in invoice are missing."
msgstr ""
"Cuando este parámetro está definido, se mostrará un aviso en la factura "
"alertando que falta impuestos en las facturas."

#. module: account_invoice_warnings
#: model:ir.model.fields,field_description:account_invoice_warnings.field_account_bank_statement_line__wrong_account
#: model:ir.model.fields,field_description:account_invoice_warnings.field_account_move__wrong_account
#: model:ir.model.fields,field_description:account_invoice_warnings.field_account_payment__wrong_account
msgid "Wrong Account"
msgstr "Cuenta incorrecta"

#. module: account_invoice_warnings
#: model:ir.model.fields,field_description:account_invoice_warnings.field_account_bank_statement_line__wrong_taxes
#: model:ir.model.fields,field_description:account_invoice_warnings.field_account_move__wrong_taxes
#: model:ir.model.fields,field_description:account_invoice_warnings.field_account_payment__wrong_taxes
msgid "Wrong Taxes"
msgstr "Impuestos incorrectos"

#. module: account_invoice_warnings
#: model:ir.model.fields,field_description:account_invoice_warnings.field_account_bank_statement_line__wrong_vat
#: model:ir.model.fields,field_description:account_invoice_warnings.field_account_move__wrong_vat
