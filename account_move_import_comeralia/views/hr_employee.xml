<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form" model="ir.ui.view">
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='identification_group']" position="after">
                <group string="Comeralia">
                    <field name="comeralia_name"/>
                    <field name="comeralia_account_id"/>
                    <field name="comeralia_account_advance_id"/>
                    <field name="comeralia_project_task_id"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
