<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="qc_use_date_form_view" model="ir.ui.view">
        <field name="model">qc.use.date</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="date"/>
                    <field name="user_id"/>
                    <field name="picking_id"/>
                    <field name="product_tmpl_id"/>
                    <field name="lot_id"/>
                </group>
            </form>
        </field>
    </record>
    <record id="qc_use_date_tree_view" model="ir.ui.view">
        <field name="model">qc.use.date</field>
        <field name="arch" type="xml">
            <tree>
                <field name="product_tmpl_id"/>
                <field name="picking_id"/>
                <field name="lot_id"/>
                <field name="date"/>
                <field name="user_id"/>
            </tree>
        </field>
    </record>
    <record id="qc_use_date_search_view" model="ir.ui.view">
        <field name="model">qc.use.date</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_tmpl_id"/>
                <field name="picking_id"/>
                <field name="lot_id"/>
                <field name="date"/>
                <field name="user_id"/>
            </search>
        </field>
    </record>
    <record id="qc_use_date_action" model="ir.actions.act_window">
        <field name="name">Use management</field>
        <field name="res_model">qc.use.date</field>
        <field name="view_type">form</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="qc_use_date_menu"
        name="Use management"
        parent="quality_control.qc_inspection_menu_parent"
        action="qc_use_date_action"
        sequence="10"/>
</odoo>
