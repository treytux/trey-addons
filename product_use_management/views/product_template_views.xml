<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view" model="ir.ui.view">
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='inventory']" position="after">
                <page string="Use management">
                    <group name="use_management">
                        <field name="use_management"/>
                        <field name="qc_test_ids" widget="many2many_tags"/>
                    </group>
                </page>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_product_qc_use_date" type="object" string="Use management" class="oe_stat_button" icon="fa-pencil-square-o"/>
            </xpath>
        </field>
    </record>
</odoo>
