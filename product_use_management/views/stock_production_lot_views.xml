<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_production_lot_form" model="ir.ui.view">
        <field name="model">stock.production.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ref']" position="after">
                <field name="use_management" invisible="1"/>
                <field name="number_of_uses" attrs="{'invisible': [('use_management', '=', False)]}"/>
                <field name="times_used" attrs="{'invisible': [('use_management', '=', False)]}"/>
                <field name="pending_uses" attrs="{'invisible': [('use_management', '=', False)]}"/>
            </xpath>
        </field>
    </record>
</odoo>
