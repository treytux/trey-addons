<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_hr_timesheet_sheet_filter" model="ir.ui.view">
        <field name="model">hr_timesheet.sheet</field>
        <field name="inherit_id" ref="hr_timesheet_sheet.view_hr_timesheet_sheet_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='to_review']" position="after">
                <filter name="validate" string="Approved" domain="[('state', '=', 'done')]"/>
            </xpath>
            <xpath expr="//filter[@name='groupby_reviewer']" position="after">
                <filter name="groupby_state"
                    string="State"
                    domain="[]"
                    context="{'group_by': 'state'}"/>
            </xpath>
        </field>
    </record>
</odoo>
