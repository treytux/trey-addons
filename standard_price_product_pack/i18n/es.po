#. module: standard_price_product_pack
#: selection:product.template,pack_component_cost:0
msgid "Detailed per component"
msgstr "Detallado por componente"

#. module: standard_price_product_pack
#: selection:product.template,pack_component_cost:0
msgid "Ignored components costs"
msgstr "Coste de los componentes ignorado"

#. module: standard_price_product_pack
#: model:ir.model.fields,help:standard_price_product_pack.field_product_product__pack_component_cost
#: model:ir.model.fields,help:standard_price_product_pack.field_product_template__pack_component_cost
msgid "On sale orders:\n"
"* Detailed per component: Detail lines with costs.\n"
"* Totalized in main product: Detail lines merging  lines costs on pack.\n"
"* Ignored: Use product pack cost (ignore detail line costs)."
msgstr "En pedidos de venta:\n"
"* Detallado por componente: Detalla las líneas con costes.\n"
"* Totalizado en el producto principal: Detalla las líneas mezclando sus "
"costes en el pack (no muestra los costes de los componentes).\n"
"* Ignorado: Se usa el coste el pack (los costes de las líneas son "
"ignorados)."

#. module: standard_price_product_pack
#: model:ir.model.fields,field_description:standard_price_product_pack.field_product_product__pack_component_cost
#: model:ir.model.fields,field_description:standard_price_product_pack.field_product_template__pack_component_cost
msgid "Pack component cost"
msgstr "Coste de los componentes"

