#. module: hr_timesheet_stats
#: model:mail.template,body_html:hr_timesheet_stats.email_template_hr_timesheet_stats
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        Dear ${object.name},\n"
"                        <br/>\n"
"                        <br/>\n"
"                        These are your last month stats...\n"
"                        <br/>\n"
"                        Days (working / holidays): ${object.get_month_working_days()} / ${object.get_month_holidays_days()}\n"
"                        <br/>\n"
"                        Tasks completed: ${object.total_works()}\n"
"                        <br/>\n"
"                        Hours (effective / real): <strong>${'%.2f' % object.total_unit_amount()}</strong> / <strong>${'%.2f' % object.total_real_hours()}</strong>\n"
"                        <br/>\n"
"                        Productivity (effective / real): <strong>${'%.2f' % object.get_productivity(object.total_unit_amount())}%</strong> / <strong>${'%.2f' % object.get_productivity(object.total_real_hours())}%</strong>\n"
"                        <br/>\n"
"                        <br/>\n"
"                        Best regards.\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""

