<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_provider_form" model="ir.ui.view">
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <xpath expr='//group[@name="provider_credentials"]' position='inside'>
                <group attrs="{'invisible': [('code', '!=', 'instore')]}">
                    <field name="instore_appconector_key" attrs="{'required': [('code', '=', 'instore')]}"/>
                    <field name="instore_url_base" attrs="{'required': [('code', '=', 'instore')]}"/>
                </group>
            </xpath>
            <xpath expr="//button[@name='action_toggle_is_published']" position="after">
                <button
                    name="test_instore_device" type="object" string="Test device" class="btn-primary"
                    attrs="{'invisible': [('code', '!=', 'instore')]}"/>
            </xpath>
        </field>
    </record>
</odoo>
