<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_helpdesk_team_form" model="ir.ui.view">
        <field name="model">helpdesk.ticket.team</field>
        <field name="inherit_id" ref="helpdesk_mgmt.view_helpdesk_team_form"/>
        <field name="arch" type="xml">
            <xpath expr="//label[@for='alias_name']" position="before">
                <field
                    name="alias_domain"
                    class="oe_inline"
                    string="Available email domains"
                    help="Available email domains for the selected company."
                />
            </xpath>
        </field>
    </record>
</odoo>
