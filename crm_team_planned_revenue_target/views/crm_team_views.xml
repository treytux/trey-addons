<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="crm_team_view_form" model="ir.ui.view">
        <field name="model">crm.team</field>
        <field name="inherit_id" ref="sales_team.crm_team_view_form"/>
        <field name="arch" type="xml">
            <field name="invoiced_target" position="after">
                <field name="use_planned_revenue"/>
                <field name="planned_revenue_target" attrs="{'invisible': [('use_planned_revenue', '=', False)]}"/>
            </field>
        </field>
    </record>
    <record id="crm_team_salesteams_view_kanban" model="ir.ui.view">
        <field name="model">crm.team</field>
        <field name="inherit_id" ref="sales_team.crm_team_salesteams_view_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//templates" position="before">
                <field name="use_planned_revenue"/>
                <field name="planned_revenue_target"/>
            </xpath>
            <xpath expr="//div[hasclass('bottom_block')]" position="inside">
                <t groups="sales_team.group_sale_manager">
                    <t t-if="record.use_planned_revenue.raw_value &amp;&amp; record.planned_revenue_target.raw_value" class="col-12 o_kanban_primary_bottom">
                        <field name="planned_revenue" widget="progressbar" title="Planned revenue"
                               options="{'current_value': 'planned_revenue', 'max_value': 'planned_revenue_target', 'editable': true, 'edit_max_value': true, 'on_change': 'update_planned_revenue_target'}"/>
                    </t>
                </t>
            </xpath>
        </field>
    </record>
</odoo>
