<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_tree_valuation_at_date" model="ir.ui.view">
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock_account.view_move_tree_valuation_at_date"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='value']" position="before">
                <field name="price_unit"/>
            </xpath>
            <xpath expr="//field[@name='value']" position="after">
                <field name="remaining_qty"/>
                <field name="remaining_value" sum="Stock remaining valuation"/>
            </xpath>
        </field>
    </record>
</odoo>
