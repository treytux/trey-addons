<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_task_form2" model="ir.ui.view">
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <field name="tag_ids" position="before">
                <field name="is_valuable" groups="project_task_voting.group_manager_vote"/>
            </field>
            <xpath expr="//notebook" position="inside">
                <page string="Voting" attrs="{'invisible': [('is_valuable', '!=', True)]}">
                    <field name="vote_ids">
                        <tree>
                            <field name="user_id"/>
                            <field name="vote_date"/>
                            <field name="vote" widget="priority"/>
                        </tree>
                    </field>
                    <group>
                        <field name="voting" groups="project_task_voting.group_manager_vote"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
