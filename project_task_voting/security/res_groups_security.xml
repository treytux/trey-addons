<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="project_task_vote_category" model="ir.module.category">
        <field name="name">Project task votes</field>
        <field name="sequence" eval="90"/>
    </record>
    <record id="group_user_vote" model="res.groups">
        <field name="name">User votes</field>
        <field name="category_id" ref="project_task_vote_category"/>
    </record>
    <record id="group_manager_vote" model="res.groups">
        <field name="name">Allow to manage all task votes</field>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="category_id" ref="project_task_vote_category"/>
        <field name="implied_ids" eval="[(4, ref('group_user_vote'))]"/>
    </record>
    <record id="rule_own_vote" model="ir.rule">
        <field name="name">Own votes</field>
        <field name="model_id" ref="project_task_voting.model_project_task_vote"/>
        <field name="domain_force">[('user_id','=',user.id)]</field>
        <field name="groups" eval="[(4, ref('project_task_voting.group_user_vote'))]"/>
    </record>
    <record id="rule_all_vote" model="ir.rule">
        <field name="name">All votes</field>
        <field name="model_id" ref="project_task_voting.model_project_task_vote"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('project_task_voting.group_manager_vote'))]"/>
    </record>
</odoo>
