<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="partner_website_link_category" model="ir.module.category">
        <field name="name">Website Links</field>
        <field name="description">Manage Website Links</field>
    </record>
    <record id="group_website_links_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="partner_website_link_category"/>
    </record>
    <record id="group_website_links_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="partner_website_link_category"/>
        <field name="implied_ids" eval="[(4, ref('group_website_links_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    <record id="rule_own_website_links_user" model="ir.rule">
        <field name="name">Own website links or public</field>
        <field name="model_id" ref="model_res_partner_website_link"/>
        <field name="domain_force">['|', ('create_uid','=',user.id), ('is_public', '=', True)]</field>
        <field name="groups" eval="[(4, ref('partner_website_links.group_website_links_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_own_website_links_manager" model="ir.rule">
        <field name="name">Manager can see all</field>
        <field name="model_id" ref="model_res_partner_website_link"/>
        <field name="domain_force">[]</field>
        <field name="groups" eval="[(4, ref('partner_website_links.group_website_links_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>
