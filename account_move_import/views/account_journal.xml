<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_journal_form" model="ir.ui.view">
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <field name="account_control_ids" position="after">
                <field name="import_account_moves"/>
            </field>
        </field>
    </record>
    <record id="account_journal_dashboard_kanban_view" model="ir.ui.view">
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.account_journal_dashboard_kanban_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='id']" position="after">
                <field name="import_account_moves"/>
            </xpath>
            <xpath expr="//t[@t-name='kanban-box']//div[hasclass('mt-auto')]" position="before">
                <t t-if="record.import_account_moves.raw_value == true">
                    <div class="row">
                        <div class="col-12 mt-2 mb-2">
                            <button type="action" name="%(account_move_import.account_move_import_file_action)d" class="btn btn-primary">
                                <span>Import Moves</span>
                            </button>
                        </div>
                    </div>
                </t>
            </xpath>
        </field>
    </record>
</odoo>
