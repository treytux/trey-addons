#. module: education_attendance
#: model:mail.template,body_html:education_attendance.student_attendance_email
msgid "\n"
"<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"padding-top: 16px; background-color: #F1F1F1; font-family:Verdana, Arial,sans-serif; color: #454748; width: 100%; border-collapse:separate;\">\n"
"    <tr>\n"
"        <td align=\"center\">\n"
"            <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"590\" style=\"padding: 16px; background-color: white; color: #454748; border-collapse:separate;\">\n"
"                <tbody>\n"
"                    <tr>\n"
"                        <td align=\"center\" style=\"min-width: 590px;\">\n"
"                            <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"590\" style=\"min-width: 590px; background-color: white; padding: 0px 8px 0px 8px; border-collapse:separate;\">\n"
"                                <tr><td valign=\"middle\">\n"
"                                    <span style=\"font-size: 10px;\"><strong>Attendance report of student ${ctx.get('student').name} in ${ctx.get('date').strftime('%B')}</strong></span><br/>\n"
"                                </td><td valign=\"middle\" align=\"right\">\n"
"                                    <img src=\"/logo.png\" style=\"padding: 0px; margin: 0px; height: auto; width: 80px;\" alt=\"${object.company_id.name}\"/>\n"
"                                </td></tr>\n"
"                                <tr><td colspan=\"2\" style=\"text-align:center;\">\n"
"                                  <hr width=\"100%\" style=\"background-color:rgb(204,204,204);border:medium none;clear:both;display:block;font-size:0px;min-height:1px;line-height:0; margin: 16px 0px 16px 0px;\"/>\n"
"                                </td></tr>\n"
"                            </table>\n"
"                        </td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td align=\"center\" style=\"min-width: 590px;\">\n"
"                            <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"590\" style=\"min-width: 590px; background-color: white; padding: 0px 8px 0px 8px; border-collapse:separate;\">\n"
"                                <tr><td valign=\"top\" style=\"font-size: 13px;\">\n"
"                                    <div>\n"
"                                        Dear <b>${object.name}</b><br/><br/>\n"
"                                        The month of ${ctx.get('date').strftime('%B')} has concluded, and we would like to inform you about ${ctx.get('student').name}'s attendance for this period. Here is a summary of the recorded absences:<br/>\n"
"                                        <h3>Absence List</h3>\n"
"                                        <ul>\n"
"                                        % for absence in ctx.get('absences', []):\n"
"                                            <li><b>Date:</b> ${format_tz(absence.date, tz='object.tz', format='%d-%m-%Y')} - <b>Class:</b> ${absence.training_plan_line_id.subject_id.name}</li>\n"
"                                        % endfor\n"
"                                        </ul>\n"
"                                        <br/>\n"
"                                        Please review this information and ensure that you are aware of your ward's absences.\n"
"                                        <br/><br/>\n"
"                                        If you have any questions or concerns regarding the absences or any other matters related to their education, please do not hesitate to contact us.\n"
"                                        <br/><br/>\n"
"                                        We appreciate your collaboration in maintaining an enriching and healthy educational environment for our students.\n"
"                                        <br/><br/>\n"
"                                        Thank you for trusting ${user.company_id.name|safe} with ${ctx.get('student').name}'s education!\n"
"                                        <br/><br/>\n"
"                                        Sincerely,\n"
"                                    </div>\n"
"                                </td></tr>\n"
"                                <tr><td style=\"text-align:center;\">\n"
"                                  <hr width=\"100%\" style=\"background-color:rgb(204,204,204);border:medium none;clear:both;display:block;font-size:0px;min-height:1px;line-height:0; margin: 16px 0px 16px 0px;\"/>\n"
"                                </td></tr>\n"
"                            </table>\n"
"                        </td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td align=\"center\" style=\"min-width: 590px;\">\n"
"                            <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"590\" style=\"min-width: 590px; background-color: white; font-size: 11px; padding: 0px 8px 0px 8px; border-collapse:separate;\">\n"
"                                <tr><td valign=\"middle\" align=\"left\">\n"
"                                    ${object.company_id.name}\n"
"                                </td></tr>\n"
"                                <tr><td valign=\"middle\" align=\"left\" style=\"opacity: 0.7;\">\n"
"                                    ${object.company_id.phone}\n"
"                                    % if object.company_id.email\n"
"                                        | <a href=\"'mailto:%s' % ${object.company_id.email}\" style=\"text-decoration:none; color: #454748;\">${object.company_id.email}</a>\n"
"                                    % endif\n"
"                                    % if object.company_id.website\n"
"                                        | <a href=\"'%s' % ${object.company_id.website}\" style=\"text-decoration:none; color: #454748;\">\n"
"                                        ${object.company_id.website}\n"
"                                    </a>\n"
"                                    % endif\n"
"                                </td></tr>\n"
"                            </table>\n"
"                        </td>\n"
"                    </tr>\n"
"                </tbody>\n"
"            </table>\n"
"        </td>\n"
"    </tr>\n"
"</table>\n"
"            "
msgstr "\n"
"<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"padding-top: 16px; background-color: #F1F1F1; font-family:Verdana, Arial,sans-serif; color: #454748; width: 100%; border-collapse:separate;\">\n"
"    <tr>\n"
"        <td align=\"center\">\n"
"            <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"590\" style=\"padding: 16px; background-color: white; color: #454748; border-collapse:separate;\">\n"
"                <tbody>\n"
"                    <tr>\n"
"                        <td align=\"center\" style=\"min-width: 590px;\">\n"
"                            <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"590\" style=\"min-width: 590px; background-color: white; padding: 0px 8px 0px 8px; border-collapse:separate;\">\n"
"                                <tr><td valign=\"middle\">\n"
"                                    <span style=\"font-size: 10px;\"><strong>Informe de asistencia del estudiante ${ctx.get('student').name} en ${ctx.get('date').strftime('%B')}</strong></span><br/>\n"
"                                </td><td valign=\"middle\" align=\"right\">\n"
"                                    <img src=\"/logo.png\" style=\"padding: 0px; margin: 0px; height: auto; width: 80px;\" alt=\"${object.company_id.name}\"/>\n"
"                                </td></tr>\n"
"                                <tr><td colspan=\"2\" style=\"text-align:center;\">\n"
"                                  <hr width=\"100%\" style=\"background-color:rgb(204,204,204);border:medium none;clear:both;display:block;font-size:0px;min-height:1px;line-height:0; margin: 16px 0px 16px 0px;\"/>\n"
"                                </td></tr>\n"
"                            </table>\n"
"                        </td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td align=\"center\" style=\"min-width: 590px;\">\n"
"                            <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"590\" style=\"min-width: 590px; background-color: white; padding: 0px 8px 0px 8px; border-collapse:separate;\">\n"
"                                <tr><td valign=\"top\" style=\"font-size: 13px;\">\n"
"                                    <div>\n"
"                                        Estimado/a <b>${object.name}</b><br/><br/>\n"
"                                        El mes de ${ctx.get('date').strftime('%B')} ha concluido y nos gustaría informarle sobre la asistencia de ${ctx.get('student').name} este periodo. A continuación se muestra un resumen de las ausencias registradas:br/>\n"
"                                        <h3>Listado de ausencias</h3>\n"
"                                        <ul>\n"
"                                        % for absence in ctx.get('absences', []):\n"
"                                            <li><b>Fecha:</b> ${format_tz(absence.date, tz='object.tz', format='%d-%m-%Y')} - <b>Clase:</b> ${absence.training_plan_line_id.subject_id.name}</li>\n"
"                                        % endfor\n"
"                                        </ul>\n"
"                                        <br/>\n"
"                                        Revise esta información y asegúrese de estar al tanto de las ausencias.\n"
"                                        <br/><br/>\n"
"                                        Si tiene alguna pregunta o inquietud con respecto a las ausencias o cualquier otro asunto relacionado con su educación, no dude en contactarnos.\n"
"                                        <br/><br/>\n"
"                                        Agradecemos su colaboración para mantener un ambiente educativo enriquecedor y saludable para nuestros estudiantes.\n"
"                                        <br/><br/>\n"
"                                        ¡Gracias por confiar en ${user.company_id.name|safe} con la educación de ${ctx.get('student').name}!\n"
"                                        <br/><br/>\n"
"                                        Atentamente,\n"
"                                    </div>\n"
"                                </td></tr>\n"
"                                <tr><td style=\"text-align:center;\">\n"
"                                  <hr width=\"100%\" style=\"background-color:rgb(204,204,204);border:medium none;clear:both;display:block;font-size:0px;min-height:1px;line-height:0; margin: 16px 0px 16px 0px;\"/>\n"
"                                </td></tr>\n"
"                            </table>\n"
"                        </td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td align=\"center\" style=\"min-width: 590px;\">\n"
"                            <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"590\" style=\"min-width: 590px; background-color: white; font-size: 11px; padding: 0px 8px 0px 8px; border-collapse:separate;\">\n"
"                                <tr><td valign=\"middle\" align=\"left\">\n"
"                                    ${object.company_id.name}\n"
"                                </td></tr>\n"
"                                <tr><td valign=\"middle\" align=\"left\" style=\"opacity: 0.7;\">\n"
"                                    ${object.company_id.phone}\n"
"                                    % if object.company_id.email\n"
"                                        | <a href=\"'mailto:%s' % ${object.company_id.email}\" style=\"text-decoration:none; color: #454748;\">${object.company_id.email}</a>\n"
"                                    % endif\n"
"                                    % if object.company_id.website\n"
"                                        | <a href=\"'%s' % ${object.company_id.website}\" style=\"text-decoration:none; color: #454748;\">\n"
"                                        ${object.company_id.website}\n"
"                                    </a>\n"
"                                    % endif\n"
"                                </td></tr>\n"
"                            </table>\n"
"                        </td>\n"
"                    </tr>\n"
"                </tbody>\n"
"            </table>\n"
"        </td>\n"
"    </tr>\n"
"</table>\n"
"            "

