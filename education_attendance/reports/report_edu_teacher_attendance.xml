<odoo>
    <report id="edu_teacher_attendance_report_create"
        string="Teacher Attendance Sheet Report"
        model="edu.wizard.teacher.attendance.report"
        report_type="qweb-pdf"
        file="education_attendance.wizard_teacher_attendance"
        name="education_attendance.wizard_teacher_attendance"/>
    <record id="edu_teacher_attendance_report_create" model="ir.actions.report">
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>
    <template id="edu_teacher_attendance_document">
        <t t-call="web.external_layout">
            <div class="page">
                <div class="row">
                    <div class="col-12">
                        <h3> Total Attendance Sheet Time Report </h3>
                        <br/>
                        <br/>
                        <table class="table table-condensed table-unstyled">
                            <tbody>
                                <tr>
                                    <td class="col-6"><h5><strong>Teacher:</strong><span t-field="o.teacher_id"/></h5></td>
                                </tr>
                                <tr>
                                    <td><h5><strong>Date Start:</strong><span t-field="o.date_start"/></h5></td>
                                    <td><h5><strong>Date End:</strong><span t-field="o.date_end"/></h5></td>
                                </tr>
                            </tbody>
                        </table>
                        <br/>
                        <table class="table">
                            <tbody>
                                <th>Date</th>
                                <th>Attendance Sheet</th>
                                <th>Substitution</th>
                                <th>Training Plan</th>
                                <th>Classroom</th>
                                <th>Subject</th>
                                <th>Duration</th>
                                <tr t-foreach="o.line_ids" t-as="l">
                                    <td><span t-field="l.date"/></td>
                                    <td><span t-field="l.attendance_sheet_id"/></td>
                                    <td>
                                        <t t-if="l.substitution">
                                            <input type="checkbox" checked="checked"/>
                                        </t>
                                        <t t-if="not l.substitution">
                                            <input type="checkbox"/>
                                        </t>
                                    </td>
                                    <td><span t-field="l.training_plan_id"/></td>
                                    <td><span t-field="l.classroom_id"/></td>
                                    <td><span t-field="l.subject_id"/></td>
                                    <td><span t-field="l.duration"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <br/>
                        <table class="table table-condensed table-unstyled">
                            <tbody>
                                <tr>
                                    <td class="col-6">
                                        <h5><strong>Total minutes:</strong><span t-field="o.total_minutes"/></h5>
                                    </td>
                                    <td>
                                        <h5><strong>Total hours:</strong><span t-field="o.total_hours"/></h5>
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <h5><strong>Total classes:</strong><span t-field="o.total_classes"/></h5>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </t>
    </template>
    <template id="wizard_teacher_attendance">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="education_attendance.edu_teacher_attendance_document" t-lang="o.env.user.sudo().lang"/>
            </t>
        </t>
    </template>
</odoo>
