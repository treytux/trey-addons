<odoo>
    <report id="edu_attendance_sheet_create"
        string="Attendance Sheet"
        model="edu.attendance.sheet"
        report_type="qweb-pdf"
        file="education_attendance.edu_attendance_sheet"
        name="education_attendance.edu_attendance_sheet"/>
    <record id="edu_attendance_sheet_create" model="ir.actions.report">
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>
    <template id="edu_attendance_sheet_document">
        <t t-call="web.external_layout">
            <div class="page">
                <div class="row">
                    <div class="col-12">
                        <table class="table table-condensed table-unstyled">
                            <tbody>
                                <tr>
                                    <td class="col-6">
                                        <h5><strong> Attendance Sheet: </strong><span t-field="o.name"/></h5>
                                    </td>
                                    <td class="col-6">
                                        <h5><strong> Date: </strong><span t-field="o.date"/></h5>
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <h5><strong> Teacher: </strong><span t-field="o.teacher_id"/></h5>
                                    </td>
                                    <t t-if="o.substitute_teacher_id">
                                        <td>
                                            <h5><strong> Substitute: </strong><span t-field="o.substitute_teacher_id"/></h5>
                                        </td>
                                    </t>
                                </tr>
                                <tr>
                                    <td class="col-6">
                                        <h5><strong> Trainin Plan Line: </strong><span t-field="o.training_plan_line_id.name"/></h5>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <br/>
                        <table class="table">
                            <tbody>
                                <th> Student </th>
                                <th> Present? </th>
                                <th> Comments </th>
                                <tr t-foreach="o.attendance_line_ids" t-as="al">
                                    <t t-if="al.student_id.name">
                                        <td class="col-6">
                                           <span t-field="al.student_id.name"/>
                                        </td>
                                        <td class="col-2">
                                            <t t-if="al.present">
                                                <input type="checkbox" checked="checked"/>
                                            </t>
                                            <t t-if="not al.present">
                                                <input type="checkbox"/>
                                            </t>
                                        </td>
                                        <td class="col-6">
                                            <span t-field="al.comments"/>
                                        </td>
                                    </t>
                                </tr>
                            </tbody>
                        </table>
                        <br/>
                    </div>
                </div>
            </div>
        </t>
    </template>
    <template id="edu_attendance_sheet">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="education_attendance.edu_attendance_sheet_document" t-lang="o.env.user.sudo().lang"/>
            </t>
        </t>
    </template>
</odoo>
