<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="hr_res_config_settings_view_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('app_settings_block') and @data-key='hr']" position="inside">
                <h2>Notifications</h2>
                <div class="row mt16 o_settings_container">
                    <div class="col-12 col-lg-6 o_setting_box" title="Send employee birthday notifications">
                        <div class="o_setting_left_pane">
                            <field name="employee_birthday_notification"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="employee_birthday_notification"/>
                            <div class="text-muted">
                                Send employee birthday notifications in general channel.
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
