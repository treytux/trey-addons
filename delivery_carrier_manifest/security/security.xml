<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="delivery_carrier_manifest_multi_company_rule" model="ir.rule">
        <field name="name">Delivery carrier manifest multi-company</field>
        <field name="model_id" ref="model_delivery_carrier_manifest"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'child_of', [user.company_id.id])]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_unlink" eval="True"/>
        <field name="perm_update" eval="True"/>
    </record>
</odoo>
