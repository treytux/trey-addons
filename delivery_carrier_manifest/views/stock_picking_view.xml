<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_internal_search" model="ir.ui.view">
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search"/>
        <field name="arch" type="xml">
            <filter name="activities_my" position="before">
                <separator/>
                    <filter string="Has no manifest"
                            name="no_manifest"
                            domain="[('manifest_id','=',False)]"/>
                    <filter string="Has carrier"
                            name="has_carrier"
                            domain="[('carrier_id','!=',False)]"/>
                    <filter string="Has no manifest and has carrier"
                            name="no_manifest_and_carrier"
                            domain="[('manifest_id','=',False), ('carrier_id','!=',False)]"/>
                    <filter string="Transfered today"
                            name="transfered_today"
                            domain="[('date_done', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
            </filter>
        </field>
    </record>
</odoo>
