<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_base_comment_template_form" model="ir.ui.view">
        <field name="model">base.comment.template</field>
        <field name="inherit_id" ref="base_comment_template.view_base_comment_template_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]" position="after">
                <group>
                    <group>
                        <field name="is_condition"/>
                    </group>
                </group>
            </xpath>
            <xpath expr="//field[@name='active']/.." position="attributes">
                <attribute name="attrs">{'invisible': [('is_condition', '=', True)]}</attribute>
            </xpath>
            <xpath expr="//page[@name='text']/.." position="attributes">
                <attribute name="attrs">{'invisible': [('is_condition', '=', True)]}</attribute>
            </xpath>
            <xpath expr="//page[@name='text']/.." position="after">
                <notebook attrs="{'invisible': [('is_condition', '=', False)]}">
                    <page name="text_condition" string="Terms and Conditions">
                        <field name="text"/>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
    <record id="view_base_comment_template_tree" model="ir.ui.view">
        <field name="model">base.comment.template</field>
        <field name="inherit_id" ref="base_comment_template.view_base_comment_template_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="is_condition"/>
            </field>
        </field>
    </record>
    <record id="view_base_comment_template_search" model="ir.ui.view">
        <field name="model">base.comment.template</field>
        <field name="inherit_id" ref="base_comment_template.view_base_comment_template_search"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <filter string="Is Terms and Conditions" name="is_condition" domain="[('is_condition','=',True)]"/>
            </field>
        </field>
    </record>
</odoo>
