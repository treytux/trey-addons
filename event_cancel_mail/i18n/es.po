#. module: event_cancel_mail
#: model:mail.template,body_html:event_cancel_mail.email_template_event_cancellation
msgid ""
"<div>\n"
"                    <p>Dear ${object.partner_id.name},</p>\n"
"                    <p>We regret to inform you that the event ${event_name} "
"has been canceled. We apologize for any inconvenience this may cause you.</"
"p>\n"
"                    <p>Sincerely,<br/>The organizing team</p>\n"
"                </div>\n"
"            "
msgstr ""
"<div>\n"
"                    <p>Estimado ${object.partner_id.name},</p>\n"
"                    <p>Lamentamos informarle que el evento ${event_name} ha "
"sido cancelado. Nos disculpamos por las molestias causadas.</p>\n"
"                    <p>Atentamente,<br/>El equipo organizador.</p>\n"
"                </div>\n"
"            "

