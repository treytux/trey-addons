<?xml version="1.0"?>
<odoo>
    <data noupdate="1">
        <record id="email_template_event_cancellation" model="mail.template">
            <field name="name">Event Cancellation Email</field>
            <field name="model_id" ref="event.model_event_registration"/>
            <field name="subject">Apology for Event Cancellation</field>
            <field name="email_to">${object.email or object.partner_id.email}</field>
            <field name="body_html" type="html">
                <div>
                    <p>Dear ${object.partner_id.name},</p>
                    <p>We regret to inform you that the event ${event_name} has been canceled. We apologize for any inconvenience this may cause you.</p>
                    <p>Sincerely,<br/>The organizing team</p>
                </div>
            </field>
        </record>
    </data>
</odoo>
