<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_event_form" model="ir.ui.view">
            <field name="model">event.event</field>
            <field name="inherit_id" ref="event.view_event_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form/header/button[@name='button_cancel'][1]" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//form/header/button[@name='button_cancel'][2]" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//form/header/button[@name='button_cancel'][2]" position="after">
                    <button string="Cancel Event" name="button_cancel_email" type="object" groups="base.group_user" attrs="{'invisible': [('state', 'not in', ['draft', 'confirm'])]}"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
