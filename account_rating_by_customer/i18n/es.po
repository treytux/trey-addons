#. module: account_rating_by_customer
#: model:mail.template,body_html:account_rating_by_customer.mail_template_invoice_survey
msgid ""
"<div>\n"
"                    % set access_token = object.rating_get_access_token()\n"
"                    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"590\" style=\"width:100%; margin:0px auto;\">\n"
"                        <tbody>\n"
"                            <tr>\n"
"                                <td valign=\"top\" style=\"font-size: 13px;\">\n"
"                                    Please take a moment to rate our services related to the invoice \"<strong>${object.number}</strong>\".\n"
"                                    <br/>\n"
"                                </td>\n"
"                            </tr>\n"
"                            <tr>\n"
"                                <td style=\"text-align: center;\">\n"
"                                    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"590\" summary=\"o_mail_notification\" style=\"width:100%; margin: 32px 0px 32px 0px;\">\n"
"                                        <tr>\n"
"                                            <td style=\"font-size: 13px;\">\n"
"                                                <strong>Tell us how you feel about our services</strong>\n"
"                                                <br/>\n"
"                                                <span style=\"text-color: #888888\">(click on one of these smileys)</span>\n"
"                                            </td>\n"
"                                        </tr>\n"
"                                        <tr>\n"
"                                            <td style=\"font-size: 13px;\">\n"
"                                                <table style=\"width:100%;text-align:center;\">\n"
"                                                    <tr>\n"
"                                                        <td>\n"
"                                                            <a href=\"/rating/${access_token}/10\">\n"
"                                                                <img alt=\"Satisfied\" src=\"/rating/static/src/img/rating_10.png\" title=\"Satisfied\"/>\n"
"                                                            </a>\n"
"                                                        </td>\n"
"                                                        <td>\n"
"                                                            <a href=\"/rating/${access_token}/5\">\n"
"                                                                <img alt=\"Not satisfied\" src=\"/rating/static/src/img/rating_5.png\" title=\"Not satisfied\"/>\n"
"                                                            </a>\n"
"                                                        </td>\n"
"                                                        <td>\n"
"                                                            <a href=\"/rating/${access_token}/1\">\n"
"                                                                <img alt=\"Highly Dissatisfied\" src=\"/rating/static/src/img/rating_1.png\" title=\"Highly Dissatisfied\"/>\n"
"                                                            </a>\n"
"                                                        </td>\n"
"                                                    </tr>\n"
"                                                </table>\n"
"                                            </td>\n"
"                                        </tr>\n"
"                                    </table>\n"
"                                </td>\n"
"                            </tr>\n"
"                        </tbody>\n"
"                    </table>\n"
"                </div>\n"
"            "
msgstr ""
"<div>\n"
"                    % set access_token = object.rating_get_access_token()\n"
"                    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"590\" style=\"width:100%; margin:0px auto;\">\n"
"                        <tbody>\n"
"                            <tr>\n"
"                                <td valign=\"top\" style=\"font-size: 13px;\">\n"
"                                    Agradeceríamos que se tomara un momento para calificar nuestros servicios relacionados con la factura \"<strong>${object.number}</strong>\".\n"
"                                    <br/>\n"
"                                </td>\n"
"                            </tr>\n"
"                            <tr>\n"
"                                <td style=\"text-align: center;\">\n"
"                                    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"590\" summary=\"o_mail_notification\" style=\"width:100%; margin: 32px 0px 32px 0px;\">\n"
"                                        <tr>\n"
"                                            <td style=\"font-size: 13px;\">\n"
"                                                <strong>Indíquenos qué opina sobre nuestros servicios</strong>\n"
"                                                <br/>\n"
"                                                <span style=\"text-color: #888888\">(haga clic en unos de estos emoticonos)</span>\n"
"                                            </td>\n"
"                                        </tr>\n"
"                                        <tr>\n"
"                                            <td style=\"font-size: 13px;\">\n"
"                                                <table style=\"width:100%;text-align:center;\">\n"
"                                                    <tr>\n"
"                                                        <td>\n"
"                                                            <a href=\"/rating/${access_token}/10\">\n"
"                                                                <img alt=\"Muy satisfecho\" src=\"/rating/static/src/img/rating_10.png\" title=\"Muy satisfecho\"/>\n"
"                                                            </a>\n"
"                                                        </td>\n"
"                                                        <td>\n"
"                                                            <a href=\"/rating/${access_token}/5\">\n"
"                                                                <img alt=\"Satisfecho\" src=\"/rating/static/src/img/rating_5.png\" title=\"Satisfecho\"/>\n"
"                                                            </a>\n"
"                                                        </td>\n"
"                                                        <td>\n"
"                                                            <a href=\"/rating/${access_token}/1\">\n"
"                                                                <img alt=\"Nada satisfecho\" src=\"/rating/static/src/img/rating_1.png\" title=\"Nada satisfecho\"/>\n"
"                                                            </a>\n"
"                                                        </td>\n"
"                                                    </tr>\n"
"                                                </table>\n"
"\t\n"
"                                            </td>\n"
"                                        </tr>\n"
"                                    </table>\n"
"                                </td>\n"
"                            </tr>\n"
"                        </tbody>\n"
"                    </table>\n"
"                </div>\n"
"            "

