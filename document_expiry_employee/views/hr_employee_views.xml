<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form" model="ir.ui.view">
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="groups_id" eval="[(4, ref('document_expiry.group_document_expiry_user'))]"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Documentation">
                    <field name="expiry_docs_ids" context="{'default_employee_id': active_id, 'default_owner_type': 'employee'}" nolabel="1">
                        <tree string="Documentation" editable="bottom" decoration-danger="color == 'red'" decoration-success="color == 'green'" decoration-muted="color == 'gray'" decoration-info="color == 'blue'" decoration-primary="color == 'purple'" decoration-warning="color == 'brown'">
                            <field name="owner_type" invisible="True"/>
                            <field name="employee_id" invisible="True"/>
                            <field name="document_type" required="True"/>
                            <field name="document_name" attrs="{'required': [('document_type', 'in', ['custom', 'attachment'])]}"/>
                            <field name="attachment_id" attrs="{'invisible': [('document_type', '!=', 'attachment')], 'required': [('document_type', '=', 'attachment')]}"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="color" invisible="True"/>
                            <field name="status_id" widget="label_selection"/>
                        </tree>
                    </field>
                </page>
            </notebook>
        </field>
    </record>
    <record id="hr.open_view_employee_list_my" model="ir.actions.act_window">
        <field name="res_model">hr.employee</field>
        <field name="context">{'default_owner_type': 'employee'}</field>
    </record>
</odoo>
