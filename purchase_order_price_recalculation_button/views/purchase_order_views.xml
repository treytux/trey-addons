<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form" model="ir.ui.view">
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_rfq_send']" position="after">
                <button name="button_recalculate_purchase_prices" class="ml-2 btn btn-default"
                        string="Recalculate prices" help="Apply the current pricelist"
                        type="object" attrs="{'invisible': [('state', 'not in', ['draft', 'sent'])]}"/>
            </xpath>
        </field>
    </record>
</odoo>
