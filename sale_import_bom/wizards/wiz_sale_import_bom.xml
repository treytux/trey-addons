<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="wiz_sale_import_bom_view_form" model="ir.ui.view">
        <field name="model">wiz.sale_import_bom</field>
        <field name="arch" type="xml">
            <form string="Add BoM">
                <group>
                    <field name="bom_id"/>
                    <field name="quantity"/>
                    <field name="only_import_products"/>
                </group>
                <footer>
                    <button name="button_add"
                            string="Accept"
                            type="object"
                            class="btn-primary"
                            data-hotkey="q"/>
                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"
                            data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
