<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_type_form" model="ir.ui.view">
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form"/>
        <field name="arch" type="xml">
            <xpath expr="/form/sheet/group[1]" position="inside">
                <group name="internal_transfers_barcodes_config">
                    <group colspan="2" attrs="{'invisible': [('code', '!=', 'internal')]}">
                        <field name="partner_internal_transfers"/>
                        <field name="validate_barcode_action"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
    <record id="stock_picking_type_kanban" model="ir.ui.view">
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.stock_picking_type_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('o_kanban_card_content')]" position="after">
                <div class="container o_kanban_card_content o_visible">
                    <div class="text-center" t-if="['internal'].indexOf(record.code.raw_value) > -1">
                        <button name="action_barcode_scan_internal_transfers" type="object"
                            class="text-center btn btn-success" string="Internal transfers with barcodes">
                            <span>Internal transfers with barcodes</span>
                        </button>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
