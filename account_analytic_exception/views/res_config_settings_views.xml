<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_res_config_settings_account_analytic_exception" model="ir.ui.view">
        <field name="name">res.config.settings.account.analytic.exception</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='invoicing_settings']" position="inside">
                <div class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane">
                        <field name="block_missing_analytic_invoices" />
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="block_missing_analytic_invoices" />
                        <div class="text-muted">
                            Block the validation of customer invoices
                            that have lines without analytic account/distribution.
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
