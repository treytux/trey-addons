<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_invite_template" model="mail.template">
        <field name="name">Email template invite</field>
        <field name="model_id" ref="mail_invite_template.model_mail_wizard_invite"/>
        <field name="subject">Add Followers</field>
        <field name="description">Sent to user to add as follower.</field>
        <field name="body_html" type="html">
            <div>
                <p>Hello,</p>
                <p><t t-esc="{{user.name}}"/> invited you to follow document: <b><t t-esc="{{ctx.get('record').name}}"/></b></p>
                <p>Regards</p>
            </div>
        </field>
    </record>
</odoo>
