<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_employee_form" model="ir.ui.view">
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="document_expiry_employee.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='document_name']" position="after">
                <field name="course_id"
                    groups="document_expiry.group_document_expiry_user"
                    modifiers="{&quot;invisible&quot;:
                        [[&quot;document_type&quot;, &quot;!=&quot;,
                        &quot;course&quot;]], &quot;required&quot;:
                        [[&quot;document_type&quot;, &quot;=&quot;,
                        &quot;course&quot;]]}"/>
            </xpath>
        </field>
    </record>
</odoo>
