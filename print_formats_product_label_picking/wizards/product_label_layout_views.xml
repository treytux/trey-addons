<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="product_label_layout_form_picking" model="ir.ui.view">
        <field name="model">product.label.layout</field>
        <field name="inherit_id" ref="stock.product_label_layout_form_picking"/>
        <field name="arch" type="xml">
            <xpath expr="//form/group" position="inside">
                <group colspan="2" attrs="{'invisible': [('picking_quantity', '!=', 'select_moves')]}">
                    <label for="select_move_ids" string="Operations" colspan="2"/>
                    <field name="select_move_ids" nolabel="1" colspan="2" options="{'no_create': True}">
                        <tree create="0" delete="1">
                            <field name="product_id"/>
                            <field name="move_line_id" force_save="1"/>
                            <field name="quantity" force_save="1"/>
                        </tree>
                    </field>
                </group>
                <group colspan="2" attrs="{'invisible': [('picking_quantity', '!=', 'select_move_lines')]}">
                    <label for="select_move_line_ids" string="Moves" colspan="2"/>
                    <field name="select_move_line_ids" nolabel="1" colspan="2" options="{'no_create': True}">
                        <tree create="0" delete="1">
                            <field name="product_id"/>
                            <field name="move_id" force_save="1"/>
                            <field name="quantity" force_save="1"/>
                        </tree>
                    </field>
                </group>
            </xpath>
            <xpath expr="//field[@name='custom_quantity']" position="attributes">
                <attribute name="attrs">{'invisible': [('picking_quantity', '!=', 'custom')]}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
