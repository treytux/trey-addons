<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_delivery_document" inherit_id="stock.report_delivery_document">
        <xpath expr="//table[@name='stock_move_table']/tbody" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//table[@name='stock_move_table']/tbody" position="after">
            <tbody>
                <t t-set="lines"
                   t-value="o._get_moves_sorted_by_sale_section(
                       o.move_ids.filtered(lambda x: x.product_uom_qty))"/>
                <t t-set="current_section" t-value="False"/>
                <t t-foreach="lines" t-as="move">
                    <t t-set="move_section_name"
                       t-value="o._get_move_sale_section_name(move=move)"/>
                    <t t-if="move_section_name and move_section_name != current_section">
                        <tr t-att-class="'bg-200 fw-bold o_line_section'">
                            <td colspan="99">
                                <span t-esc="move_section_name"/>
                            </td>
                        </tr>
                        <t t-set="current_section" t-value="move_section_name"/>
                    </t>
                    <tr>
                        <td>
                            <span t-field="move.product_id"/>
                            <p t-if="move.description_picking != move.product_id.name and move.description_picking != move.product_id.display_name">
                                <span t-field="move.description_picking"/>
                            </p>
                        </td>
                        <td>
                            <span t-field="move.product_uom_qty"/>
                            <span t-field="move.product_uom"/>
                        </td>
                        <td>
                            <span t-field="move.quantity_done"/>
                            <span t-field="move.product_uom"/>
                        </td>
                    </tr>
                </t>
            </tbody>
        </xpath>
        <xpath expr="//tbody/t[@t-if='o.has_packages']" position="before">
            <t t-set="move_lines_sorted" t-value="o._get_move_lines_sorted_by_sale_section()"/>
        </xpath>
        <xpath expr="//t[@t-if='has_serial_number']/tr[@t-foreach='package_move_lines']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//t[@t-if='has_serial_number']/tr[@t-foreach='package_move_lines']" position="after">
            <t t-set="current_section" t-value="False"/>
            <t t-foreach="package_move_lines" t-as="move_line">
                <t t-set="move_section_name"
                   t-value="o._get_move_sale_section_name(move_line=move_line)"/>
                <t t-if="move_section_name and move_section_name != current_section">
                    <tr t-att-class="'bg-200 fw-bold o_line_section'">
                        <td colspan="99">
                            <span t-esc="move_section_name"/>
                        </td>
                    </tr>
                    <t t-set="current_section" t-value="move_section_name"/>
                </t>
                <tr>
                    <t t-call="stock.stock_report_delivery_has_serial_move_line"/>
                </tr>
            </t>
        </xpath>
        <xpath expr="//t[@t-set='package_move_lines']" position="attributes">
            <attribute name="t-value">
                move_lines_sorted.filtered(lambda l: l.result_package_id == package)
            </attribute>
        </xpath>
        <xpath expr="//t[@t-set='move_lines']" position="attributes">
            <attribute name="t-value">
                move_lines_sorted.filtered(lambda l: not l.result_package_id)
            </attribute>
        </xpath>
        <xpath expr="//t[@name='no_package_move_lines']/t[@t-if='has_serial_number']/tr[@t-foreach='move_lines']"
               position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//t[@name='no_package_move_lines']/t[@t-if='has_serial_number']/tr[@t-foreach='move_lines']"
               position="after">
            <t t-set="current_section" t-value="False"/>
            <t t-foreach="move_lines" t-as="move_line">
                <t t-set="move_section_name"
                   t-value="o._get_move_sale_section_name(move_line=move_line)"/>
                <t t-if="move_section_name and move_section_name != current_section">
                    <tr t-att-class="'bg-200 fw-bold o_line_section'">
                        <td colspan="99">
                            <span t-esc="move_section_name"/>
                        </td>
                    </tr>
                    <t t-set="current_section" t-value="move_section_name"/>
                </t>
                <tr>
                    <t t-call="stock.stock_report_delivery_has_serial_move_line"/>
                </tr>
            </t>
        </xpath>
        <xpath expr="//t[@t-if='has_serial_number']/tr[@t-foreach='o.move_line_ids']"
               position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//t[@t-if='has_serial_number']/tr[@t-foreach='o.move_line_ids']"
               position="after">
            <t t-set="current_section" t-value="False"/>
            <t t-foreach="move_lines_sorted" t-as="move_line">
                <t t-set="move_section_name"
                   t-value="o._get_move_sale_section_name(move_line=move_line)"/>
                <t t-if="move_section_name and move_section_name != current_section">
                    <tr t-att-class="'bg-200 fw-bold o_line_section'">
                        <td colspan="99">
                            <span t-esc="move_section_name"/>
                        </td>
                    </tr>
                    <t t-set="current_section" t-value="move_section_name"/>
                </t>
                <tr>
                    <t t-call="stock.stock_report_delivery_has_serial_move_line"/>
                </tr>
            </t>
        </xpath>
    </template>
    <template id="stock_report_delivery_aggregated_move_lines"
              inherit_id="stock.stock_report_delivery_aggregated_move_lines">
        <xpath expr="//tr[@t-foreach='aggregated_lines']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//tr[@t-foreach='aggregated_lines']" position="after">
            <t t-set="current_section" t-value="False"/>
            <t t-set="aggregated_line_keys"
               t-value="o._get_aggregated_line_keys_sorted_by_sale_section(aggregated_lines)"/>
            <t t-foreach="aggregated_line_keys" t-as="line">
                <t t-set="move_section_name"
                   t-value="o._get_move_sale_section_name(
                       move=aggregated_lines[line]['move'])"/>
                <t t-if="move_section_name and move_section_name != current_section">
                    <tr t-att-class="'bg-200 fw-bold o_line_section'">
                        <td colspan="99">
                            <span t-esc="move_section_name"/>
                        </td>
                    </tr>
                    <t t-set="current_section" t-value="move_section_name"/>
                </t>
                <tr>
                    <td>
                        <span t-esc="aggregated_lines[line]['name']"/>
                        <p t-if="aggregated_lines[line]['description']">
                            <span t-esc="aggregated_lines[line]['description']"
                                  t-options="{'widget': 'text'}"/>
                        </p>
                    </td>
                    <td class="text-center" name="move_line_aggregated_qty_ordered">
                        <span t-esc="aggregated_lines[line]['qty_ordered']"
                              t-options="{
                                  'widget': 'float',
                                  'decimal_precision':
                                  'Product Unit of Measure'
                              }"/>
                        <span t-esc="aggregated_lines[line]['product_uom'].name"/>
                    </td>
                    <td class="text-center" name="move_line_aggregated_qty_done">
                        <t t-if="aggregated_lines[line]['qty_done']">
                            <span t-esc="aggregated_lines[line]['qty_done']"
                                  t-options="{
                                      'widget': 'float',
                                      'decimal_precision':
                                      'Product Unit of Measure'
                                  }"/>
                            <span t-esc="aggregated_lines[line]['product_uom'].name"/>
                        </t>
                    </td>
                </tr>
            </t>
        </xpath>
    </template>
</odoo>
