<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_tax_fee_line_form_view" model="ir.ui.view">
        <field name="model">sale.tax.fee.line</field>
        <field name="name">Tax fee lines</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title oe_left">
                        <h1>
                            <field name="sale_line_id" placeholder="Name"/>
                        </h1>
                    </div>
                    <group>
                        <group name="general_info">
                            <field name="sale_id"/>
                            <field name="sale_line_id"/>
                            <field name="product_id"/>
                            <field name="partner_id"/>
                            <field name="tax_fee_id"/>
                            <field name="tax_fee_amount" widget="monetary"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record model="ir.ui.view" id="sale_tax_fee_line_tree_view">
        <field name="name">Tax fee lines</field>
        <field name="model">sale.tax.fee.line</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sale_id"/>
                <field name="sale_line_id"/>
                <field name="product_id"/>
                <field name="partner_id"/>
                <field name="tax_fee_id"/>
                <field name="tax_fee_amount" widget="monetary"/>
                <field name="state"/>
            </tree>
        </field>
    </record>
    <record model="ir.ui.view" id="sale_tax_fee_line_search_view">
        <field name="model">sale.tax.fee.line</field>
        <field name="arch" type="xml">
            <search string="Tax fees">
                <field name="sale_id"/>
                <field name="sale_line_id"/>
                <field name="product_id"/>
                <field name="partner_id"/>
                <field name="tax_fee_id"/>
            </search>
        </field>
    </record>
    <record id="action_sale_tax_fee_line" model="ir.actions.act_window">
        <field name="name">Tax fee lines</field>
        <field name="res_model">sale.tax.fee.line</field>
        <field name="view_type">form</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="sale_tax_fee_line_tree_view"/>
        <field name="target">current</field>
    </record>
    <menuitem
        id="sale_tax_fee_line_menu"
        name="Sale tax fees"
        parent="sale.sale_order_menu"
        action="action_sale_tax_fee_line"
        sequence="90"/>
</odoo>
