<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="connector_simulator_purchase_view_form" model="ir.ui.view">
        <field name="model">connector.simulator.purchase</field>
        <field name="inherit_id" ref="purchase_provider_base.connector_simulator_purchase_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='simulator_info']" position="inside">
                <field name="simulate_order_date_comafe" attrs="{'invisible': [('supplier_mode', '!=', 'comafe')], 'readonly': [('state', 'in', ['step_2', 'step_done'])]}"/>
            </xpath>
        </field>
    </record>
    <record id="connector_simulator_purchase_line_tree_view" model="ir.ui.view">
        <field name="model">connector.simulator.purchase.line</field>
        <field name="inherit_id" ref="purchase_provider_base.connector_simulator_purchase_line_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='discount']" position="after">
                <field name="msg_comafe" readonly="True" attrs="{'column_invisible': [('parent.supplier_mode', '!=', 'comafe')]}"/>
            </xpath>
            <xpath expr="//field[@name='price_unit']" position="after">
                <field name="price_unit_comafe" string="Cost Comafe" readonly="True" attrs="{'column_invisible': [('parent.supplier_mode', '!=', 'comafe')]}"/>
            </xpath>
            <xpath expr="//field[@name='product_qty']" position="after">
                <field name="multiple_qty_comafe" string="Qty available Comafe" readonly="True" attrs="{'column_invisible': [('parent.supplier_mode', '!=', 'comafe')]}"/>
                <field name="price_updated_comafe" attrs="{'column_invisible': [('parent.supplier_mode', '!=', 'comafe')]}"/>
                <field name="price_fetch_error_comafe" invisible="True"/>
            </xpath>
        </field>
    </record>
</odoo>
