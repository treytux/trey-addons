#. module: project_block_task
#: model:ir.model.fields,field_description:project_block_task.field_project_project__block_timesheet
msgid "Block timesheets"
msgstr "Bloquear partes de horas"

#. module: project_block_task
#: model:ir.model.fields,help:project_block_task.field_project_project__block_timesheet
msgid ""
"If enabled, timesheets cannot be registered on this project or on any of its "
"tasks."
msgstr ""
"Si se activa, no se podrán registrar partes de horas en este proyecto ni en "
"ninguna de sus tareas."

#. module: project_block_task
#: model:ir.model.fields,field_description:project_block_task.field_project_task__timesheet_blocked
msgid "Timesheet registration blocked"
msgstr "Registro de partes de horas bloqueado"

#. module: project_block_task
#: model:ir.model.fields,help:project_block_task.field_project_task__timesheet_blocked
msgid ""
"Timesheets cannot be added or edited when the task is blocked or its project "
"blocks timesheet registration."
msgstr ""
"No se pueden añadir ni editar partes de horas cuando la tarea está bloqueada "
"o su proyecto bloquea el registro de partes de horas."

#. module: project_block_task
#: code:addons/project_block_task/models/account_analytic_line.py:0
#, python-format
msgid ""
"You cannot register or modify timesheets on task \"%s\": it is blocked or its "
"project blocks timesheet registration."
msgstr ""
"No puede registrar ni modificar partes de horas en la tarea \"%s\": está "
"bloqueada o su proyecto bloquea el registro de partes de horas."

#. module: project_block_task
