<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="edit_project" model="ir.ui.view">
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_time_managment']" position="inside">
                <div class="o_setting_box" id="block_timesheet_settings" colspan="2">
                    <div class="o_setting_left_pane">
                        <field name="block_timesheet"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="block_timesheet"/>
                        <div class="text-muted">
                            Prevent registering timesheets on this project and its tasks
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
