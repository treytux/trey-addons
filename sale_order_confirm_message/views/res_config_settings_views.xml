<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='sale_config_online_confirmation_sign']" position="after">
                <div class="col-12 col-lg-6 o_setting_box" id="sale_order_confirm_message">
                    <div class="o_setting_left_pane">
                        <field name="sale_confirm_message_active"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="sale_confirm_message_active"/>
                        <div class="text-muted">
                            Show a review dialog with the key quotation data before confirming it
                        </div>
                        <div class="content-group" attrs="{'invisible': [('sale_confirm_message_active', '=', False)]}">
                            <div class="mt16">
                                <field name="sale_confirm_message_require_check" class="oe_inline"/>
                                <label for="sale_confirm_message_require_check"/>
                            </div>
                            <div class="mt16">
                                <label for="sale_confirm_message_body" string="Message"/>
                                <field name="sale_confirm_message_body" placeholder="Please check the important information..."/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
