#: model:ir.model.fields,field_description:sale_order_confirm_message.field_sale_order_confirm_message__message
#, python-format
msgid ""
"Please check the important information against the document signed by the "
"customer. Once confirmed, the following data cannot be modified:"
msgstr ""
"Por favor, coteje la información importante con la firmada por el cliente, ya "
"que, una vez confirmado, no se podrán modificar los siguientes datos:"

#. module: sale_order_confirm_message
#: code:addons/sale_order_confirm_message/models/sale_order.py:0
#, python-format
msgid ""
"Confirm quotations one by one so their data can be reviewed against the "
"customer-signed document."
msgstr ""
"Confirme los presupuestos de uno en uno para poder cotejar sus datos con el "
"documento firmado por el cliente."

#. module: sale_order_confirm_message
#: code:addons/sale_order_confirm_message/wizards/sale_order_confirm_message.py:0
#, python-format
msgid ""
"Please confirm that you have checked the information against the document "
"signed by the customer before confirming the quotation."
msgstr ""
"Confirme que ha cotejado la información con el documento firmado por el "
"cliente antes de confirmar el presupuesto."

