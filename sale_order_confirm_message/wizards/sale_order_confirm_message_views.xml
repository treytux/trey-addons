<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="sale_order_confirm_message_form" model="ir.ui.view">
        <field name="model">sale.order.confirm.message</field>
        <field name="arch" type="xml">
            <form string="Confirm quotation">
                <field name="order_id" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <field name="require_check" invisible="1"/>
                <div class="alert alert-danger" role="alert">
                    <field name="message" nolabel="1" readonly="1"/>
                    <field name="locked_fields_html" nolabel="1" readonly="1"/>
                </div>
                <group>
                    <group string="Addresses">
                        <field name="partner_id"/>
                        <field name="partner_shipping_id"/>
                        <field name="partner_invoice_id"/>
                    </group>
                    <group string="Payment / Delivery">
                        <field name="payment_term_id"/>
                        <field name="payment_mode_id"/>
                        <field name="incoterm"/>
                    </group>
                </group>
                <separator string="Order lines"/>
                <field name="line_ids" nolabel="1">
                    <tree create="false" delete="false" edit="false">
                        <field name="product_id"/>
                        <field name="name"/>
                        <field name="product_uom_qty"/>
                        <field name="price_unit"/>
                        <field name="tax_id" widget="many2many_tags"/>
                        <field name="discount"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="price_subtotal" widget="monetary"/>
                    </tree>
                </field>
                <group class="oe_subtotal_footer">
                    <field name="amount_untaxed" widget="monetary"/>
                    <field name="amount_tax" widget="monetary"/>
                    <field name="amount_total" class="oe_subtotal_footer_separator" widget="monetary"/>
                </group>
                <group>
                    <field name="checked" attrs="{'invisible': [('require_check', '=', False)], 'required': [('require_check', '=', True)]}"/>
                </group>
                <footer>
                    <button name="action_confirm_order" type="object" string="Confirm" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
