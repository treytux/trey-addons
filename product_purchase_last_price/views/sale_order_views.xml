<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/tree//field[@name='price_unit']"
                position="after">
                <field name="purchase_last_price" optional="show"
                    groups="product_purchase_last_price.group_edit_purchase_last_price_in_sale"/>
                <field name="purchase_last_price" readonly="1"
                    optional="show"
                    groups="!product_purchase_last_price.group_edit_purchase_last_price_in_sale"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/form//field[@name='price_unit']"
                position="after">
                <field name="purchase_last_price" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
