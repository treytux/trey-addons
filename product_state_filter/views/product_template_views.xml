<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_search_form_view" model="ir.ui.view">
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='inactive']" position="after">
                <filter string="Hide Obsolete" name="is_obsolete"
                        domain="[('state', '!=', 'obsolete')]"/>
                <filter string="Hide In Development" name="is_draft"
                        domain="[('state', '!=', 'draft')]"/>
                <filter string="Hide End of Licecycle" name="is_end"
                        domain="[('state', '!=', 'end')]"/>
                <filter string="Hide Normal" name="is_sellable"
                        domain="[('state', '!=', 'sellable')]"/>
            </xpath>
        </field>
    </record>
</odoo>
