<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="rental_base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@data-key='rental_base']//div[hasclass('o_settings_container')]" position="inside">
                <div class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane"><field name="rental_allow_products" /></div>
                    <div class="o_setting_right_pane">
                        <label for="rental_allow_products" />
                        <div class="text-muted">Allow ordinary sale products on rental orders.</div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
