<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_rental_picking_type_out" model="ir.actions.act_window">
        <field name="name">Outgoing deliveries</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">tree,kanban,form,calendar</field>
        <field name="domain">[('sale_id.is_rental_order', '=', True)]</field>
        <field name="context" eval="{'search_default_picking_type_id': [ref('stock.picking_type_out')], 'default_picking_type_id': ref('stock.picking_type_out'), 'contact_display': 'partner_address'}" />
        <field name="search_view_id" ref="stock.view_picking_internal_search" />
    </record>
    <record id="action_rental_picking_type_in" model="ir.actions.act_window">
        <field name="name">Incoming deliveries</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">tree,kanban,form,calendar</field>
        <field name="domain">[('sale_id.is_rental_order', '=', True)]</field>
        <field name="context" eval="{'search_default_picking_type_id': [ref('stock.picking_type_in')], 'default_picking_type_id': ref('stock.picking_type_in'), 'contact_display': 'partner_address'}" />
        <field name="search_view_id" ref="stock.view_picking_internal_search" />
    </record>
    <record id="action_rental_vendor_picking_type_in" model="ir.actions.act_window">
        <field name="name">Incoming deliveries</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">tree,kanban,form,calendar</field>
        <field name="domain">[('sale_id.is_rental_order', '=', True)]</field>
        <field name="context" eval="{'search_default_picking_type_id': [ref('stock.picking_type_in')], 'default_picking_type_id': ref('stock.picking_type_in'), 'contact_display': 'partner_address'}" />
        <field name="search_view_id" ref="stock.view_picking_internal_search" />
    </record>
    <record id="action_rental_vendor_picking_type_out" model="ir.actions.act_window">
        <field name="name">Outgoing deliveries</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">tree,kanban,form,calendar</field>
        <field name="domain">[('sale_id.is_rental_order', '=', True)]</field>
        <field name="context" eval="{'search_default_picking_type_id': [ref('stock.picking_type_out')], 'default_picking_type_id': ref('stock.picking_type_out'), 'contact_display': 'partner_address'}" />
        <field name="search_view_id" ref="stock.view_picking_internal_search" />
    </record>
    <record id="action_rental_out_invoice" model="ir.actions.act_window">
        <field name="name">Customer invoices</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="view_id" ref="account.view_out_invoice_tree" />
        <field name="search_view_id" ref="account.view_account_invoice_filter" />
        <field name="domain">[('move_type', '=', 'out_invoice'), ('invoice_line_ids.sale_line_ids.order_id.is_rental_order', '=', True)]</field>
        <field name="context">{'default_move_type': 'out_invoice'}</field>
    </record>
    <record id="action_rental_out_refund" model="ir.actions.act_window">
        <field name="name">Customer credit notes</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="view_id" ref="account.view_out_credit_note_tree" />
        <field name="search_view_id" ref="account.view_account_invoice_filter" />
        <field name="domain">[('move_type', '=', 'out_refund'), ('invoice_line_ids.sale_line_ids.order_id.is_rental_order', '=', True)]</field>
        <field name="context">{'default_move_type': 'out_refund'}</field>
    </record>
    <record id="action_rental_in_invoice" model="ir.actions.act_window">
        <field name="name">Vendor bills</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="view_id" ref="account.view_in_invoice_bill_tree" />
        <field name="search_view_id" ref="account.view_account_invoice_filter" />
        <field name="domain">[('move_type', '=', 'in_invoice'), ('invoice_line_ids.sale_line_ids.order_id.is_rental_order', '=', True)]</field>
        <field name="context">{'default_move_type': 'in_invoice'}</field>
    </record>
    <record id="action_rental_in_refund" model="ir.actions.act_window">
        <field name="name">Vendor credit notes</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="view_id" ref="account.view_in_invoice_refund_tree" />
        <field name="search_view_id" ref="account.view_account_invoice_filter" />
        <field name="domain">[('move_type', '=', 'in_refund'), ('invoice_line_ids.sale_line_ids.order_id.is_rental_order', '=', True)]</field>
        <field name="context">{'default_move_type': 'in_refund'}</field>
    </record>
    <record id="sale.action_orders" model="ir.actions.act_window">
        <field name="domain" eval="[('state', 'not in', ('draft', 'sent')), ('is_rental_order', '=', False)]" />
    </record>
    <record id="sale.action_quotations" model="ir.actions.act_window">
        <field name="domain" eval="[('state', 'in', ('draft', 'sent', 'cancel')), ('is_rental_order', '=', False)]" />
    </record>
    <record id="rental_base.action_rental_orders" model="ir.actions.act_window">
        <field name="domain" eval="[('state', 'not in', ('draft', 'sent')), ('is_rental_order', '=', True)]" />
    </record>
    <record id="rental_base.action_rental_quotations" model="ir.actions.act_window">
        <field name="domain" eval="[('state', 'in', ('draft', 'sent', 'cancel')), ('is_rental_order', '=', True)]" />
    </record>
    <record id="rental_base.menu_customer_delivery_outgoing" model="ir.ui.menu">
        <field name="action" ref="action_rental_picking_type_out" />
    </record>
    <record id="rental_base.menu_customer_delivery_incoming" model="ir.ui.menu">
        <field name="action" ref="action_rental_picking_type_in" />
    </record>
    <record id="rental_base.menu_customer_invoices2" model="ir.ui.menu">
        <field name="action" ref="action_rental_out_invoice" />
    </record>
    <record id="rental_base.menu_customer_credit_notes" model="ir.ui.menu">
        <field name="action" ref="action_rental_out_refund" />
    </record>
    <record id="rental_base.menu_vendor_delivery_incoming" model="ir.ui.menu">
        <field name="action" ref="action_rental_vendor_picking_type_in" />
    </record>
    <record id="rental_base.menu_vendor_delivery_outgoing" model="ir.ui.menu">
        <field name="action" ref="action_rental_vendor_picking_type_out" />
    </record>
    <record id="rental_base.menu_vendor_bills" model="ir.ui.menu">
        <field name="action" ref="action_rental_in_invoice" />
    </record>
    <record id="rental_base.menu_vendor_credit_notes" model="ir.ui.menu">
        <field name="action" ref="action_rental_in_refund" />
    </record>
</odoo>
