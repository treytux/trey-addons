<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view" model="ir.ui.view">
        <field name="model">product.template</field>
        <field name="inherit_id" ref="account.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='invoicing']" position="inside">
                <group name="product_account_refund_group" string="Refund accounts">
                    <group name="refund_group_customer">
                        <field name="property_account_sales_refund_id"/>
                    </group>
                    <group name="refund_group_supplier">
                        <field name="property_account_purchase_refund_id"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
