<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_task_form2" model="ir.ui.view">
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('o_row')][.//field[@name='planned_hours']]" position="after">
                <label for="pending_estimated_time"/>
                <div class="o_row">
                    <field name="pending_estimated_time"
                        widget="float_time"
                        class="oe_inline"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
