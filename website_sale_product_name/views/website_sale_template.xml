<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="products_item" inherit_id="website_sale.products_item">
        <xpath expr="//a[@itemprop='name']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//a[@itemprop='name']" position="after">
            <a itemprop="name" t-att-href="product_href" t-att-content="product.website_name" t-field="product.website_name"/>
        </xpath>
    </template>
    <template id="product" inherit_id="website_sale.product">
        <xpath expr="//t[@t-set='additional_title']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//t[@t-set='additional_title']" position="after">
            <t t-set="additional_title" t-value="product.website_name"/>
        </xpath>
        <xpath expr="//span[@t-field='product.name']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//span[@t-field='product.name']" position="after">
            <span t-field="product.website_name"/>
        </xpath>
        <xpath expr="//h1[@itemprop='name']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//h1[@itemprop='name']" position="after">
            <h1 itemprop="name" t-field="product.website_name">Product Name</h1>
        </xpath>
    </template>
    <template id="dynamic_filter_template_product_product_borderless_1" inherit_id="website_sale.dynamic_filter_template_product_product_borderless_1">
        <xpath expr="//img[@t-att-alt='record.display_name']" position="attributes">
            <attribute name="t-att-alt">record.website_name</attribute>
        </xpath>
        <xpath expr="//div[@t-field='record.display_name']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//div[@t-field='record.display_name']" position="after">
            <div class="h6 card-title" t-out="record.website_name"/>
        </xpath>
    </template>
    <template id="suggested_products_list" inherit_id="website_sale.suggested_products_list">
        <xpath expr="//strong[contains(@t-esc, 'display_name')]" position="attributes">
            <attribute name="t-esc">combination_info['website_name']</attribute>
        </xpath>
        <xpath expr="//span[@t-field='product.image_128']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//span[@t-field='product.image_128']" position="after">
            <span t-field="product.image_128" t-options="{'widget': 'image', 'qweb_img_responsive': False, 'class': 'rounded o_image_64_max', 'alt': combination_info['website_name']}" />
        </xpath>
    </template>
</odoo>
