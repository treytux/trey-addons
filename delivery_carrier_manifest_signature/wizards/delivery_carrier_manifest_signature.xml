<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="wizard_delivery_carrier_manifest_signature" model="ir.ui.view">
        <field name="model">delivery.carrier.manifest.signature</field>
        <field name="arch" type="xml">
            <form string="Manifest signature">
                <field name="is_signed" invisible="True"/>
                <group colspan="4" attrs="{'invisible': [('is_signed', '=', True)]}">
                    <field name="signature" widget="signature"/>
                </group>
                <group colspan="4" attrs="{'invisible': [('is_signed', '=', False)]}">
                    <p class="oe_grey">
                        The manifest has already been signed and cannot be signed again.
                    </p>
                </group>
                <footer>
                    <button name="button_sign_manifest" class="oe_highlight"
                        type="object" string="Sign" attrs="{'invisible': [('is_signed', '=', True)]}"/>
                    <button class="oe_link" special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <act_window id="manifest_signature_action"
        name="Manifest signature wizard"
        src_model="delivery.carrier.manifest"
        res_model="delivery.carrier.manifest.signature"
        view_mode="form"
        target="new"
        key2="client_action_multi"/>
</odoo>
