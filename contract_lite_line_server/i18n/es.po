"<p>\n"
"                You are currently using\n"
"                ${'%.2f' % (object.consumed_space_gb or 0.0)}GB out of\n"
"                ${'%.2f' % ((object.contracted_space_gb or 0.0)\n"
"                + (object.disk_expansion_space_gb or 0.0))}GB contracted.\n"
"            </p>\n"
"            <p>\n"
"                We recommend an expansion of\n"
"                ${'%.2f' % (object.suggested_expansion_gb or 0.0)}GB.\n"
"            </p>\n"
