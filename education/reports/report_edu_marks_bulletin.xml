<odoo>
    <record id="edu_marks_bulletin_create" model="ir.actions.report">
        <field name="name">Marks Bulletin</field>
        <field name="model">edu.marks.bulletin</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">education.edu_marks_bulletin</field>
        <field name="report_file">education.edu_marks_bulletin</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
        <field name="print_report_name">'Marks Bulletin - %s' % (object.name)</field>
    </record>
    <template id="enrollment_line">
        <tr>
            <td><span t-esc="enrollments[o]['lines'][line]['enrollment']"/></td>
            <t t-if="enrollments[o]['has_concept']">
                <td><span t-esc="enrollments[o]['lines'][line]['concept']"/></td>
            </t>
            <t t-foreach="enrollments[o]['lines'][line]['evaluations']" t-as="evaluation">
                <t t-set="mark" t-value="enrollments[o]['lines'][line]['evaluations'][evaluation]['mark']"/>
                <t t-if="not mark">
                    <t t-if="enrollments[o]['lines'][line]['validated'] == True">
                        <td class="text-center">Validated</td>
                    </t>
                    <t t-if="enrollments[o]['lines'][line]['validated'] == False">
                        <td class="text-center">N/C</td>
                    </t>
                </t>
                <t t-if="mark">
                    <td class="text-center"><span t-esc="enrollments[o]['lines'][line]['evaluations'][evaluation]['mark']"/></td>
                </t>
            </t>
        </tr>
    </template>
    <template id="edu_marks_bulletin_document">
        <t t-call="web.external_layout">
            <div class="page">
                <div class="row">
                    <div class="col-12">
                        <table class="table table-condensed table-unstyled">
                            <thead>
                                <tr>
                                    <th class="text-center" colspan="2" ><h4>Marks Bulletin</h4></th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><h5><strong>Student: </strong><span t-field="o.name"/></h5></td>
                                    <td><h5><strong>Address:</strong></h5></td>
                                </tr>
                                <tr>
                                    <td><h5><strong>Training Plan: </strong><span t-esc="o.enrollment_id.training_plan_id.name"/></h5></td>
                                    <td><span t-field="o.name"/></td>
                                </tr>
                                <tr>
                                    <td><h5><strong>Classroom: </strong><span t-esc="o.classroom_id.name"/></h5></td>
                                <td>
                                    <span t-field="o.name.street"/>
                                    <t t-if="o.name.street2">
                                        ,<span t-field="o.name.street2"/>
                                    </t>
                                </td>
                                </tr>
                                <tr>
                                    <td><h5><strong>Evaluation: </strong><span t-esc="ev_labels[-1].name"/></h5></td>
                                    <td><span t-field="o.name.city"/></td>
                                </tr>
                                <tr>
                                    <td><h5><strong>Session: <span t-esc="o.year"/></strong></h5></td>
                                    <td>
                                        <span t-field="o.name.zip"/>
                                        <span t-field="o.name.state_id.name"/>
                                        <t t-if="o.name.country_id">
                                            (<span t-field="o.name.country_id.name"/>)
                                        </t>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <table class="table table-condensed table-bordered">
                            <thead>
                                <tr>
                                    <th class="text-center">Subject</th>
                                    <t t-if="enrollments[o]['has_concept']">
                                        <th class="text-center">Concept</th>
                                    </t>
                                    <t t-foreach="ev_labels" t-as="evaluation">
                                        <th class="text-center"><span t-esc="evaluation.name"/></th>
                                    </t>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="enrollments[o]['lines']" t-as="line">
                                    <t t-call="education.enrollment_line"/>
                                </t>
                            </tbody>
                        </table>
                        <table class="table table-condensed table-unstyled">
                            <tbody>
                                <tr>
                                    <td colspan="2" style="height:50px">Promotion decision: <span t-field="o.promote"/></td>
                                </tr>
                                <tr>
                                    <td colspan="2" style="height:100px">Observations: <span t-field="o.observations"/></td>
                                </tr>
                                <tr>
                                    <td style="height:100px">Stamp of the center</td>
                                    <td class="text-right" style="height:100px">Signature of the parent mother or tutor:</td>
                                </tr>
                                <tr>
                                    <td colspan="2" class="text-right">Tutor:
                                        <t t-foreach="o.tutor_ids" t-as="tutor">
                                            <span t-esc="tutor.name"/><br/>
                                        </t>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </t>
    </template>
    <template id="edu_marks_bulletin">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="education.edu_marks_bulletin_document" t-lang="o.name.lang"/>
            </t>
        </t>
    </template>
</odoo>
