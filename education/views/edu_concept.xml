<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="edu_concept_tree_view" model="ir.ui.view">
        <field name="model">edu.concept</field>
        <field name="arch" type="xml">
            <tree string="Concepts">
                <field name="name"/>
                <field name="value_type"/>
                <field name="values_valid"/>
            </tree>
        </field>
    </record>
    <record id="edu_concept_form_view" model="ir.ui.view">
        <field name="model">edu.concept</field>
        <field name="arch" type="xml">
            <form string="Concepts">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button" options='{"terminology": "archive"}'/>
                        </button>
                    </div>
                    <div class="oe_title oe_left">
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                    </div>
                    <div class="oe_right oe_button_box" name="buttons">
                    </div>
                    <group>
                        <group>
                            <field name="value_type"/>
                            <field name="values_valid" attrs="{'invisible':[('value_type','!=', 'text')], 'required':[('value_type','=', 'text')]}"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="edu_concept_search_view" model="ir.ui.view">
        <field name="model">edu.concept</field>
        <field name="arch" type="xml">
            <search string="Concepts">
                <field name="name"/>
                <field name="value_type"/>
                <field name="values_valid"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <newline/>
                <group expand="0" string="Group By...">
                </group>
            </search>
        </field>
    </record>
    <record id="action_edu_concept" model="ir.actions.act_window">
        <field name="name">Concepts</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">edu.concept</field>
        <field name="view_type">form</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="edu_concept_search_view"/>
    </record>
</odoo>
