<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="generate_bulletins_wizard" model="ir.ui.view" >
        <field name="model">edu.wizard.generate.bulletins</field>
        <field name="arch" type="xml">
            <form string="Generate bulletins">
                <group>
                    <field name="evaluation_id"/>
                </group>
                <footer>
                    <button name="button_accept" class="oe_highlight"
                        type="object" string="Accept"/>
                    <button class="oe_link" special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_wizard_generate_bulletins" model="ir.actions.server">
        <field name="name">Generate bulletins</field>
        <field name="model_id" ref="education.model_edu_training_plan_line"/>
        <field name="binding_model_id" ref="education.model_edu_training_plan_line"/>
        <field name="state">code</field>
        <field name="code">
            action = {
                'type': 'ir.actions.act_window',
                'name': 'Generate bulletins',
                'res_model': 'edu.wizard.generate.bulletins',
                'view_mode': 'form',
                'view_type': 'form',
                'target': 'new',
             }
       </field>
    </record>
</odoo>
