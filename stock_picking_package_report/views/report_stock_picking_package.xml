<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <report
        id="report_package_list_create"
        model="stock.picking"
        string="Package List Report"
        report_type="qweb-pdf"
        name="stock_picking_package_report.report_package_list"
        file="stock_picking_package_report.report_package_list"
    />
    <template id="report_package_list_document">
        <t t-call="web.external_layout">
            <t t-set="o" t-value="o.with_context(lang=lang)" />
            <div class="page o_sppr_report">
                <div class="row">
                    <div class="col-4">
                        <ul class="list-unstyled">
                            <li><strong t-field="o.company_id.partner_id.name"/></li>
                            <li><span t-field="o.company_id.partner_id.street"/></li>
                            <li><span t-field="o.company_id.partner_id.zip"/></li>
                            <li><span t-field="o.company_id.partner_id.phone"/></li>
                            <li><span t-field="o.company_id.partner_id.email"/></li>
                        </ul>
                    </div>
                    <t t-if="o.sale_id and o.sale_id.partner_shipping_id"></t>
                        <div class="col-4">
                            <ul class="list-unstyled">
                                <li><strong>Delivery Address:</strong></li>
                                <li><span t-field="o.sale_id.partner_shipping_id.name"/></li>
                                <li><span t-field="o.sale_id.partner_shipping_id.street"/></li>
                                <li><span t-field="o.sale_id.partner_shipping_id.zip"/></li>
                                <li><span t-field="o.sale_id.partner_shipping_id.phone"/></li>
                                <li><span t-field="o.sale_id.partner_shipping_id.email"/></li>
                            </ul>
                        </div>
                    <div class="col-4">
                        <ul class="list-unstyled">
                            <li><strong>Customer:</strong></li>
                            <li><strong t-field="o.partner_id.name"/></li>
                            <li><span t-field="o.partner_id.street"/></li>
                            <li><span t-field="o.partner_id.zip"/></li>
                            <li><span t-field="o.partner_id.country_id"/></li>
                        </ul>
                    </div>
                </div>
                <div class="row mt32 mb32">
                    <t t-if="o.date_done">
                        <div class="col-auto mw-100 mr-1 mb-2">
                            <strong>Date:</strong>
                            <p t-field="o.date_done" t-options="{'widget': 'date'}"/>
                        </div>
                    </t>
                    <t t-if="o.sale_id">
                        <div class="col-auto mw-100 mb-2">
                            <strong>Reference:</strong>
                            <p t-field="o.sale_id.name"/>
                        </div>
                    </t>
                </div>
                <div class="row">
                    <div class="col-12">
                        <t t-foreach="o.package_ids" t-as="package">
                            <h4 t-field="package.name"/>
                            <table id="table_lines" class="table table-striped">
                                <thead>
                                    <tr class="text-center">
                                        <th>Code</th>
                                        <th>Description</th>
                                        <th class="text-uppercase">UoM</th>
                                        <th class="text-uppercase">Qty</th>
                                        <th>Weight KG</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="package.picking_ids" t-as="line">
                                        <tr class="text-left">
                                            <td>
                                                <span t-field="line.product_id.default_code"/>
                                            </td>
                                            <td>
                                                <p t-field="line.product_id.name"/>
                                                <t t-if="line.lot_id">
                                                    <span t-field="line.lot_id"/>
                                                </t>
                                            </td>
                                            <td>
                                                <span t-field="line.product_uom_id"/>
                                            </td>
                                            <td>
                                                <span t-field="line.quantity"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                    </div>
                </div>
            </div>
        </t>
    </template>
    <template id="report_package_list">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="lang" t-value="o.company_id.partner_id.lang"/>
                <t t-call="stock_picking_package_report.report_package_list_document" t-lang="lang"/>
            </t>
        </t>
    </template>
</odoo>
