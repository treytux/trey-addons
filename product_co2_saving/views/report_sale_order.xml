<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_saleorder_document" inherit_id="sale.report_saleorder_document" priority="10">
        <xpath expr="//tr[hasclass('o_total')]" position="after">
            <t t-set="total_co2_saving" t-value="0.0"/>
            <t t-foreach="doc.order_line" t-as="line">
                <t t-set="total_co2_saving" t-value="total_co2_saving + (line.product_id.co2_saving * line.product_uom_qty)"/>
            </t>
            <tr t-if="total_co2_saving != 0.0" class="border-black">
                <td name="td_co2_saving_label"><strong>CO2 Saving</strong></td>
                <td name="td_co2_saving" class="text-right">
                    <span t-esc="total_co2_saving"/> KG
                </td>
            </tr>
        </xpath>
    </template>
</odoo>
