#. module: print_formats_base
#: model:ir.model.fields,help:print_formats_base.field_product_product__add_to_sum_qty
#: model:ir.model.fields,help:print_formats_base.field_product_template__add_to_sum_qty
msgid ""
"If you check this box this product will be consider to make the quantity "
"sums in the print formats. This sum is an informative value for the "
"operation of the business."
msgstr ""
"Si marca esta casilla, este producto se tendrá en cuenta para calcular "
"las cantidades totales en los formatos de impresión. Esta suma es un "
"valor informativo para el funcionamiento del negocio."

#. module: print_formats_base
#: model:ir.model.fields,field_description:print_formats_base.field_product_product__add_to_sum_qty
#: model:ir.model.fields,field_description:print_formats_base.field_product_template__add_to_sum_qty
msgid "Include in print formats line summation"
msgstr "Incluir en los formatos impresos el resumen de líneas"

