<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data>
        <record model="ir.rule" id="hr_contract_multicompany">
            <field name="name">hr.contract multi-company</field>
            <field name="model_id" ref="hr_contract.model_hr_contract"/>
            <field name="domain_force">
                ['|', ('company_id', 'child_of', [user.company_id.id]), ('company_id', '=',False)]
            </field>
        </record>
        <record model="ir.rule" id="hr_contract_type_multicompany">
            <field name="name">hr.contract.type multi-company</field>
            <field name="model_id" ref="hr_contract.model_hr_contract_type"/>
            <field name="domain_force">
                ['|', ('company_id', 'child_of', [user.company_id.id]), ('company_id', '=',False)]
            </field>
        </record>
    </data>
</openerp>
