<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_project_form_current_balance" model="ir.ui.view">
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='label_tasks']" position="before">
                <field name="current_balance" readonly="1"/>
            </xpath>
            <xpath expr="//sheet/group[1]" position="after">
                <group>
                    <group string="Balance" groups="project_current_balance.group_contract_balance_management">
                        <field name="extra_balance"/>
                        <field name="extra_balance_date"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
