<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="email_template_rma" model="mail.template">
            <field name="name">RMA Order - Send by Email</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="email_from">{{ '"%s" &lt;%s&gt;' % (user.company_id.name, user.company_id.email or user.email) }}</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="subject">{{ '%s RMA (Ref %s)' % (object.company_id.name, object.name or 'n/a') }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 12px;">
                        Dear <t t-out="object.partner_id.name or ''"/>
                        <t t-if="object.partner_id.parent_id">
                            (<i><t t-out="object.partner_id.parent_id.name"/></i>)
                        </t>,
                        <br/><br/>
                        Please find attached a return order request
                        <span style="font-weight:bold;"
                              t-out="object.name or ''"/>
                        <t t-if="object.client_order_ref">
                            with reference:
                            <span t-out="object.client_order_ref or ''"/>
                        </t>
                        <t t-if="object.origin">
                            (RFQ origin: <span t-out="object.origin or ''"/>)
                        </t>
                        amounting
                        <span style="font-weight:bold;"
                              t-out="format_amount(object.amount_total, object.currency_id)"/>
                        from <span t-out="object.company_id.name or ''"/>.
                        <br/><br/>
                        You can reply to this email if you have any questions.
                        <br/><br/>
                        Thank you,
                        <t t-if="object.sudo().create_uid and object.sudo().create_uid.signature">
                            <br/>
                            <span t-out="object.sudo().create_uid.signature or ''"/>
                        </t>
                    </p>
                </div>
            </field>
        </record>
    </data>
</odoo>
