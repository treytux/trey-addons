#. module: website_rma
#: model:mail.template,body_html:website_rma.email_template_rma
msgid "\n"
"                <div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 12px;\">\n"
"                        Hello,\n"
"                        <br/><br/>\n"
"                        <t t-set=\"transaction\"\n"
"                           t-value=\"object.get_portal_last_transaction()\"/>\n"
"                        Your return request\n"
"                        <span style=\"font-weight:bold;\"\n"
"                              t-out=\"object.name or ''\"/>\n"
"                        amounting in\n"
"                        <span style=\"font-weight:bold;\"\n"
"                              t-out=\"format_amount(object.amount_total, object.currency_id) or ''\"/>\n"
"                        <t t-if=\"object.client_order_ref\">\n"
"                            with reference\n"
"                            <span style=\"font-weight:bold;\"\n"
"                                  t-out=\"object.client_order_ref or ''\"/>.\n"
"                        </t>\n"
"                        <t t-if=\"object.origin\">\n"
"                            RFQ origin:\n"
"                            <span style=\"font-weight:bold;\"\n"
"                                  t-out=\"object.origin or ''\"/>.\n"
"                        </t>\n"
"                        <br/><br/>\n"
"                        Do not hesitate to contact us if you have any questions.\n"
"                        <t t-if=\"not is_html_empty(object.user_id.signature)\">\n"
"                            <br/><br/>\n"
"                            <t t-out=\"object.user_id.signature or ''\"/>\n"
"                        </t>\n"
"                        <br/><br/>\n"
"                    </p>\n"
"                    <t t-if=\"hasattr(object, 'website_id') and object.website_id\">\n"
"                        <div style=\"margin: 0px; padding: 0px;\">\n"
"                            <table width=\"100%\"\n"
"                                   style=\"color: #454748; font-size: 12px; border-collapse: collapse;\">\n"
"                                <tbody>\n"
"                                    <tr style=\"border-bottom: 2px solid #dee2e6;\">\n"
"                                        <td style=\"width: 150px;\">\n"
"                                            <span style=\"font-weight:bold;\">Products</span>\n"
"                                        </td>\n"
"                                        <td></td>\n"
"                                        <td width=\"15%\" align=\"center\">\n"
"                                            <span style=\"font-weight:bold;\">Quantity</span>\n"
"                                        </td>\n"
"                                        <td width=\"20%\" align=\"right\">\n"
"                                            <span style=\"font-weight:bold;\">\n"
"                                                <t t-if=\"object.user_id.has_group('account.group_show_line_subtotals_tax_excluded')\">\n"
"                                                    VAT Excl.\n"
"                                                </t>\n"
"                                                <t t-else=\"\">\n"
"                                                    VAT Incl.\n"
"                                                </t>\n"
"                                            </span>\n"
"                                        </td>\n"
"                                    </tr>\n"
"                                </tbody>\n"
"                            </table>\n"
"                            <t t-foreach=\"object.order_line\" t-as=\"line\">\n"
"                                <t t-if=\"(not hasattr(line, 'is_delivery') or not line.is_delivery) and line.display_type in ['line_section', 'line_note']\">\n"
"                                    <t t-set=\"loop_cycle_number\"\n"
"                                       t-value=\"loop_cycle_number or 0\"/>\n"
"                                    <t t-set=\"loop_cycle_number\"\n"
"                                       t-value=\"loop_cycle_number + 1\"/>\n"
"                                    <table width=\"100%\"\n"
"                                           style=\"color: #454748; font-size: 12px; border-collapse: collapse;\">\n"
"                                        <tbody>\n"
"                                            <tr t-att-style=\"'background-color: #f2f2f2' if loop_cycle_number % 2 == 0 else 'background-color: #ffffff'\">\n"
"                                                <td colspan=\"4\">\n"
"                                                    <t t-if=\"line.display_type == 'line_section'\">\n"
"                                                        <span style=\"font-weight:bold;\"\n"
"                                                              t-out=\"line.name or ''\"/>\n"
"                                                    </t>\n"
"                                                    <t t-elif=\"line.display_type == 'line_note'\">\n"
"                                                        <i t-out=\"line.name or ''\"/>\n"
"                                                    </t>\n"
"                                                </td>\n"
"                                            </tr>\n"
"                                        </tbody>\n"
"                                    </table>\n"
"                                </t>\n"
"                                <t t-elif=\"(not hasattr(line, 'is_delivery') or not line.is_delivery)\">\n"
"                                    <t t-set=\"loop_cycle_number\"\n"
"                                       t-value=\"loop_cycle_number or 0\"/>\n"
"                                    <t t-set=\"loop_cycle_number\"\n"
"                                       t-value=\"loop_cycle_number + 1\"/>\n"
"                                    <table width=\"100%\"\n"
"                                           style=\"color: #454748; font-size: 12px; border-collapse: collapse;\">\n"
"                                        <tbody>\n"
"                                            <tr t-att-style=\"'background-color: #f2f2f2' if loop_cycle_number % 2 == 0 else 'background-color: #ffffff'\">\n"
"                                                <td style=\"width: 150px;\">\n"
"                                                    <img t-attf-src=\"/web/image/product.product/{{ line.product_id.id }}/image_128\"\n"
"                                                         style=\"width: 64px; height: 64px; object-fit: contain;\"\n"
"                                                         alt=\"Product image\"/>\n"
"                                                </td>\n"
"                                                <td align=\"left\"\n"
"                                                    t-out=\"line.product_id.name or ''\"/>\n"
"                                                <td width=\"15%\" align=\"center\"\n"
"                                                    t-out=\"line.product_uom_qty or ''\"/>\n"
"                                                <td width=\"20%\" align=\"right\">\n"
"                                                    <span style=\"font-weight:bold;\">\n"
"                                                        <t t-if=\"object.user_id.has_group('account.group_show_line_subtotals_tax_excluded')\">\n"
"                                                            <t t-out=\"format_amount(line.price_reduce_taxexcl, object.currency_id) or ''\"/>\n"
"                                                        </t>\n"
"                                                        <t t-else=\"\">\n"
"                                                            <t t-out=\"format_amount(line.price_reduce_taxinc, object.currency_id) or ''\"/>\n"
"                                                        </t>\n"
"                                                    </span>\n"
"                                                </td>\n"
"                                            </tr>\n"
"                                        </tbody>\n"
"                                    </table>\n"
"                                </t>\n"
"                            </t>\n"
"                        </div>\n"
"                        <div style=\"margin: 0px; padding: 0px;\"\n"
"                             t-if=\"hasattr(object, 'carrier_id') and object.carrier_id\">\n"
"                            <table width=\"100%\"\n"
"                                   style=\"color: #454748; font-size: 12px; border-spacing: 0px 4px;\"\n"
"                                   align=\"right\">\n"
"                                <tbody>\n"
"                                    <tr>\n"
"                                        <td style=\"width: 60%\"></td>\n"
"                                        <td style=\"width: 30%; border-top: 1px solid #dee2e6;\"\n"
"                                            align=\"right\">\n"
"                                            <span style=\"font-weight:bold;\">Delivery:</span>\n"
"                                        </td>\n"
"                                        <td style=\"width: 10%; border-top: 1px solid #dee2e6;\"\n"
"                                            align=\"right\"\n"
"                                            t-out=\"format_amount(object.amount_delivery, object.currency_id) or ''\"/>\n"
"                                    </tr>\n"
"                                    <tr>\n"
"                                        <td style=\"width: 60%\"></td>\n"
"                                        <td style=\"width: 30%;\" align=\"right\">\n"
"                                            <span style=\"font-weight:bold;\">SubTotal:</span>\n"
"                                        </td>\n"
"                                        <td style=\"width: 10%;\" align=\"right\"\n"
"                                            t-out=\"format_amount(object.amount_untaxed, object.currency_id) or ''\"/>\n"
"                                    </tr>\n"
"                                </tbody>\n"
"                            </table>\n"
"                        </div>\n"
"                        <div style=\"margin: 0px; padding: 0px;\" t-else=\"\">\n"
"                            <table width=\"100%\"\n"
"                                   style=\"color: #454748; font-size: 12px; border-spacing: 0px 4px;\"\n"
"                                   align=\"right\">\n"
"                                <tbody>\n"
"                                    <tr>\n"
"                                        <td style=\"width: 60%\"></td>\n"
"                                        <td style=\"width: 30%; border-top: 1px solid #dee2e6;\"\n"
"                                            align=\"right\">\n"
"                                            <span style=\"font-weight:bold;\">SubTotal:</span>\n"
"                                        </td>\n"
"                                        <td style=\"width: 10%; border-top: 1px solid #dee2e6;\"\n"
"                                            align=\"right\"\n"
"                                            t-out=\"format_amount(object.amount_untaxed, object.currency_id) or ''\"/>\n"
"                                    </tr>\n"
"                                </tbody>\n"
"                            </table>\n"
"                        </div>\n"
"                        <div style=\"margin: 0px; padding: 0px;\">\n"
"                            <table width=\"100%\"\n"
"                                   style=\"color: #454748; font-size: 12px; border-spacing: 0px 4px;\"\n"
"                                   align=\"right\">\n"
"                                <tbody>\n"
"                                    <tr>\n"
"                                        <td style=\"width: 60%\"></td>\n"
"                                        <td style=\"width: 30%;\" align=\"right\">\n"
"                                            <span style=\"font-weight:bold;\">Taxes:</span>\n"
"                                        </td>\n"
"                                        <td style=\"width: 10%;\" align=\"right\"\n"
"                                            t-out=\"format_amount(object.amount_tax, object.currency_id) or ''\"/>\n"
"                                    </tr>\n"
"                                    <tr>\n"
"                                        <td style=\"width: 60%\"></td>\n"
"                                        <td style=\"width: 30%; border-top: 1px solid #dee2e6;\"\n"
"                                            align=\"right\">\n"
"                                            <span style=\"font-weight:bold;\">Total:</span>\n"
"                                        </td>\n"
"                                        <td style=\"width: 10%; border-top: 1px solid #dee2e6;\"\n"
"                                            align=\"right\"\n"
"                                            t-out=\"format_amount(object.amount_total, object.currency_id) or ''\"/>\n"
"                                    </tr>\n"
"                                </tbody>\n"
"                            </table>\n"
"                        </div>\n"
"                        <div t-if=\"object.partner_invoice_id\"\n"
"                             style=\"margin: 0px; padding: 0px;\">\n"
"                            <table width=\"100%\"\n"
"                                   style=\"color: #454748; font-size: 12px;\">\n"
"                                <tbody>\n"
"                                    <tr>\n"
"                                        <td style=\"padding-top: 10px;\">\n"
"                                            <span style=\"font-weight:bold;\">Bill to:</span>\n"
"                                            <t t-out=\"object.partner_invoice_id.street or ''\"/>\n"
"                                            <t t-out=\"object.partner_invoice_id.city or ''\"/>\n"
"                                            <t t-out=\"object.partner_invoice_id.state_id.name or ''\"/>\n"
"                                            <t t-out=\"object.partner_invoice_id.zip or ''\"/>\n"
"                                            <t t-out=\"object.partner_invoice_id.country_id.name or ''\"/>\n"
"                                        </td>\n"
"                                    </tr>\n"
"                                    <tr t-if=\"transaction\">\n"
"                                        <td>\n"
"                                            <span style=\"font-weight:bold;\">Payment Method:</span>\n"
"                                            <t t-if=\"transaction.token_id\">\n"
"                                                <t t-out=\"transaction.token_id.display_name or ''\"/>\n"
"                                            </t>\n"
"                                            <t t-else=\"\">\n"
"                                                <t t-out=\"transaction.provider_id.sudo().name or ''\"/>\n"
"                                            </t>\n"
"                                            (<t t-out=\"format_amount(transaction.amount, object.currency_id) or ''\"/>)\n"
"                                        </td>\n"
"                                    </tr>\n"
"                                </tbody>\n"
"                            </table>\n"
"                        </div>\n"
"                        <div t-if=\"object.partner_shipping_id and not object.only_services\"\n"
"                             style=\"margin: 0px; padding: 0px;\">\n"
"                            <table width=\"100%\"\n"
"                                   style=\"color: #454748; font-size: 12px;\">\n"
"                                <tbody>\n"
"                                    <tr>\n"
"                                        <td>\n"
"                                            <br/>\n"
"                                            <span style=\"font-weight:bold;\">Ship to:</span>\n"
"                                            <t t-out=\"object.partner_shipping_id.street or ''\"/>\n"
"                                            <t t-out=\"object.partner_shipping_id.city or ''\"/>\n"
"                                            <t t-out=\"object.partner_shipping_id.state_id.name or ''\"/>\n"
"                                            <t t-out=\"object.partner_shipping_id.zip or ''\"/>\n"
"                                            <t t-out=\"object.partner_shipping_id.country_id.name or ''\"/>\n"
"                                        </td>\n"
"                                    </tr>\n"
"                                </tbody>\n"
"                            </table>\n"
"                            <table t-if=\"hasattr(object, 'carrier_id') and object.carrier_id\"\n"
"                                   width=\"100%\"\n"
"                                   style=\"color: #454748; font-size: 12px;\">\n"
"                                <tbody>\n"
"                                    <tr>\n"
"                                        <td>\n"
"                                            <span style=\"font-weight:bold;\">Shipping Method:</span>\n"
"                                            <t t-out=\"object.carrier_id.name or ''\"/>\n"
"                                            <t t-if=\"object.amount_delivery == 0.0\">\n"
"                                                (Free)\n"
"                                            </t>\n"
"                                            <t t-else=\"\">\n"
"                                                (<t t-out=\"format_amount(object.amount_delivery, object.currency_id) or ''\"/>)\n"
"                                            </t>\n"
"                                        </td>\n"
"                                    </tr>\n"
"                                    <tr t-if=\"object.carrier_id.carrier_description\">\n"
"                                        <td>\n"
"                                            <strong>Shipping Description:</strong>\n"
"                                            <t t-out=\"object.carrier_id.carrier_description\"/>\n"
"                                        </td>\n"
"                                    </tr>\n"
"                                </tbody>\n"
"                            </table>\n"
"                        </div>\n"
"                    </t>\n"
"                </div>\n"
"            "
msgstr ""

