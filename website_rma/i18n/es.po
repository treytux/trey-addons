#: model:mail.template,body_html:website_rma.email_template_rma
msgid "\n"
"                <div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 12px;\">\n"
"                        Dear <t t-out=\"object.partner_id.name or ''\"/>\n"
"                        <t t-if=\"object.partner_id.parent_id\">\n"
"                            (<i><t t-out=\"object.partner_id.parent_id.name\"/></i>)\n"
"                        </t>,\n"
"                        <br/><br/>\n"
"                        Please find attached a return order request\n"
"                        <span style=\"font-weight:bold;\"\n"
"                              t-out=\"object.name or ''\"/>\n"
"                        <t t-if=\"object.client_order_ref\">\n"
"                            with reference:\n"
"                            <span t-out=\"object.client_order_ref or ''\"/>\n"
"                        </t>\n"
"                        <t t-if=\"object.origin\">\n"
"                            (RFQ origin: <span t-out=\"object.origin or ''\"/>)\n"
"                        </t>\n"
"                        amounting\n"
"                        <span style=\"font-weight:bold;\"\n"
"                              t-out=\"format_amount(object.amount_total, object.currency_id)\"/>\n"
"                        from <span t-out=\"object.company_id.name or ''\"/>.\n"
"                        <br/><br/>\n"
"                        You can reply to this email if you have any questions.\n"
"                        <br/><br/>\n"
"                        Thank you,\n"
"                        <t t-if=\"object.sudo().create_uid and object.sudo().create_uid.signature\">\n"
"                            <br/>\n"
"                            <span t-out=\"object.sudo().create_uid.signature or ''\"/>\n"
"                        </t>\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr "\n"
"                <div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 12px;\">\n"
"                        Estimado/a <t t-out=\"object.partner_id.name or ''\"/>\n"
"                        <t t-if=\"object.partner_id.parent_id\">\n"
"                            (<i><t t-out=\"object.partner_id.parent_id.name\"/></i>)\n"
"                        </t>,\n"
"                        <br/><br/>\n"
"                        Adjuntamos una solicitud de devolución de pedido\n"
"                        <span style=\"font-weight:bold;\"\n"
"                              t-out=\"object.name or ''\"/>\n"
"                        <t t-if=\"object.client_order_ref\">\n"
"                            con referencia:\n"
"                            <span t-out=\"object.client_order_ref or ''\"/>\n"
"                        </t>\n"
"                        <t t-if=\"object.origin\">\n"
"                            (Origen de la solicitud: <span t-out=\"object.origin or ''\"/>)\n"
"                        </t>\n"
"                        por importe de\n"
"                        <span style=\"font-weight:bold;\"\n"
"                              t-out=\"format_amount(object.amount_total, object.currency_id)\"/>\n"
"                        de <span t-out=\"object.company_id.name or ''\"/>.\n"
"                        <br/><br/>\n"
"                        Puede responder a este correo si tiene cualquier duda.\n"
"                        <br/><br/>\n"
"                        Gracias,\n"
"                        <t t-if=\"object.sudo().create_uid and object.sudo().create_uid.signature\">\n"
"                            <br/>\n"
"                            <span t-out=\"object.sudo().create_uid.signature or ''\"/>\n"
"                        </t>\n"
"                    </p>\n"
"                </div>\n"
"            "
