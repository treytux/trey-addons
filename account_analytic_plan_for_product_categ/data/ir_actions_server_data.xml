<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="server_action_mass_edit_product_category_edit" model="ir.actions.server">
        <field name="name">Mass edit (Analytic plan)</field>
        <field name="model_id" ref="product.model_product_category"/>
        <field name="binding_model_id" ref="product.model_product_category"/>
        <field name="binding_type">action</field>
        <field name="state">mass_edit</field>
    </record>
    <record id="server_action_mass_edit_product_category_edit_line_plan" model="ir.actions.server.mass.edit.line">
        <field name="server_action_id" ref="server_action_mass_edit_product_category_edit"/>
        <field name="field_id" model="ir.model.fields"
               eval="obj().search([('model', '=', 'product.category'), ('name', '=', 'plan_analytic_id')])"/>
    </record>
</odoo>
