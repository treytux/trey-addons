<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form" model="ir.ui.view">
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page/field/form/sheet/group" position="inside">
                    <field name="image_1920" widget="image" class="oe_avatar" nolabel="1" attrs="{'invisible': [('type', '!=', 'contact')]}" options="{'preview_image': 'image_medium', 'size': [90, 90]}"/>
            </xpath>
        </field>
    </record>
</odoo>
