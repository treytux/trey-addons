<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form" model="ir.ui.view">
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page/field/form/sheet/group" position="inside">
                <group>
                    <field name="image" widget="image" class="oe_avatar" nolabel="1" attrs="{'invisible': [('type','!=', 'contact')]}" options="{&quot;preview_image&quot;: &quot;image_medium&quot;, &quot;size&quot;: [90, 90]}"/>
                </group>
            </xpath>
            <xpath expr="//page/field/form/sheet/field[@name='image']" position="attributes">
                <attribute name="widget">image</attribute>
            </xpath>
        </field>
    </record>
</odoo>
