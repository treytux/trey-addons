<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form" model="ir.ui.view">
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_info']" position="inside">
                <group string="Google Shopping" name="google_shopping">
                    <field name="google_feed_size" placeholder="Set 0 to unlimited"/>
                    <field name="google_feed_expiry_time" placeholder="24"/>
                    <field name="google_image_width" placeholder="800"/>
                    <field name="google_image_height" placeholder="800"/>
                    <field name="google_use_shipping_settings"/>
                    <field name="google_shipping_country" placeholder="E.g.: US"/>
                    <field name="google_shipping_service" placeholder="E.g.: Standard or Express"/>
                    <field name="google_shipping_price" placeholder="E.g.: 14.95"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
