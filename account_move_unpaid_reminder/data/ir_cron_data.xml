<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="ir_cron_unpaid_reminder" model="ir.cron">
        <field name="name">Send Unpaid Reminders</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="state">code</field>
        <field name="code">model._send_unpaid_reminders()</field>
        <field name="interval_number">3</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
    </record>
    <record id="email_tmpl_unpaid_reminder" model="mail.template">
        <field name="name">Unpaid Reminder</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="subject">Unpaid Reminder for Invoice {{ object.id }} "{{ object.ref }}"</field>
        <field name="email_from">{{ (object.user_id.email_formatted or object.company_id.email_formatted or user.email_formatted) }}</field>
        <field name="email_to">{{ ctx.get('email_to') }}</field>
        <field name="body_html">
            <![CDATA[
            <p>Dear <t t-out="object.partner_id.name">customer</t>,</p>
            <p>This is a reminder that your invoice <t t-out="object.id or ''"></t> "<t t-out="object.ref or ''"></t>" is pending payment.</p>
            <p>Thank you.</p>
            ]]>
        </field>
    </record>
</odoo>
