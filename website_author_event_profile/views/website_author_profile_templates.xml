<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="author_profile_blogs" inherit_id="website_author_profile.author_profile">
        <xpath expr="//div[@class='row']" position="after">
            <h2 class="text-center mb-4">Author's events</h2>
            <div class="row">
                <t t-if="events" t-foreach="events" t-as="event">
                    <div class="col-md-4 mb-4">
                        <div class="card h-100 shadow" t-att-style="'background-image: url(%s); background-size: cover; background-position: center;' % event.get_clean_background_url()">
                            <div class="card-body" style="background-color: rgba(255, 255, 255, 0.7) !important; color: #212529 !important;">
                                <h5 class="card-title" t-esc="event.name"/>
                                <p class="card-text" t-esc="event.date_begin.strftime('%A %d de %B de %Y') if event.date_begin else ''"/>
                                <a t-att-href="event.website_url" class="btn btn-primary mt-2">View event</a>
                            </div>
                        </div>
                    </div>
                </t>
                <t t-if="not events">
                    <p class="text-center">This author has no published events.</p>
                </t>
            </div>
        </xpath>
    </template>
</odoo>
