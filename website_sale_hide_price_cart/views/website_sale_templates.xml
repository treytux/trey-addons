<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="header_cart_link" inherit_id="website_sale.header_cart_link">
        <xpath expr="//li[contains(@t-attf-class, 'o_wsale_my_cart')]" position="attributes">
            <attribute name="t-if">
                website and website.website_show_price
            </attribute>
        </xpath>
    </template>
</odoo>
