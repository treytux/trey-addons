<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="crm_lead_g_point_form_view" model="ir.ui.view">
        <field name="model">crm.lead.g_point</field>
        <field name="arch" type="xml">
            <form string="G points">
                <group>
                    <field name="name"/>
                </group>
            </form>
        </field>
    </record>
    <record id="crm_lead_g_point_tree_view" model="ir.ui.view">
        <field name="model">crm.lead.g_point</field>
        <field name="arch" type="xml">
            <tree string="G points">
                <field name="name"/>
            </tree>
        </field>
    </record>
    <record id="g_point_action_window" model="ir.actions.act_window">
        <field name="name">G points</field>
        <field name="res_model">crm.lead.g_point</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">Click to create a new G point.</p>
        </field>
    </record>
    <menuitem
        id="gpoints"
        action="g_point_action_window"
        parent="crm.menu_crm_config_lead"
        sequence="2"/>
</odoo>
