<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="contract_contract_form_view" model="ir.ui.view">
        <field name="model">contract.contract</field>
        <field name="inherit_id" ref="contract.contract_contract_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='contract_line_fixed_ids']/tree/field[@name='product_id']" position="after">
                <field
                    name="route_id"
                    attrs="{'column_invisible': [('parent.generation_type', '!=', 'sale')]}"
                />
            </xpath>
            <xpath expr="//field[@name='contract_line_ids']/tree/field[@name='product_id']" position="after">
                <field
                    name="route_id"
                    attrs="{'column_invisible': [('parent.generation_type', '!=', 'sale')]}"
                />
            </xpath>
        </field>
    </record>
    <record id="contract_line_form_view" model="ir.ui.view">
        <field name="model">contract.line</field>
        <field name="inherit_id" ref="contract.contract_line_form_view"/>
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field name="contract_generation_type" invisible="1"/>
                <field
                    name="route_id"
                    attrs="{'invisible': [('contract_generation_type', '!=', 'sale')]}"
                />
            </field>
        </field>
    </record>
</odoo>
