<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_task_form2" model="ir.ui.view">
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="after">
                <field name="show_balance_warning" invisible="1"/>
                <div attrs="{'invisible': ['|', ('show_balance_warning', '=', False), ('analytic_unit_balance', '>=', 0)]}" class="alert alert-danger mb-0" role="alert">
                    <h4 class="text-center">The balance is negative for this task.</h4>
                </div>
            </xpath>
            <xpath expr="//field[@name='date_deadline']" position="before">
                <field name="analytic_unit_balance" readonly="1" widget="timesheet_uom"/>
            </xpath>
        </field>
    </record>
</odoo>
