<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_delivery_document" inherit_id="stock.report_delivery_document" priority="99">
        <xpath expr="//t[@t-set='information_block']" position="attributes">
            <attribute name="t-if">o.picking_type_id.code == 'incoming' and o.partner_id</attribute>
        </xpath>
        <xpath expr="//t[@t-set='information_block']/div" position="replace">
            <div class="row">
                <div class="col-12" name="div_incoming_address">
                    <div name="vendor_address" t-if="o.picking_type_id.code=='incoming' and partner and not o.move_ids.filtered('origin_returned_move_id')">
                        <span><strong>Vendor Address:</strong></span>
                        <div t-field="o.partner_id"
                             t-options="{'widget': 'contact', 'fields': ['address', 'name', 'phone', 'vat'], 'no_marker': True}"/>
                    </div>
                    <div name="customer_address" t-if="o.picking_type_id.code=='outgoing' and partner and partner != partner.commercial_partner_id">
                        <span><strong>Customer Address:</strong></span>
                        <div t-field="o.partner_id"
                             t-options="{'widget': 'contact', 'fields': ['address', 'name', 'phone', 'vat'], 'no_marker': True}"/>
                    </div>
                    <div name="picking_address" t-if="o.picking_type_id.code=='incoming' and partner and o.move_ids.filtered('origin_returned_move_id')">
                        <span><strong>Picking Address:</strong></span>
                        <div t-field="o.partner_id"
                             t-options="{'widget': 'contact', 'fields': ['address', 'name', 'phone'], 'no_marker': True}"/>
                    </div>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
