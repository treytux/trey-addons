<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="partner_risk_form_view" model="ir.ui.view">
        <field name="model">partner.risk</field>
        <field name="arch" type="xml">
            <form string="Partner risk">
                <sheet>
                    <group name="partner_risk">
                        <field name="name"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>
    <record id="partner_risk_tree_view" model="ir.ui.view">
        <field name="model">partner.risk</field>
        <field name="arch" type="xml">
            <tree string="Partner risk">
                <field name="name"/>
            </tree>
        </field>
    </record>
    <record id="partner_risk_search_view" model="ir.ui.view">
        <field name="model">partner.risk</field>
        <field name="arch" type="xml">
            <search string="Partner risk">
                <field name="name"/>
            </search>
        </field>
    </record>
    <record id="partner_risk_action" model="ir.actions.act_window">
        <field name="name">Partner risk</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">partner.risk</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="partner_risk_search_view"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define a new record
            </p>
        </field>
    </record>
</odoo>
