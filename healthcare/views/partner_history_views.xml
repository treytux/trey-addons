<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="partner_history_form_view" model="ir.ui.view">
        <field name="model">partner.history</field>
        <field name="arch" type="xml">
            <form string="Partner history">
                <sheet>
                    <group name="partner_history_info">
                        <group name="main_info">
                            <field name="partner_id"/>
                            <field name="date"/>
                            <field name="location"/>
                        </group>
                        <group name="type_and_risks">
                            <field name="type_id"/>
                            <field name="risk_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <group name="notes">
                                <label for="note" string="Notes"/>
                                <field name="note" nolabel="1" colspan="2"/>
                                <label for="family_notes" string="Family notes"/>
                                <field name="family_notes" nolabel="1" colspan="2"/>
                                <label for="school_notes" string="School notes"/>
                                <field name="school_notes" nolabel="1" colspan="2"/>
                            </group>
                        </page>
                        <page string="Advancement">
                            <group name="advancement">
                                <label for="advancement" string="Advancement"/>
                                <field name="advancement" nolabel="1" colspan="2"/>
                            </group>
                        </page>
                        <page string="Planning in actions">
                            <group name="planning_in_actions">
                                <label for="planning_in_actions" string="Planning in actions"/>
                                <field name="planning_in_actions" nolabel="1" colspan="2"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>
    <record id="partner_history_tree_view" model="ir.ui.view">
        <field name="model">partner.history</field>
        <field name="arch" type="xml">
            <tree string="Partner history">
                <field name="partner_id"/>
                <field name="date"/>
                <field name="location"/>
                <field name="type_id"/>
                <field name="risk_ids" widget="many2many_tags"/>
                <field name="note"/>
            </tree>
        </field>
    </record>
    <record id="partner_history_search_view" model="ir.ui.view">
        <field name="model">partner.history</field>
        <field name="arch" type="xml">
            <search string="Partner history">
                <field name="partner_id"/>
                <field name="date"/>
                <field name="location"/>
                <field name="type_id"/>
                <field name="risk_ids"/>
                <newline/>
                <group expand="0" string="Group By...">
                    <filter name="partner_id" string="User" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="partner_history_action" model="ir.actions.act_window">
        <field name="name">Partner history</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">partner.history</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="partner_history_search_view"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define a new record
            </p>
        </field>
    </record>
</odoo>
