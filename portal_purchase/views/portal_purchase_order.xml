<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_purchase_orders" inherit_id="purchase.portal_my_purchase_orders">
        <xpath expr="//thead/tr" position="inside">
            <th>Invoice</th>
        </xpath>
        <xpath expr="//tbody/t/tr" position="inside">
            <td>
                <t t-if="order.supplier_invoice_number">
                    <span t-esc="order.supplier_invoice_number"/>
                </t>
            </td>
        </xpath>
        <xpath expr="//i[hasclass('fa-remove')]/../.." position="after">
            <t t-if="order.state == 'purchase'">
                <span class="badge badge-primary"><i class="fa fa-fw fa-check"/> Confirmed</span>
            </t>
        </xpath>
    </template>
    <template id="portal_my_purchase_order" inherit_id="purchase.portal_my_purchase_order">
        <xpath expr="//h4" position="attributes">
            <attribute name="class">pull-left mb0</attribute>
        </xpath>
        <xpath expr="//h4" position="after">
            <div class="pull-right ml-3">
                <t t-if="order.supplier_invoice_number">
                    <a t-attf-href="#o_ppo_invoice_upload" class="btn btn-secondary btn-sm"><i class="fa fa-file-text-o"></i> Supplier invoice</a>
                </t>
                <t t-else="">
                    <a t-attf-href="#o_ppo_invoice_upload" class="btn btn-primary btn-sm"><i class="fa fa-upload"></i> Upload invoice</a>
                </t>
            </div>
        </xpath>
        <xpath expr="//div[hasclass('card')]" position="after">
            <div id="o_ppo_invoice_upload" class="card mt-4">
                <div class="card-header">
                    <h4 class="mb0">Supplier invoice</h4>
                </div>
                <div class="card-body">
                    <t t-if="order.supplier_invoice_number">
                        <div class="mb8">
                            <strong>Number:</strong> <span t-field="order.supplier_invoice_number"/>
                        </div>
                        <div class="mb8">
                            <strong>Date:</strong> <span t-field="order.supplier_invoice_date" t-field-options="{'widget':'date'}"/>
                        </div>
                        <div class="mb8">
                            <a t-attf-href="/web/content/?model=purchase.order&amp;id=#{ order.id }&amp;filename_field=supplier_invoice_number&amp;field=supplier_invoice_file&amp;download=true&amp;filename=#{ order.supplier_invoice_number }"><i class="fa fa-download"></i> Download invoice</a>
                        </div>
                    </t>
                    <t t-else="">
                        <p>Fill invoice data and file for this purchase order.</p>
                        <form id="o_pp_invoice_upload_form" t-attf-action="/my/upload_purchase_invoice/#{ order.id }" enctype="multipart/form-data" method="post">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <input type="hidden" name="order_id" t-att-value="order.id"/>
                            <div class="form-group">
                                <label for="name">Number</label>
                                <input type="text" class="form-control" name="supplier_invoice_number" placeholder="Invoice number" required="required"/>
                            </div>
                            <div class="form-group">
                                <label for="name">Date</label>
                                <input type="date" class="form-control" name="supplier_invoice_date" placeholder="Invoice date" required="required"/>
                            </div>
                            <div class="form-group">
                                <label>Invoice</label>
                                <input name="supplier_invoice_file" class="form-control file" type="file" multiple="true" data-show-upload="true" data-show-caption="true" lass="file" data-show-preview="true" required="required"/>
                            </div>
                            <button type="submit" class="btn btn-primary">Send invoice</button>
                        </form>
                    </t>
                </div>
            </div>
        </xpath>
        <xpath expr="//span[@t-field='order.date_order']/.." position="after">
            <div class="mb8">
                <strong>Invoice</strong>
                <t t-if="order.invoice_count > 0">
                    <t t-foreach="order.invoice_ids" t-as="invoice_id">
                        <span t-esc="invoice_id.number"/>
                    </t>
                </t>
            </div>
        </xpath>
    </template>
</odoo>
