<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_timesheet_table" inherit_id="hr_timesheet.portal_timesheet_table">
        <xpath expr="//thead/tr" position="inside">
            <th class="text-end">Real time</th>
        </xpath>
        <xpath expr="(//td[hasclass('text-end')])[last()]" position="after">
            <td class="text-end"><span t-field="timesheet.real_time" t-options='{"widget": "float_time"}'/></td>
        </xpath>
    </template>
</odoo>
