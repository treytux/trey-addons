<?xml version="1.0" encoding="UTF-8"?>
<odoo>
<record id="wizard_account_invoice_assign_number_invoice_form" model="ir.ui.view">
    <field name="model">account.invoice.assign.date.invoice</field>
    <field name="inherit_id" ref="account_invoice_assign_date_invoice.wizard_account_invoice_assign_date_invoice_form"/>
    <field name="arch" type="xml">
        <xpath expr="//field[@name='date_invoice']" position="after" >
            <field name="number_invoice"/>
        </xpath>
    </field>
</record>
</odoo>
