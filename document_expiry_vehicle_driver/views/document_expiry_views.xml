<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="document_expiry_form_view" model="ir.ui.view">
        <field name="model">document.expiry</field>
        <field name="inherit_id" ref="document_expiry.document_expiry_form_view"/>
        <field name="arch" type="xml">
            <field name="document_type" position="after">
                <field name="driver_id" attrs="{'required': [('document_type', 'in', ['community', 'transportation', 'london'])], 'invisible': [('document_type', 'not in', ['community', 'transportation', 'london'])]}"/>
            </field>
        </field>
    </record>
    <record id="view_document_expiry_driver_tree" model="ir.ui.view">
        <field name="model">document.expiry</field>
        <field name="type">tree</field>
        <field name="arch" type="xml">
            <tree string="Document Expiry" editable="top" decoration-danger="color == 'red'" decoration-success="color == 'green'" decoration-muted="color == 'gray'" decoration-info="color == 'blue'" decoration-primary="color == 'purple'" decoration-warning="color == 'brown'">
                <field name="owner_type" invisible="True"/>
                <field name="driver_id" required="True" options="{'no_create': True, 'no_open': True}"/>
                <field name="vehicle_id"/>
                <field name="document_type_driver" required="True"/>
                <field name="document_name" attrs="{'required': [('document_type_driver', 'in', ['custom', 'attachment'])]}"/>
                <field name="attachment_id" attrs="{'invisible': [('document_type_driver', '!=', 'attachment')], 'required': [('document_type_driver', '=', 'attachment')]}"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="status_id" widget="label_selection"/>
                <field name="color" invisible="True"/>
            </tree>
        </field>
    </record>
    <record id="view_document_expiry_search" model="ir.ui.view">
        <field name="model">document.expiry</field>
        <field name="inherit_id" ref="document_expiry.view_document_expiry_search"/>
        <field name="arch" type="xml">
            <field name="end_date" position="after">
                <field name="driver_id"/>
            </field>
            <filter name="status_id" position="after">
                <filter name="driver_id" string="Driver" context="{'group_by': 'driver_id'}"/>
            </filter>
        </field>
    </record>
    <record id="action_driver_document_expiry" model="ir.actions.act_window">
        <field name="name">Drivers</field>
        <field name="res_model">document.expiry</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_type">form</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('owner_type', '=', 'driver')]</field>
        <field name="context">{'default_owner_type': 'driver'}</field>
        <field name="view_id" ref="document_expiry_vehicle_driver.view_document_expiry_driver_tree"/>
        <field name="search_view_id" ref="document_expiry.view_document_expiry_search"/>
    </record>
    <menuitem
            id="menu_document_expiry_driver"
            name="Drivers"
            parent="document_expiry_vehicle.menu_document_expiry_vehicle_menu"
            action="action_driver_document_expiry"
            groups="document_expiry.group_document_expiry_user"
    />
    <menuitem id="menu_document_expiry_knowledge_vehicle"
              name="Drivers"
              action="action_driver_document_expiry"
              parent="document_expiry.menu_document_expiry"
              sequence="50"
              groups="document_expiry.group_document_expiry_user"/>
</odoo>
