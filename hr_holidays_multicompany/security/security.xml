<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data>
        <record model="ir.rule" id="hr_holidays_multicompany">
            <field name="name">hr.holidays multi-company</field>
            <field name="model_id" ref="hr_holidays.model_hr_holidays"/>
            <field name="domain_force">
                ['|', ('company_id', 'child_of', [user.company_id.id]), ('company_id', '=',False)]
            </field>
        </record>
        <record model="ir.rule" id="hr_holidays_status_multicompany">
            <field name="name">hr.holidays.status multi-company</field>
            <field name="model_id" ref="hr_holidays.model_hr_holidays_status"/>
            <field name="domain_force">
                ['|', ('company_id', 'child_of', [user.company_id.id]), ('company_id', '=',False)]
            </field>
        </record>
    </data>
</openerp>
