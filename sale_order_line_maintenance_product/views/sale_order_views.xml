<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/tree//field[@name='product_id']" position="before">
                <field name="is_not_increases_maintenance_price"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/form//field[@name='customer_lead']/.." position="after">
                <field name="is_not_increases_maintenance_price"/>
            </xpath>
            <field name="order_line" position="before">
                <field invisible="1" name="maintenance_active"/>
                <div class="btn-group">
                    <button name="disable_maintenance" string="Disable maintenance" type="object" attrs="{'invisible': [('maintenance_active', '=', False)]}"/>
                    <button name="enable_maintenance" string="Enable maintenance" type="object" attrs="{'invisible': [('maintenance_active', '=', True)]}"/>
                </div>
            </field>
        </field>
    </record>
</odoo>
