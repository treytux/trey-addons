<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="document_expiry_form_view" model="ir.ui.view">
        <field name="model">document.expiry</field>
        <field name="inherit_id" ref="document_expiry.document_expiry_form_view"/>
        <field name="arch" type="xml">
            <field name="document_type" position="after">
                <field name="inspection_needed" invisible="True"/>
                <field name="inspection_id" attrs="{'required': [('inspection_needed', '=', True)], 'invisible': [('inspection_needed', '=', False)]}"/>
            </field>
        </field>
    </record>
    <record id="view_document_expiry_vehicle_tree" model="ir.ui.view">
        <field name="model">document.expiry</field>
        <field name="inherit_id" ref="document_expiry_vehicle.view_document_expiry_vehicle_tree"/>
        <field name="type">tree</field>
        <field name="arch" type="xml">
            <field name="document_type" position="after">
                <field name="inspection_needed" invisible="1"/>
                <field name="inspection_id" attrs="{'required': [('inspection_needed', '=', True)], 'invisible': [('inspection_needed', '=', False)]}"/>
            </field>
        </field>
    </record>
    <record id="view_document_expiry_search" model="ir.ui.view">
        <field name="model">document.expiry</field>
        <field name="inherit_id" ref="document_expiry.view_document_expiry_search"/>
        <field name="arch" type="xml">
            <field name="end_date" position="after">
                <field name="inspection_id"/>
            </field>
            <filter name="status_id" position="after">
                <filter name="inspection_id" string="Inspection" context="{'group_by': 'inspection_id'}"/>
            </filter>
        </field>
    </record>
</odoo>
