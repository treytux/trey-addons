<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="product" inherit_id="website_sale.product">
        <xpath expr="//div[hasclass('js_product')]" position="inside">
            <div class="js_wssl_variant_stocks mb-3">
                <div class="js_wssl_out_of_stock fw-bold d-none">Out of stock.</div>
                <t t-foreach="variants_stock" t-as="variant_stock">
                    <div class="js_wssl_variant_stock d-none" t-att-data-product_id="variants_stock[variant_stock]['variant_id']">
                        <t t-foreach="variants_stock[variant_stock]['locations']" t-as="location">
                            <div class="js_wssl_location_quantity">
                                <t t-if="website.show_product_stock_info(request.env.user)">
                                    <span class="js_wssl_location_quantity_quantity fw-bold" t-esc="variants_stock[variant_stock]['locations'][location]['quantity']"/>
                                    <span class="js_wssl_location_quantity_uom fw-bold" t-esc="variants_stock[variant_stock]['locations'][location]['product_uom_name']"/>
                                </t>
                                <t t-if="website.show_product_stock_location(request.env.user)">
                                    in
                                    <span class="js_wssl_location_quantity_location fw-bold" t-esc="variants_stock[variant_stock]['locations'][location]['location_name']"/>
                                </t>
                            </div>
                        </t>
                    </div>
                </t>
            </div>
        </xpath>
    </template>
</odoo>
