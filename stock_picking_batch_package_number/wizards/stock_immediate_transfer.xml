<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_immediate_transfer" model="ir.ui.view">
        <field name="model">stock.immediate.transfer</field>
        <field name="inherit_id" ref="stock.view_immediate_transfer"/>
        <field name="arch" type="xml">
            <xpath expr="//footer" position="before">
                <span colspan="4" attrs="{'invisible': [('hide_line_ids', '=', True)]}">Enter the number of packages corresponding to each picking</span>
                <separator/>
                <group>
                    <field name="hide_line_ids" invisible="1"/>
                    <field name="line_ids" colspan="4" nolabel="1" attrs="{'invisible': [('hide_line_ids', '=', True)]}">
                        <tree editable="bottom" create="0" edit="1" delete="0">
                            <field name="picking_id" readonly="1"/>
                            <field name="number_of_packages"/>
                        </tree>
                    </field>
                </group>
            </xpath>
            <xpath expr="//field[@name='number_of_packages']" position="attributes">
                <attribute name="attrs">{'invisible': ['|', ('hide_line_ids', '=', False), '&amp;', ('hide_line_ids', '=', True), ('package_number_required', '=', False)]}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
