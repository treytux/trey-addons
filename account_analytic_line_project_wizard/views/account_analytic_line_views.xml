<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_analytic_line_filter" model="ir.ui.view">
        <field name="model">account.analytic.line</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_line_filter"/>
        <field name="arch" type="xml">
            <field name="account_id" position="after">
                <field name="task_id"/>
                <field name="project_id"/>
                <field name="supplier_id"/>
                <filter string="To Invoice" domain="[('task_state', '=', 'to_invoice')]" name="to_invoice"/>
                <filter string="Not Billable" domain="[('task_state', '=', 'not_billable')]" name="not_billable"/>
                <filter string="Invoiced" domain="[('task_state', '=', 'invoiced')]" name="invoiced"/>
                <filter string="Settled" domain="[('task_state', '=', 'settled')]" name="settled"/>
            </field>
            <filter name="group_date" position="after">
                <filter string="Project" context="{'group_by': 'project_id'}" name="project_group"/>
                <filter string="Supplier" context="{'group_by': 'supplier_id'}" name="supplier_group"/>
                <filter string="Task" context="{'group_by': 'task_id'}" name="task_group"/>
                <filter string="Stage" context="{'group_by': 'stage_id'}" name="stage_group"/>
                <filter string="State" context="{'group_by': 'task_state'}" name="task_state_group"/>
            </filter>
        </field>
    </record>
    <record id="view_task_to_invoice_line_filter" model="ir.ui.view">
        <field name="model">account.analytic.line</field>
        <field name="arch" type="xml">
            <search string="Search Analytic Lines">
                <field name="name"/>
                <field name="date"/>
                <field name="account_id"/>
                <field name="plan_id"/>
                <field name="task_id"/>
                <field name="project_id"/>
                <field name="supplier_id"/>
                <filter string="To Invoice" domain="[('task_state', '=', 'to_invoice')]" name="task_to_invoice"/>
                <filter string="Not Billable" domain="[('task_state', '=', 'not_billable')]" name="task_not_billable"/>
                <filter string="Invoiced" domain="[('task_state', '=', 'invoiced')]" name="task_invoiced"/>
                <filter string="Settled" domain="[('task_state', '=', 'settled')]" name="task_settled"/>
                <filter string="Date" name="date" date="date"/>
                <filter string="Analytic Account" name="group_by_analytic_account" context="{'group_by': 'account_id'}"/>
                <filter string="Analytic Plan" name="group_by_analytic_plan" context="{'group_by': 'plan_id'}"/>
                <group string="Group By..." expand="0" name="groupby">
                    <filter string="Date" context="{'group_by': 'date'}" name="group_date"/>
                    <filter string="Project" context="{'group_by': 'project_id'}" name="group_project"/>
                    <filter string="Supplier" context="{'group_by': 'supplier_id'}" name="group_supplier"/>
                    <filter string="Task" context="{'group_by': 'task_id'}" name="group_task"/>
                    <filter string="Stage" context="{'group_by': 'stage_id'}" name="group_stage"/>
                    <filter string="State" context="{'group_by': 'task_state'}" name="group_task_state"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_account_analytic_line_tree" model="ir.ui.view">
        <field name="model">account.analytic.line</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_line_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="project_id" optional="hide"/>
                <field name="task_id" optional="show"/>
                <field name="stage_id" optional="hide"/>
                <field name="supplier_id" optional="hide"/>
            </field>
            <field name="amount" position="after">
                <field name="task_invoice_id" optional="show"/>
                <field name="task_state" optional="show"/>
            </field>
        </field>
    </record>
    <record model="ir.actions.act_window" id="action_view_task_to_invoice">
        <field name="name">Analytic Items</field>
        <field name="res_model">account.analytic.line</field>
        <field name="view_mode">tree,kanban,form,graph,pivot</field>
        <field name="view_id" ref="view_account_analytic_line_tree"/>
        <field name="search_view_id" ref="view_task_to_invoice_line_filter"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">
                No activity yet
            </p>
        </field>
    </record>
    <menuitem name="Invoice Tasks" id="menu_invoice_tasks"
        parent="project.menu_main_pm"
        action="action_view_task_to_invoice"
        sequence="3"
        groups="analytic.group_analytic_accounting"/>
</odoo>
