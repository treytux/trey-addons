#. module: vending_machine
#: model:mail.template,body_html:vending_machine.email_template_vending_machine_replenish
msgid ""
"<div>\n"
"                    <p>Dear,</p>\n"
"                    <p>A replenishment quote named <strong>${ctx."
"get('sale_order_name', '')}</strong> has been generated for vending machine "
"${object.name}.</p>\n"
"                    <p>Please review the details and proceed with the "
"corresponding replenishment.</p>\n"
"                    <p>Best regards,</p>\n"
"                    <p>This is an automated message, please do not reply.</"
"p>\n"
"                </div>\n"
"            "
msgstr ""
"<div>\n"
"                    <p>Estimado/a</p>\n"
"                    <p>Se ha generado una cotización de reposición con el "
"nombre <strong>${ctx.get('sale_order_name', '')}</strong> para la máquina "
"expendedora ${object.name}.</p>\n"
"                    <p>Por favor, revise los detalles y proceda con la "
"reposición correspondiente.</p>\n"
"                    <p>Saludos cordiales,</p>\n"
"                    <p>Este es un mensaje automatizado, por favor no "
"respondas.</p>\n"
"\t\t</div>\n"
"             "

