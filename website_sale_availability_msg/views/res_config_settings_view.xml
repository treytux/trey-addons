<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <div id="sale_product_catalog_settings" position="inside">
                <div class="col-12 o_setting_box" id="stock_field_setting">
                    <div class="o_setting_right_pane">
                        <label string="Stock Field" for="stock_field"/>
                        <div class="text-muted">Field used to determine product availability message</div>
                        <field name="stock_field"/>
                    </div>
                </div>
            </div>
        </field>
    </record>
</odoo>
