<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <field name="state" position="before">
                <field name="show_button_simulate_reyher" invisible="True"/>
                <button name="action_simulator_sale_reyher" string="Simulate Reyher"
                    attrs="{'invisible': [('show_button_simulate_reyher', '=', False)]}" type="object" groups="base.group_user"/>
            </field>
        </field>
    </record>
</odoo>
