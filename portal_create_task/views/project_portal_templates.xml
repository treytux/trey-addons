<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_project" inherit_id="project.portal_my_project">
        <xpath expr="//t[@t-call='portal.portal_searchbar']" position="inside">
            <span class="float-right ms-2">
                <a role="button" t-attf-href="/my/projects/#{ project.id }/task/new" class="btn btn-sm btn-secondary">
                    <span class="fa fa-plus-circle" role="img" aria-label="Task" title="New Task"/>
                    Create task
                </a>
            </span>
        </xpath>
    </template>
    <template id="portal_create_task_form" name="Portal Create Task">
        <t t-call="portal.portal_layout">
            <div class="mt-3">
                <h2>
                    New task on <t t-esc="project.display_name"/>
                </h2>
                <t t-if="error">
                    <div class="alert alert-danger" t-esc="error"/>
                </t>
                <form t-att-action="'/my/projects/%s/task/new' % project.id" method="post">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input type="text" name="name" class="form-control" t-att-value="default_name" required="required"/>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea name="description" class="form-control" rows="3"><t t-esc="default_description"/></textarea>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="fa fa-check me-1"/> Create
                        </button>
                        <a t-att-href="'/my/projects/%s' % project.id" class="btn btn-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </t>
    </template>
</odoo>
