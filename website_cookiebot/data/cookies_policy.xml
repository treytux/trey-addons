<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data noupdate="1">
        <template name="Cookies Policy" id="cookies_policy" page="True">
            <t t-if="website.cookiebot_id" t-call="website.layout">
                <div id="wrap">
                    <div class="oe_structure">
                        <section data-snippet-id="title">
                            <h1 class="text-center">Cookie Declaration</h1>
                        </section>
                    </div>
                    <section class="mb-5 mt-5">
                        <div class="container">
                            <div class="row">
                                <div class="col-md-12">
                                    <script id="CookieDeclaration" t-attf-src="https://consent.cookiebot.com/{{website.cookiebot_id}}/cd.js" type="text/javascript" async="async"></script>
                                </div>
                            </div>
                        </div>
                    </section>
                    <div class="oe_structure"/>
                </div>
            </t>
        </template>
    </data>
</openerp>
