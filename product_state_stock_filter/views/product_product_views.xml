<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_inventory_valuation_search_filter_extension" model="ir.ui.view">
        <field name="model">stock.valuation.layer</field>
        <field name="inherit_id" ref="stock_account.view_inventory_valuation_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='has_remaining_qty']" position="after">
                <filter string="Hide Obsolete" name="hide_obsolete"
                        domain="[('product_id.product_tmpl_id.state', '!=', 'obsolete')]"/>
                <filter string="Hide In Development" name="hide_draft"
                        domain="[('product_id.product_tmpl_id.state', '!=', 'draft')]"/>
                <filter string="Hide End of Lifecycle" name="hide_end"
                        domain="[('product_id.product_tmpl_id.state', '!=', 'end')]"/>
                <filter string="Hide Normal" name="hide_sellable"
                        domain="[('product_id.product_tmpl_id.state', '!=', 'sellable')]"/>
            </xpath>
        </field>
    </record>
</odoo>
