<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="mail_template_update_reports" model="mail.template">
        <field name="name">Project: Update Reports</field>
        <field name="model_id" ref="project.model_project_update"/>
        <field name="subject">Update Report of {{object.name}}</field>
        <field name="email_from">{{ (object.user_id.email_formatted or object.company_id.email_formatted or user.email_formatted) }}</field>
        <field name="partner_to">{{ object.project_id.partner_id.id }}</field>
        <field name="description">Sent to partner</field>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <p style="margin: 0px; padding: 0px; font-size: 12px;">
                    Hello <span style="font-weight:bold;" t-out="object.project_id.partner_id.name"/>,
                    <br/><br/>
                    This is the update report of <span style="font-weight:bold;" t-out="object.name"/>
                    <br/><br/>
                    <hr/>
                    <t t-out="user.signature or ''">-- <br/><t t-out="user.name"/></t>
                    <br/><br/>
                </p>
            </div>
        </field>
        <field name="report_template" ref="report_project_update_create"/>
        <field name="report_name">{{ (object.name or '').replace('/','_') }}</field>
        <field name="lang">{{ object.user_id.lang }}</field>
        <field name="auto_delete" eval="True"/>
    </record>
</odoo>
