#. module: hr_timesheet_employee_report
#: model:mail.template,body_html:hr_timesheet_employee_report.email_template_employee_timesheet_report
msgid ""
"\n"
"            \n"
"                <div style=\"font-family: Arial, sans-serif; font-size: 14px; color: #333;\">\n"
"                    <t t-if=\"ctx['report_lines']\">\n"
"                        <table style=\"border-collapse: collapse; width: auto; min-width: 900px; margin-top: 20px; margin-bottom: 20px;\">\n"
"                            <thead>\n"
"                                <tr style=\"background-color: #f2f2f2;\">\n"
"                                    <th style=\"border-bottom: 1px solid #c7c7c7; padding: 10px; text-align: left;\">Employee</th>\n"
"                                    <th style=\"border-bottom: 1px solid #c7c7c7; padding: 10px; text-align: right;\">Hours (<t t-out=\"ctx['cur_month_label']\"/>)</th>\n"
"                                    <th style=\"border-bottom: 1px solid #c7c7c7; padding: 10px; text-align: right;\">Hours (<t t-out=\"ctx['prev_month_label']\"/>)</th>\n"
"                                    <th style=\"border-bottom: 1px solid #c7c7c7; padding: 10px; text-align: right;\">% Variation</th>\n"
"                                    <th style=\"border-bottom: 1px solid #c7c7c7; padding: 10px; text-align: right;\">Worked / Absence hours</th>\n"
"                                </tr>\n"
"                            </thead>\n"
"                            <tbody>\n"
"                                <t t-foreach=\"ctx['report_lines']\" t-as=\"line\">\n"
"                                    <tr>\n"
"                                        <td style=\"border-bottom: 1px solid #e7e7e7; padding: 8px;\">\n"
"                                            <t t-out=\"line.get('employee_name', 'N/A')\"/>\n"
"                                        </td>\n"
"                                        <td style=\"border-bottom: 1px solid #e7e7e7; padding: 8px; text-align: right;\">\n"
"                                            <span style=\"color: #999;\"><t t-out=\"'%.2f' % line.get('cur_month_hours', 0.0)\"/> / </span>\n"
"                                            <t t-out=\"'%.2f' % line.get('cur_month_real_time', 0.0)\"/>\n"
"                                        </td>\n"
"                                        <td style=\"border-bottom: 1px solid #e7e7e7; padding: 8px; text-align: right;\">\n"
"                                            <span style=\"color: #999;\"><t t-out=\"'%.2f' % line.get('prev_month_hours', 0.0)\"/> / </span>\n"
"                                            <t t-out=\"'%.2f' % line.get('prev_month_real_time', 0.0)\"/>\n"
"                                        </td>\n"
"                                        <td style=\"border-bottom: 1px solid #e7e7e7; padding: 8px; text-align: right;\">\n"
"                                            <t t-set=\"variation_pct\" t-value=\"line.get('variation_pct')\"/>\n"
"                                            <span t-att-style=\"\n"
"                                                'color: #28a745;'\n"
"                                                if variation_pct and variation_pct > 0\n"
"                                                else 'color: #dc3545;'\n"
"                                                if variation_pct and variation_pct < 0\n"
"                                                else 'color: #333;'\n"
"                                            \">\n"
"                                                <t t-out=\"'N/A' if variation_pct is None else '%+.2f%%' % variation_pct\"/>\n"
"                                            </span>\n"
"                                        </td>\n"
"                                        <td style=\"border-bottom: 1px solid #e7e7e7; padding: 8px; text-align: right;\">\n"
"                                            <t t-out=\"'%.2f' % line.get('net_available_hours_month', 0.0)\"/>\n"
"                                            <span style=\"color: #999;\"> / <t t-out=\"'%.2f' % line.get('absence_hours_month', 0.0)\"/></span>\n"
"                                        </td>\n"
"                                    </tr>\n"
"                                </t>\n"
"                            </tbody>\n"
"                        </table>\n"
"                    </t>\n"
"                    <t t-else=\"\">\n"
"                        <p>No timesheet data found for the specified period.</p>\n"
"                    </t>\n"
"                </div>\n"
"            \n"
"        "
msgstr ""

