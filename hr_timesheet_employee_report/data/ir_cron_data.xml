        <field name="model_id" ref="hr_timesheet_employee_report.model_timesheet_report_sender"/>
        <field name="state">code</field>
        <field name="code">model._send_employee_timesheet_report_email()</field>
        <field name="user_id" ref="base.user_root"/>
