<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="template_stock_lot" model="import.template">
        <field name="name">Stock lot template</field>
        <field name="model_id" ref="import_template_stock_lot.model_import_template_stock_lot"/>
        <field name="has_simulation" eval="True"/>
        <field name="description" type="html">
            <p>
                <font style="font-size: 12px;">The file to import must contain the following columns with these names:
                </font>
            </p>
            <ul>
                <li>
                    <b><font style="font-size: 12px;">name: </font></b><font style="font-size: 12px;">lot name or serial number.</font>
                </li>
                <li>
                    <b><font style="font-size: 12px;">product_id: </font></b><font style="font-size: 12px;">product's default code or barcode that must be previously created in Odoo.This column can be omitted if the batch already exists in the system.</font>
                </li>
            </ul>
            <p>
                <font style="font-size: 12px;">If you wish you can add fields setting the name of the field as the column name. To see the name of the fields you must activate developer mode from the Settings/General Settings/Developer tools/Activate developer.
                </font>
            </p>
        </field>
        <field name="template_file" type="base64"
               file="import_template_stock_lot/data/template_stock_lot.xlsx"/>
    </record>
</odoo>
