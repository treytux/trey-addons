<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="ir_model_log_tree" model="ir.ui.view">
        <field name="model">ir.model.log</field>
        <field name="arch" type="xml">
            <tree string="Logs">
                <field name="name"/>
                <field name="res_model"/>
                <field name="date_start"/>
                <field name="elapsed"/>
            </tree>
        </field>
    </record>
    <record id="ir_model_log_search" model="ir.ui.view">
        <field name="model">ir.model.log</field>
        <field name="arch" type="xml">
            <search string="Logs">
                <field name="name"/>
                <newline/>
                <filter name="res_model" string="Model" domain="[]" context="{'group_by':'res_model'}"/>
            </search>
        </field>
    </record>
    <record id="ir_model_log_form" model="ir.ui.view">
        <field name="model">ir.model.log</field>
        <field name="arch" type="xml">
            <form string="Logs">
                <header></header>
                <sheet string="Logs">
                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_view_records" class="oe_stat_button" icon="fa-th-list">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="res_ids_count"/>
                                </span>
                                <span class="o_stat_text">Records</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title" colspan="4">
                        <h1>
                            <field name="name"/>
                        </h1>
                        <group>
                            <field name="res_model" readonly="1"/>
                        </group>
                    </div>
                    <group>
                        <group string="Dates">
                            <field name="date_start"/>
                            <field name="date_finish"/>
                            <field name="elapsed"/>
                        </group>
                        <group/>
                        <group name="description" string="Description" colspan="4">
                            <field name="description" widget="html" nolabel="1" colspan="2"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
                    <field name="message_ids" widget="mail_thread"/>
                    <field name="activity_ids" widget="mail_activity"/>
                </div>
            </form>
        </field>
    </record>
    <record id="ir_model_log_action" model="ir.actions.act_window">
        <field name="name">Logs</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ir.model.log</field>
        <field name="view_mode">tree,form,activity</field>
        <field name="search_view_id" ref="ir_model_log_search"/>
    </record>
</odoo>
