<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('app_settings_block') and @data-key='hr']" position="inside">
                <h2>Reports</h2>
                <div class="row mt16 o_settings_container">
                    <div class="col-12 col-lg-12 o_setting_box" title="PPE Report Notes">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="employee_ppe_notes"/>
                            <div class="text-muted">
                                Comments and observations shown in employee's PPE report.
                            </div>
                            <field name="employee_ppe_notes"/>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
