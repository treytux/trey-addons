<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="connector_supplier_form_view" model="ir.ui.view">
        <field name="model">connector.supplier</field>
        <field name="arch" type="xml">
            <form string="Connector supplier">
                <group name="connector_name_base">
                    <field name="name"/>
                    <field name="supplier_id"/>
                    <field name="supplier_mode"/>
                </group>
                <group name="connector_credentials_base">
                    <field name="username_ws"/>
                    <field name="password_ws"/>
                </group>
            </form>
        </field>
    </record>
    <record id="connector_supplier_tree_view" model="ir.ui.view">
        <field name="model">connector.supplier</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
            </tree>
        </field>
    </record>
    <record id="connector_supplier_action" model="ir.actions.act_window">
        <field name="name">Connectors</field>
        <field name="res_model">connector.supplier</field>
        <field name="view_type">form</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="connector_supplier_menu"
        name="Connectors"
        action="connector_supplier_action"
        parent="purchase.menu_purchase_control"
        sequence="99"/>
</odoo>
