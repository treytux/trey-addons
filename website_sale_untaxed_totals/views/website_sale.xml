<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data>
        <template id="total" inherit_id="website_sale.total">
            <xpath expr="//tr[@id='order_total_taxes']" position="before">
                <tr width="120" class="text-muted" id="order_total_untaxed">
                    <td><abbr title="Total before taxes">Total untaxed:</abbr></td>
                    <td class="text-right">
                        <span t-field="website_sale_order.amount_untaxed" style="white-space: nowrap;" t-field-options='{
                            "widget": "monetary",
                            "from_currency": "website_sale_order.pricelist_id.currency_id",
                            "display_currency": "user_id.partner_id.property_product_pricelist.currency_id"
                        }'/>
                    </td>
                </tr>
            </xpath>
        </template>
    </data>
</openerp>
