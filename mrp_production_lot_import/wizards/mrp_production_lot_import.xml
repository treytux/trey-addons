<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="import_production_lots_wizard_view" model="ir.ui.view" >
        <field name="model">import.production.lots.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Lots/Serials">
                <group name="file" colspan="4">
                    <field name="data_file"/>
                </group>
                <footer>
                    <button name="produce_move_lines" class="oe_highlight"
                            type="object"
                            string="Produce"/>
                    <button class="oe_link" special="cancel" string="Close"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="import_production_lots_action" model="ir.actions.act_window">
        <field name="name">Import Lots/Serials</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">import.production.lots.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="import_production_lots_wizard_view"/>
        <field name="target">new</field>
    </record>
</odoo>
