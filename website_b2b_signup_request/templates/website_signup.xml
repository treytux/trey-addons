<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="signup_form_customize_show" inherit_id="auth_signup.signup" name="Show B2B Signup Form" customize_show="True" active="True">
        <xpath expr="//form" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//form" position="after">
            <t t-set="additional_title">Signup Form</t>
            <h1 class="text-center mt-5">Signup Request</h1>
            <p class="text-center">Please, fill out the signup form to request register in our website.</p>
            <section class="container">
                <form action="/website/form/" method="post" data-model_name="crm.lead" class="oe_signup_form s_website_form" data-success-mode="redirect" data-success-page="/contactus-thank-you" enctype="multipart/form-data" data-editable-form="false">
                    <input type="hidden" name="csrf_token"
                        t-att-value="request.csrf_token()"
                        t-nocache="The csrf token must always be up to date."/>
                    <input type="hidden" name="name" value="Signup Request"/>
                    <div class="mb-3 field-name">
                        <label for="contact_name">Your Name</label>
                        <input type="text" id="contact_name" class="form-control form-control-sm" autofocus="autofocus" name="contact_name" t-att-value="request.params.get('contact_name', '')" required=""/>
                    </div>
                    <div class="mb-3">
                        <label for="phone">Phone Number</label>
                        <input type="tel" id="phone" class="form-control form-control-sm" autofocus="autofocus" name="phone" required="" t-att-value="request.params.get('phone', '')"/>
                    </div>
                    <div class="mb-3 field-login">
                        <label for="email_from">Email</label>
                        <input type="email" id="email_from" class="form-control form-control-sm" autofocus="autofocus" name="email_from" required="" t-att-value="request.params.get('email_from', '')"/>
                    </div>
                    <div class="mb-3">
                        <label for="partner_name">Company</label>
                        <input type="text" id="partner_name" class="form-control form-control-sm" autofocus="autofocus" name="partner_name" required="" t-att-value="request.params.get('partner_name', '')"/>
                    </div>
                    <div class="mb-3">
                        <label for="vat">VAT</label>
                        <input type="text" id="vat" class="form-control form-control-sm" autofocus="autofocus" name="vat" required="" t-att-value="request.params.get('vat', '')"/>
                    </div>
                    <div class="mb-3">
                        <label for="description">Coments</label>
                        <textarea id="description" class="form-control form-control-sm" autofocus="autofocus" name="description"><t t-esc="request.params.get('description', '')"/></textarea>
                    </div>
                    <t t-foreach="kwargs" t-as="kwarg">
                        <input type="hidden" t-att-name="kwarg[0]" t-att-value="kwarg[1]"/>
                    </t>
                    <button type="submit" class="btn btn-primary"> Send</button>
                    <span id="s_website_form_result"></span>
                </form>
            </section>
        </xpath>
    </template>
</odoo>
