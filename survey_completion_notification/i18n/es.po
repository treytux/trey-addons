#. module: survey_completion_notification
#. odoo-python
#: code:addons/survey_completion_notification/models/res_config_settings.py:0
#: model:ir.model.fields,help:survey_completion_notification.field_res_config_settings__survey_notify
#, python-format
msgid ""
"\n"
"            If checked, an email notification will be\n"
"            sent to followers when a survey is completed.\n"
"        "
msgstr ""
"\n"
"            Si está marcado, se enviará una notificación por correo\n"
"            a los seguidores cuando se complete una encuesta.\n"
"        "

#. module: survey_completion_notification
#: model:mail.template,body_html:survey_completion_notification.email_template_survey_completed
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        The survey <strong><t t-out=\"object.survey_id.title\"></t></strong> has been successfully completed by\n"
"                        <strong><t t-out=\"object.partner_id.email or object.email or 'an anonymous user'\"></t></strong>.\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        La encuesta <strong><t t-out=\"object.survey_id.title\"></t></strong> ha sido completada satisfactoriamente por\n"
"                        <strong><t t-out=\"object.partner_id.email or object.email or 'un usuario anónimo'\"></t></strong>.\n"
"                    </p>\n"
"                </div>\n"
"            "

