<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="Surveys" string="Surveys" data-key="survey">
                    <h2>Survey Notifications</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box" id="notify_survey_completion">
                            <div class="o_setting_left_pane">
                                <field name="survey_notify"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="survey_notify"/>
                                <div class="text-muted">
                                    Send a notification to followers once a survey is finished
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
