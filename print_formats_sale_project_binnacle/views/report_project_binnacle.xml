    <template id="binnacle_chatter">
        <div class="row d-block" name="chatter" style="page-break-before: always">
            <div class="col-12">
                <h3>Task Chatter</h3>
                <hr/>
                <t t-foreach="doc.project_id.task_ids" t-as="task">
                    <h5><span t-field="task.name"/></h5>
                    <ul class="list-unstyled list-inline">
                        <li class="list-inline-item">Assigned to <span class="font-weight-bold" t-field="task.user_id.name"/></li>
                        <li class="list-inline-item"> Deadline <span class="font-weight-bold" t-esc="task.date_deadline" t-options="{'widget': 'date'}"/></li>
                        <li class="list-inline-item"> Last Stage Update <span class="font-weight-bold" t-esc="task.date_last_stage_update" t-options="{'widget': 'date'}"/></li>
                    </ul>
                    <table class="table table-sm mb16">
                        <thead>
                            <tr>
                                <th><span>User</span></th>
                                <th><span>Message</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="task.message_ids" t-as="msg">
                                <tr>
                                    <td>
                                        <span t-field="msg.author_id"/>
                                        <br/>
                                        (<span t-field="msg.date"/>)
                                    </td>
                                    <td>
                                        <t t-if="msg.subject">
                                            <span t-field="msg.subject"/>:
                                        </t>
                                        <t t-if="msg.message_type == 'notification'">
                                            <span t-field="msg.subtype_id.name"/>
                                            <t t-foreach='msg.sudo().tracking_value_ids' t-as='value'>
                                                <li>
                                                    <t t-esc="value.field_desc"/>:
                                                    <span> <t t-esc="value.new_value_char"/> </span>
                                                </li>
                                            </t>
                                        </t>
                                        <span t-field="msg.body"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </t>
            </div>
        </div>
    </template>
    <template id="report_project_binnacle_document">
        <t t-call="web.external_layout">
             <div class="page">
                <t t-call="print_formats_sale_project_binnacle.binnacle_information"/>
                <t t-call="print_formats_sale_project_binnacle.binnacle_summary"/>
                <t t-call="print_formats_sale_project_binnacle.binnacle_chatter"/>
            </div>
        </t>
    </template>
    <template id="report_project_binnacle">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="lang" t-value="doc.env.user.sudo().lang"/>
                <t t-call="print_formats_sale_project_binnacle.report_project_binnacle_document" t-lang="lang"/>
            </t>
        </t>
    </template>
</odoo>
