<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <report
        id="report_project_binnacle_create"
        string="Project Binnacle"
        model="sale.order"
        report_type="qweb-pdf"
        file="print_formats_sale_project_binnacle.report_project_binnacle"
        name="print_formats_sale_project_binnacle.report_project_binnacle"
    />
    <template id="binnacle_information">
        <h1 class="text-center">Project Binnacle</h1>
        <h2>
            <span t-field="doc.project_id.name"/>
        </h2>
        <div class="row mt32 mb32" id="information">
            <t t-if="doc.project_id.code">
                <div class="col-auto mw-100 mb-2">
                    <strong>Code:</strong>
                    <p class="m-0" t-field="doc.project_id.code"/>
                </div>
            </t>
            <t t-if="doc.project_id.date_start">
                <div class="col-auto mw-100 mb-2">
                    <strong>Start Date:</strong>
                    <p class="m-0" t-field="doc.project_id.date_start"/>
                </div>
            </t>
            <t t-if="doc.project_id.date">
                <div class="col-auto mw-100 mb-2">
                    <strong>Expiration Date:</strong>
                    <p class="m-0" t-field="doc.project_id.date"/>
                </div>
            </t>
            <t t-if="doc.project_id.project_group_id">
                <div class="col-auto mw-100 mb-2">
                    <strong>Group:</strong>
                    <p class="m-0" t-field="doc.project_id.project_group_id"/>
                </div>
            </t>
            <t t-if="doc.project_id.task_count">
                <div class="col-auto mw-100 mb-2">
                    <strong>Tasks:</strong>
                    <p class="m-0" t-field="doc.project_id.task_count"/>
                </div>
            </t>
            <t t-if="doc.project_id.project_status">
                <div class="col-auto mw-100 mb-2">
                    <strong>State:</strong>
                    <p class="m-0" t-field="doc.project_id.project_status"/>
                </div>
            </t>
        </div>
    </template>
