<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_saleorder_document" inherit_id="sale.report_saleorder_document">
        <xpath expr="//h2//span[contains(@t-elif, 'doc.state in')]" position="attributes">
            <attribute name="t-elif" separator=" " add="or doc.state == 'pending-approve'"/>
        </xpath>
   </template>
</odoo>
