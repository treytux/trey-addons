#. module: project_negative_balance_reminder
#: model:mail.template,body_html:project_negative_balance_reminder.email_template_negative_balance
msgid ""
"<t t-name=\"mail_template_project_alert\">\n"
"                    <p>Dear followers,</p>\n"
"                    <p>Project <strong><t t-out=\"object.name\"></t></"
"strong> has a negative balance.</p>\n"
"                    <p>Please, check this as soon as possible.</p>\n"
"                    <p>Thank you.</p>\n"
"                </t>\n"
"            "
msgstr ""
"<t t-name=\"mail_template_project_alert\">\n"
"                    <p>Estimados seguidores:</p>\n"
"                    <p>El proyecto <strong><t t-out=\"object.name\"></t></"
"strong> tiene saldo negativo.</p>\n"
"                    <p>Por favor, revisadlo lo antes posible.</p>\n"
"                    <p>Gracias.</p>\n"
"                </t>\n"
"            "

