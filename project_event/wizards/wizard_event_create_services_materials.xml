<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="wizard_event_create_services_materials" model="ir.ui.view">
        <field name="model">wizard.event.create.services.materials</field>
        <field name="arch" type="xml">
            <form string="Create services and materials">
                <h2>This action will be generate services and materials to selected events. Are you sure?</h2>
                <group>
                    <field name="line_ids">
                        <tree editable="bottom" create="false" delete="false">
                            <field name="product_id" readonly="1"/>
                            <field name="generate"/>
                        </tree>
                    </field>
                </group>
                <footer>
                    <button name="button_confirm" class="oe_highlight" type="object" string="Accept"/>
                    or
                    <button class="oe_link" special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <act_window id="wizard_event_create_services_materials_action"
        name="Generate services/materials"
        src_model="event.event"
        res_model="wizard.event.create.services.materials"
        view_mode="form"
        target="new"
        key2="client_action_multi"/>
</odoo>
