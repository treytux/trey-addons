<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="edit_project" model="ir.ui.view">
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@icon='fa-tasks']" position="after">
                <button class="oe_stat_button"
                        type="object"
                        icon="fa-ticket"
                        name="action_event_view">
                        <field string="Events" name="event_count" widget="statinfo"/>
                    </button>
            </xpath>
            <xpath expr="//page[@name='settings']" position="after">
                <page name="locations" string="Locations">
                    <group name="locations" string="Locations">
                            <field name="address_id"/>
                        </group>
                    </page>
                <page name="service_line" string="Services generator">
                    <group name="services">
                        <field name="service_line_ids" nolabel="1" attrs="{'readonly': [('not_modify_event', '=', True)]}">
                            <tree editable="bottom">
                                <field name="product_type" invisible="1"/>
                                <field string="Service" name="product_id" domain="[('type', '=', 'service')]" options="{'no_create': True, 'no_create_edit': True}"/>
                                <field name="name"/>
                                <field name="user_id" options="{'no_create': True, 'no_create_edit': True}"/>
                                <field name="quantity"/>
                            </tree>
                        </field>
                    </group>
                </page>
                <page name="product_line" string="Materials">
                    <group name="materials" string="Material">
                        <field name="product_line_ids" nolabel="1" attrs="{'readonly': [('not_modify_event', '=', True)]}">
                            <tree editable="bottom">
                                <field name="product_type" invisible="1"/>
                                <field name="product_id" domain="[('type', '!=', 'service')]" options="{'no_create': True, 'no_create_edit': True}"/>
                                <field name="name"/>
                                <field name="quantity"/>
                            </tree>
                        </field>
                    </group>
                </page>
                <page name="event_line" string="Events generator">
                    <field name="not_modify_event" invisible="1"/>
                    <group name="events" colspan="4">
                        <field name="id" invisible="1"/>
                        <group name="lines_warning" attrs="{'invisible': [('id', '!=', False)]}">
                            <h3>You must save project before to add event lines</h3>
                        </group>
                        <group name="event_lines" colspan="4">
                            <field name="event_line_ids" nolabel="1" attrs="{'readonly': [('not_modify_event', '=', True)], 'invisible': [('id', '=', False)]}" context="{'active_id': active_id, 'active_model': 'project.project'}">
                                <tree editable="bottom">
                                    <field name="event_ids" invisible="1"/>
                                    <field name="address_id" attrs="{'readonly':[('event_ids', '!=', [])]}"/>
                                    <field name="date_begin" attrs="{'readonly':[('event_ids', '!=', [])]}"/>
                                    <field name="date_end" attrs="{'readonly':[('event_ids', '!=', [])]}"/>
                                    <field name="repeat" attrs="{'readonly':[('event_ids', '!=', [])], 'invisible': [('period', '=', 'week')]}"/>
                                    <field name="period" attrs="{'readonly':[('event_ids', '!=', [])]}"/>
                                    <field name="days_repeat" attrs="{'readonly':[('event_ids', '!=', [])], 'invisible':[('period', '!=', 'week')], 'required':[('period', '=', 'week')]}" widget="many2many_tags"/>
                                    <field name="date_end_repeat" attrs="{'readonly':[('event_ids', '!=', [])], 'invisible':[('period', '!=', 'week')], 'required':[('period', '=', 'week')]}"/>
                                    <button name="event.action_event_view" string="View events" type="action" icon="fa-list" options='{"warn": true}' attrs="{'invisible': [('event_ids', '=', [])]}" context="{'search_default_project_id': parent.id}"/>
                                    <button name="generate_events" string="Generate events" type="object" icon="fa-cogs"
                                        options='{"warn": true}' attrs="{'invisible': [('event_ids', '!=', [])]}" context="{'search_default_project_id': parent.id}"
                                        confirm="Events will be generated with actual parameters, are you sure?"/>
                                </tree>
                            </field>
                        </group>
                    </group>
                </page>
            </xpath>
            <xpath expr="//group[@name='misc']" position="after">
                <group>
                    <group name="dates" string="Dates">
                        <field name="date_start"/>
                        <field name="date_end"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
    <record id="view_project_kanban" model="ir.ui.view">
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_kanban"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="event_count" invisible="1"/>
            </field>
            <xpath expr="//div[hasclass('o_project_kanban_boxes')]" position="inside">
                <a t-if="record.event_count.raw_value" class="o_project_kanban_box" name="event.action_event_view" type="action" groups="event.group_event_user" context="{'search_default_project_id': active_id}">
                    <div>
                        <span class="o_value"><t t-esc="record.event_count.value"/></span>
                        <span class="o_label">Events</span>
                    </div>
                </a>
            </xpath>
        </field>
    </record>
</odoo>
